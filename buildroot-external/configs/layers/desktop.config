# ============================================================================
# PengyOS Desktop layer — Server + the graphical stack + apps + full hardware
# ----------------------------------------------------------------------------
# Stacked on layers/core.config + layers/server.config (everything Server has,
# Desktop has). Adds the Wayland/COSMIC stack, desktop hardware support, the
# installer, and the developer set, on the desktop board.
# See configs/layers/README.md.
# ============================================================================

# --- System name --------------------------------------------------------------
BR2_TARGET_GENERIC_HOSTNAME="pengyos-desktop"

# --- Userspace additions to the base -------------------------------------------
# polkit: authorizes the flatpak system helper so cosmic-store can INSTALL apps
# (the helper routes privileged writes through org.freedesktop.PolicyKit1).
BR2_PACKAGE_POLKIT=y
# --- Flatpak: the app lane (SPEC §2.5) ----------------------------------------
# Built from source (package/flatpak, with package/appstream and
# package/libfyaml) — it used to be copied from the build host by post-build.
BR2_PACKAGE_FLATPAK=y
# update-desktop-database for flatpak's install trigger ("Open with" sees new apps).
BR2_PACKAGE_DESKTOP_FILE_UTILS_TARGET=y
# --- Flatpak sandbox runtime (bwrap + xdg-dbus-proxy) -------------------------
# flatpak EXECs two runtime helpers for every app run that weren't staged, so
# `flatpak run org.mozilla.firefox` died:
#   error: Failed to execute child process "bwrap" (No such file or directory)
# and, once bwrap was present,
#   bwrap: execvp xdg-dbus-proxy: No such file or directory
#   error: Failed to sync with dbus proxy
# The app-lane's whole point is the sandbox, so build both into the image
# (both are stock Buildroot 2026.08 meson recipes, same class as flatpak).
# bubblewrap installs /usr/bin/bwrap setuid (1755 root:root) so it works even
# where unprivileged user namespaces are off; xdg-dbus-proxy is the filtered
# D-Bus proxy the sandbox talks through. Verified end-to-end on the flashed
# Desktop image: with both on PATH, `flatpak run --command=sh … -c` reaches
# SANDBOX_OK as the desktop user.
BR2_PACKAGE_BUBBLEWRAP=y
BR2_PACKAGE_XDG_DBUS_PROXY=y
# hicolor-icon-theme: the freedesktop fallback theme's index.theme with a
# section per directory. Icon lookup ignores any directory without one, so
# COSMIC's hicolor-only icons (e.g. cosmic-settings' Dark/Light illustrations
# in scalable/status) resolved to nothing.
BR2_PACKAGE_HICOLOR_ICON_THEME=y

# --- Board: desktop ------------------------------------------------
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PENGYOS_PATH)/board/desktop/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_PENGYOS_PATH)/board/desktop/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_PENGYOS_PATH)/board/desktop/post-image.sh"
# Kernel: the desktop fragment (DRM, audio, Wi-Fi/BT, input, filesystems, …)
# stacked on Core's and Server's (fragments accumulate across layers).
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_PENGYOS_PATH)/board/desktop/linux.fragment"
# The whole system image. ~2.2G used with the full desktop hardware stack
# (firmware ~350M, the COSMIC apps ~800M — each statically links its GUI
# toolkit — Mesa + LLVM, the media driver). Installed systems grow it to their
# 8 GiB root slot (docs/state-layout.md), so it must stay under 8G.
# 2.5G used at 3000M (92%) once Xwayland/X11 landed; 3500M then 4000M (the
# distro-parity additions, 2026-09-30). Slots are 8 GiB.
BR2_TARGET_ROOTFS_EXT2_SIZE="4000M"

# --- Graphics: Mesa (EGL/GBM/GLES) -------------------------------------------
# virgl: QEMU's virtio-gpu-gl. llvmpipe: the software rasterizer (LLVM JIT,
# already in the image for radeonsi) EGL/GBM needs when the DRM device has no
# GPU driver — a VM, or on real hardware the firmware framebuffer (simpledrm) of
# a GPU we have no driver for. (softpipe, Mesa's slow reference rasterizer,
# comes along with lavapipe below.)
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LLVMPIPE=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
# Fonts: fontconfig/FreeType, and DejaVu as the wide-coverage fallback (COSMIC's
# own fonts are below).
BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_FREETYPE=y
BR2_PACKAGE_DEJAVU=y

# --- Locales ----------------------------------------------------------------
# COSMIC, GTK and Qt need a valid UTF-8 locale. Until 26.10.23 only en_US
# existed, so anyone outside the US could not pick their language or date/number
# format: COSMIC Settings -> Region & Language lists what `locale -a` prints
# (external.mk installs `locale`), and the list was empty. The common UTF-8
# locales (~50 MB in /usr/lib/locale/locale-archive, against 3 MB for en_US).
BR2_GENERATE_LOCALE="C.UTF-8 en_US.UTF-8 en_GB.UTF-8 en_CA.UTF-8 en_AU.UTF-8 en_IE.UTF-8 en_NZ.UTF-8 en_IN.UTF-8 en_ZA.UTF-8 fr_FR.UTF-8 fr_CA.UTF-8 fr_BE.UTF-8 fr_CH.UTF-8 de_DE.UTF-8 de_AT.UTF-8 de_CH.UTF-8 es_ES.UTF-8 es_MX.UTF-8 es_AR.UTF-8 es_CO.UTF-8 es_CL.UTF-8 es_US.UTF-8 it_IT.UTF-8 pt_BR.UTF-8 pt_PT.UTF-8 nl_NL.UTF-8 nl_BE.UTF-8 sv_SE.UTF-8 nb_NO.UTF-8 da_DK.UTF-8 fi_FI.UTF-8 pl_PL.UTF-8 cs_CZ.UTF-8 sk_SK.UTF-8 hu_HU.UTF-8 ro_RO.UTF-8 ru_RU.UTF-8 uk_UA.UTF-8 tr_TR.UTF-8 el_GR.UTF-8 he_IL.UTF-8 ar_EG.UTF-8 hi_IN.UTF-8 ja_JP.UTF-8 zh_CN.UTF-8 zh_TW.UTF-8 ko_KR.UTF-8 vi_VN.UTF-8 th_TH.UTF-8 id_ID.UTF-8"

# --- Portals (screenshots, file pickers, sandboxed apps) ---------------------
# xdg-desktop-portal and COSMIC's backend are our packages (Buildroot has
# neither; package/xdg-desktop-portal fetches its libglnx and gvdb meson
# subprojects at pinned revisions).
BR2_PACKAGE_XDG_DESKTOP_PORTAL=y
BR2_PACKAGE_COSMIC_PORTAL=y
# The portals COSMIC's backend doesn't implement (even upstream: it has only
# Access, FileChooser, RemoteDesktop, Screenshot, Settings, ScreenCast), as
# Pop!_OS ships them: portals.conf says "cosmic;gtk". Without an AppChooser
# backend xdg-desktop-portal doesn't offer OpenURI at all, so Flatpak apps
# could not open a link or a file in another app; Inhibit, Notification,
# Print, DynamicLauncher were missing too. Needs GTK3 on the host (Wayland +
# X11 backends; not Broadway, GTK-in-a-web-browser).
BR2_PACKAGE_LIBGTK3=y
# BR2_PACKAGE_LIBGTK3_BROADWAY is not set
BR2_PACKAGE_XDG_DESKTOP_PORTAL_GTK=y
# dconf: the GSettings backend. Without it GLib uses its keyfile backend, where
# concurrent writers lose each other's keys: cosmic-settings-daemon's login
# writes raced and Firefox/Chrome came up with a close button only (beholaptop,
# 26.10.32). dconf-service applies writes in order. The user unit
# pengyos-gsettings-keyfile-migrate.service moves an existing keyfile into it.
BR2_PACKAGE_DCONF=y

# --- Mesa hardware drivers ---------------------------------------------------
# Without a hardware driver Mesa falls back to software GL, which has no
# dmabuf import, so cosmic-comp cannot composite client buffers ("Dmabuf import
# extension not available": grey screen, no panel). Intel: iris (Gen8+, incl.
# the N100's Gen12). NVIDIA uses NVIDIA's driver (layers/nvidia.config).
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y
# AMD: radeonsi (GL), radv (Vulkan), libdrm_amdgpu, firmware; LLVM for both.
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_RADEONSI=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_AMD=y
BR2_PACKAGE_LIBDRM_AMDGPU=y
BR2_PACKAGE_LINUX_FIRMWARE_RADEON=y
BR2_PACKAGE_LLVM=y

# --- Vulkan -----------------------------------------------------------------
# COSMIC's apps render through wgpu, which wants Vulkan; without it wgpu falls
# back to its GL backend, and that backend draws only the LAST canvas of a
# window: cosmic-monitor showed one graph, in the wrong place, left over from
# the previous page (behoweather N100 and QEMU llvmpipe, 2026-09-30; the
# tiny-skia renderer draws the same window correctly). The image had radv but
# no Vulkan loader, so not even AMD machines used Vulkan.
# anv (Intel, the N100's Gen12) and lavapipe (CPU: VMs, and a GPU we have no
# driver for) join radv; the loader picks the device.
BR2_PACKAGE_VULKAN_LOADER=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_INTEL=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_SWRAST=y

# --- X11 apps: Xwayland -----------------------------------------------------------
# Steam (and most games through it), plus any app that still only speaks X11,
# need an X server; cosmic-comp starts Xwayland at login when it finds it on
# PATH (else it logs "Running without Xwayland"). No Xorg server: the session
# stays Wayland, X11 clients are windows in it. The X.org client libraries this
# pulls in are also what NVIDIA's Vulkan driver links (layers/nvidia.config).
# - libepoxy: Xwayland's glamor, so X11 apps draw on the GPU, not pixman.
# - GLX: X11 OpenGL apps. Mesa's GLX beside its VA-API drivers requires
#   libglvnd (Mesa then ships as a glvnd vendor, as on every distro); the
#   NVIDIA driver plugs into the same libglvnd.
# - xkbcomp: Xwayland compiles its keymap with it at startup and exits without.
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XWAYLAND=y
BR2_PACKAGE_XAPP_XKBCOMP=y
# xrdb: cosmic-comp hands X11 apps (Steam) the cursor theme and size with
# `xrdb -merge`; without it they got X's default cursor ("`xrdb` not found,
# cannot update Xresources"). With no cpp in the image xrdb skips preprocessing.
BR2_PACKAGE_XAPP_XRDB=y
BR2_PACKAGE_LIBEPOXY=y
BR2_PACKAGE_LIBGLVND=y
BR2_PACKAGE_MESA3D_OPENGL_GLX=y

# --- GPU firmware (linux-firmware subset) ------------------------------------
# Without firmware i915 logs adlp_dmc.bin/tgl_guc_70.bin -ENOENT and declares
# the GPU wedged (no hardware GL). i915 is a module (=m in linux.fragment) so it
# loads after the rootfs and can find these; a built-in driver with no
# initramfs never does.
# Wi-Fi firmware for the drivers in linux.fragment (the N100's Intel CNVi had no
# driver or firmware: no wlan interface at all).
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_22000=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7921=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7922=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX=y
# The wireless regulatory database (cfg80211: "regulatory.db failed with error
# -2" without it -> world-roaming limits), and the Realtek r8169 NIC firmware
# (rtl8168h-2.fw on the N100; it runs without, but the vendor fixes are in it).
# Bluetooth firmware for btusb (linux.fragment): Intel (ibt-*, the N100's AX101
# Bluetooth), Realtek, MediaTek.
BR2_PACKAGE_LINUX_FIRMWARE_IBT=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7921_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7922_BT=y
# Firmware for the drivers linux.fragment added for hardware outside the fleet
# (2026-10-11): Intel xe GPUs (Lunar/Panther Lake, Battlemage), MediaTek MT7925
# Wi-Fi + Bluetooth, Qualcomm WCN7850 (ath12k). Intel Wi-Fi 7, the Qualcomm
# WCN7850 Bluetooth and the laptop speaker amplifiers have no Buildroot option:
# external.mk installs those files.
BR2_PACKAGE_LINUX_FIRMWARE_XE=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7925=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7925_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_QUALCOMM_WCN7850=y

# --- Input: libinput ------------------------------------------------------------
# cosmic-comp links libinput.so.10. It used to arrive only because Weston
# selected it; once Weston went (10-01) a fresh build had none, and 26.10.3's
# compositor exited at start (127). Name it here. (board/common/
# check-needed-libs.py now fails the build on any unresolved library.)
BR2_PACKAGE_LIBINPUT=y

# --- Seat management (libseat) -----------------------------------------------
# cosmic-comp acquires the DRM device through smithay's libseat backend and
# must become DRM *master* to drive the scanout. Buildroot auto-selects
# BR2_PACKAGE_SEATD_BUILTIN when neither logind nor the seatd *daemon* is on;
# with the builtin backend the compositor logs
#   smithay::backend::drm::device::fd: Unable to become drm master,
#   assuming unprivileged mode
# and the screen stays black. Ship the seatd daemon so libseat's seatd backend
# can activate the VT and hand out a DRM-master device (logind, below, serves
# the login1 API alongside it).
BR2_PACKAGE_SEATD=y
BR2_PACKAGE_SEATD_DAEMON=y
# --- Power / session D-Bus API (systemd-logind) ------------------------------
# COSMIC's power actions (cosmic-osd restart/shutdown confirm, the Power
# settings page, cosmic-idle suspend, lid/power-key handling) all call
# org.freedesktop.login1 on the system bus. Without logind the confirm dialog
# failed with "ServiceUnknown: org.freedesktop.login1" and nothing happened.
# logind runs ALONGSIDE seatd: the session still gets its DRM master from seatd
# (LIBSEAT_BACKEND=seatd in start-cosmic and cosmic-greeter-start); logind only serves the
# login1 API. systemd is built with polkit support (-Dpolkit=enabled) so logind
# authorizes callers through the polkit daemon already in the image (root is
# allowed regardless). (logind itself: Server layer.)
# NOT via BR2_PACKAGE_SYSTEMD_POLKIT: that makes systemd depend on polkit, while
# polkit's logind session tracking (external.mk) needs libsystemd first -- a
# dependency cycle that broke any build of systemd after polkit. external.mk
# sets the meson option instead; systemd needs polkit only at runtime.
# BR2_PACKAGE_SYSTEMD_POLKIT is not set
# --- Networking ----------------------------------------------------------------
# NetworkManager is the network service (board/desktop/rootfs-overlay/etc/
# NetworkManager/NetworkManager.conf); systemd-networkd is not built. The panel's
# network applet and the Settings network page drive it. (Until 26.10.23 this
# section pointed at tools/pengyos-desktop-net, retired: its overlay files were
# not read by anything.)
#
# Wi-Fi backend: wpa_supplicant is a real Buildroot 2026.08 symbol and configures
# cleanly (it selects BR2_PACKAGE_WPA_SUPPLICANT_NL80211, the driver interface
# NetworkManager's wpa_supplicant plugin drives).
BR2_PACKAGE_WPA_SUPPLICANT=y
# NetworkManager drives wpa_supplicant over D-Bus (it starts it as `-u`); built
# without D-Bus it printed its usage and exited, so on the N100 NM showed the
# Wi-Fi as enabled but "unavailable" with no networks ("Failed to D-Bus activate
# wpa_supplicant service"). WPA3 (SAE) for current routers, EAP for WPA2/3-
# Enterprise (work/campus networks), autoscan for roaming.
BR2_PACKAGE_WPA_SUPPLICANT_DBUS=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_EAP=y
BR2_PACKAGE_WPA_SUPPLICANT_AUTOSCAN=y
# NetworkManager is THE network service on the Desktop (the wpa_supplicant
# backend above is what it drives). It is a stock 2026.08 package
# (BR2_PACKAGE_NETWORK_MANAGER, package/network-manager/): enabling it pulls dbus,
# libglib2, util-linux and the keyfile plugin the overlay's /etc/NetworkManager
# config expects. nmcli (BR2_PACKAGE_NETWORK_MANAGER_CLI) gives the installer a
# CLI path to the same service. With NM owning the link and the networkd stub
# removed, NM is the sole network service.
BR2_PACKAGE_NETWORK_MANAGER=y
BR2_PACKAGE_NETWORK_MANAGER_CLI=y
# Wi-Fi hotspot ("share this connection"): NetworkManager's shared mode starts
# /usr/sbin/dnsmasq for the DNS + DHCP lease pool. external.mk names that path so
# the build is host-independent, but the image carried no dnsmasq, so a hotspot
# could never come up. Ship it. Buildroot's dnsmasq only installs an init script
# under sysvinit, and PengyOS is systemd, so this adds the binary and nothing
# that starts by itself: NM spawns it per shared connection.
BR2_PACKAGE_DNSMASQ=y
# ...but Buildroot builds systemd-networkd by default, and removing the .network
# stub left networkd itself enabled: systemd-networkd-wait-online then waited
# out its 2-minute timeout on every boot and failed. NM is the network service,
# so don't build networkd at all.
# BR2_PACKAGE_SYSTEMD_NETWORKD is not set
# The GUI path to Wi-Fi: cosmic-applet-network (in the cosmic-applets package)
# lives in the cosmic-build release, so post-build.sh drops it into the image
# (it is NOT a Buildroot recipe). COSMIC's default panel shows it, and
# cosmic-settings' network page serves over NetworkManager.

# --- Audio + Bluetooth ---------------------------------------------------------
# PipeWire + WirePlumber (policy and units in the board overlay), BlueZ.
# WirePlumber's scripts need Lua 5.3; set it first so its `depends on` holds.
BR2_PACKAGE_LUA=y
BR2_PACKAGE_LUA_5_3=y
BR2_PACKAGE_PIPEWIRE=y
BR2_PACKAGE_WIREPLUMBER=y
# PipeWire's Bluetooth audio (the bluez5 SPA plugin) needs SBC — without it
# WirePlumber logged "PipeWire's BlueZ SPA plugin is missing" and headphones
# could never play. Opus = a better Bluetooth codec; V4L2 = webcams via PipeWire.
BR2_PACKAGE_SBC=y
BR2_PACKAGE_OPUS=y
BR2_PACKAGE_PIPEWIRE_V4L2=y
# UPower: batteries, UPS and power state for the panel's battery applet and
# Settings → Power. Without it the applet could not tell there is no battery and
# showed "0%" on the (battery-less) N100. lm-sensors: `sensors` for temperatures.
BR2_PACKAGE_UPOWER=y
BR2_PACKAGE_LM_SENSORS=y
BR2_PACKAGE_ALSA_LIB=y
# ALSA UCM configuration (alsa-ucm-conf, a PengyOS data recipe — Buildroot has
# none). WirePlumber's ACP path reads /usr/share/alsa/ucm2 to build a card's
# profiles; without it a plain HDA card only gets a generic Analog profile and
# the monitor's HDMI speakers never appear. Kept after the 2026-10-06 removal of
# the board overlay's 51-alsa-ucm.conf split-mode rule (api.alsa.use-acp=false):
# that rule bypassed ACP and UCM both, and its split-mode HDMI sink was silent on
# the N100. Under stock ACP this data is actually used — HDMI is a selectable
# profile (COSMIC Settings -> Sound -> Device profiles).
BR2_PACKAGE_ALSA_UCM_CONF=y
BR2_PACKAGE_BLUEZ5_UTILS=y

# --- Media playback: GStreamer + FFmpeg ----------------------------------------
# COSMIC Player (iced_video_player: playbin -> videoconvert -> appsink) could
# play nothing: gst-plugins-base had no appsink, and there were no demuxers or
# decoders at all (only base's playback/typefind). The Pop!_OS/Fedora set:
# containers (MP4, MKV/WebM, Ogg, AVI, FLV, MPEG-TS/PS), parsers, FLAC/MP3/
# Vorbis/Opus/VPx natively, everything else (H.264, HEVC, AAC, AC-3, …)
# through gst-libav's FFmpeg decoders, AV1 through dav1d, and VA-API hardware
# decode (va). Audio: alsasink, which ALSA routes into PipeWire
# (99-pipewire-default.conf); autoaudiosink picks it. The ffmpeg/ffprobe tools
# and gst-launch/gst-inspect/gst-play come with them.
BR2_PACKAGE_GSTREAMER1_INSTALL_TOOLS=y
BR2_PACKAGE_GST1_PLUGINS_BASE_INSTALL_TOOLS=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_APP=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_ALSA=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_AUDIORATE=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEORATE=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_RAWPARSE=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_SUBPARSE=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_GIO=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_OGG=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_OPUS=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VORBIS=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_THEORA=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_AUDIOTESTSRC=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEOTESTSRC=y
BR2_PACKAGE_GST1_PLUGINS_GOOD=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_JPEG=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PNG=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_APETAG=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_AUDIOFX=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_AUDIOPARSERS=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_AUTODETECT=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_AVI=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_DEINTERLACE=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_FLV=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_ICYDEMUX=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_ID3DEMUX=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_ISOMP4=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_MATROSKA=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_REPLAYGAIN=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_VIDEOFILTER=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_WAVPARSE=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_FLAC=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_MPG123=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_VPX=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_V4L2=y
BR2_PACKAGE_GST1_PLUGINS_BAD=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_AIFF=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_AUTOCONVERT=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_ID3TAG=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_IVFPARSE=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_MPEGDEMUX=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_MPEGTSDEMUX=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_SUBENC=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_VIDEOPARSERS=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_HLS=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_DASH=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_VA=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_WEBP=y
BR2_PACKAGE_GST1_LIBAV=y
BR2_PACKAGE_DAV1D=y
BR2_PACKAGE_LIBVPX=y
BR2_PACKAGE_MPG123=y
BR2_PACKAGE_FLAC=y
BR2_PACKAGE_LIBVORBIS=y
BR2_PACKAGE_LIBTHEORA=y
BR2_PACKAGE_LIBOGG=y
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_GPL=y
BR2_PACKAGE_FFMPEG_FFMPEG=y
BR2_PACKAGE_FFMPEG_FFPROBE=y
BR2_PACKAGE_FFMPEG_SWSCALE=y
# PipeWire's GStreamer elements (pipewiresrc: cameras and screen capture into
# GStreamer apps).
BR2_PACKAGE_PIPEWIRE_GSTREAMER=y

# --- Gaming: controllers and GameMode -----------------------------------------
# Steam is a Flatpak and cannot install udev rules: without Valve's, controllers
# (and Steam Input's virtual pads through /dev/uinput) and VR headsets were not
# accessible to the user. GameMode backs the portal interface Flatpak games
# already see (xdg-desktop-portal offered GameMode with nothing behind it).
BR2_PACKAGE_STEAM_DEVICES=y
BR2_PACKAGE_GAMEMODE=y

# --- Services behind portals Flatpak apps already see (2026-10-11) -------------
# - rtkit (our package): the Realtime portal forwards to RealtimeKit; without it
#   audio workstations, games, voice chat and PipeWire inside a sandbox got no
#   realtime threads (xdg-desktop-portal: "Failed to load RealtimeKit property").
# - geoclue (our package): the Location portal is compiled into
#   xdg-desktop-portal only with libgeoclue. Maps, weather, browsers and COSMIC
#   Settings' sunset-based dark mode had no location.
# - v4l2loopback: OBS's virtual camera (and any "fake webcam" tool) needs this
#   kernel module, which a Flatpak cannot bring. OBS loads it on demand with
#   pkexec; modprobe.d/60-pengyos-v4l2loopback.conf gives it OBS's options.
#   (Buildroot's recipe only turns MEDIA_SUPPORT/VIDEO_DEV on when unset; our
#   =m stays.)
# - glib-networking: GIO's TLS backend (gnutls here). Without it every libsoup
#   or GIO client failed HTTPS with "TLS support is not available": geoclue's
#   BeaconDB lookups, and gvfs's dav/http backends (COSMIC Files' davs://, e.g.
#   Nextcloud).
BR2_PACKAGE_RTKIT=y
BR2_PACKAGE_GEOCLUE=y
BR2_PACKAGE_GLIB_NETWORKING=y
BR2_PACKAGE_V4L2LOOPBACK=y

# --- Programs COSMIC runs by name (2026-10-11) ----------------------------------
# A sweep of every Command::new("...") in the pinned COSMIC sources against the
# image found these missing. Each one turned a COSMIC feature into a no-op:
# - rfkill: the Bluetooth applet and Settings block/unblock the adapter with it;
#   after airplane mode the toggle could not bring Bluetooth back.
# - pactl: cosmic-settings-daemon sends Mono Audio to pipewire-pulse and sets
#   virtual sinks/sources as default with it; PulseAudio-protocol apps (every
#   Flatpak browser, Discord, Spotify) stayed stereo. PulseAudio is built
#   client-only (external.mk: no daemon, which would fight pipewire-pulse for
#   the socket): libpulse and pactl.
# - qalc (libqalculate, our package): the launcher's "= 2+2" calculator.
# - notify-send (libnotify, our package): notifications from scripts.
BR2_PACKAGE_UTIL_LINUX_RFKILL=y
BR2_PACKAGE_PULSEAUDIO=y
BR2_PACKAGE_LIBQALCULATE=y
BR2_PACKAGE_LIBNOTIFY=y

# --- Virtual machines: a window for QEMU (the Server layer has QEMU + KVM) -------
# SDL on Wayland with OpenGL, so `qemu-system-x86_64 -enable-kvm -display sdl,gl=on
# -device virtio-vga-gl` runs a VM in a COSMIC window.
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_WAYLAND=y
BR2_PACKAGE_SDL2_OPENGL=y
BR2_PACKAGE_QEMU_SDL=y
BR2_PACKAGE_QEMU_OPENGL=y

# --- Out of memory: earlyoom --------------------------------------------------
# With swap on zram (core layer), a runaway app would otherwise grind the
# desktop until the kernel's OOM killer acts, minutes later. earlyoom acts
# first (config: overlay /etc/default/earlyoom). Not systemd-oomd: it kills
# whole cgroups, and the COSMIC session is one service cgroup, so it would
# kill the whole desktop.
BR2_PACKAGE_EARLYOOM=y

# --- Intel laptop audio: SOF firmware (kernel driver in linux.fragment) --------
BR2_PACKAGE_SOF_FIRMWARE=y


# --- Login screen and the desktop user's session (greetd, PAM + logind) --------
# greetd (our package) runs COSMIC's greeter at boot (overlay greetd.service);
# the password it takes opens the user's session through PAM (pengyos-session),
# and pam_systemd makes it a real logind session on seat0 — /run/user/UID, the user's systemd manager
# (PipeWire), polkit's "active session" (NetworkManager, Settings, Flatpak), and
# loginctl lock-session. PAM + logind themselves come from the Server layer.
# The user is in wheel: sudo (Server layer) + a polkit admin rule (overlay)
# make it the admin.
# The `seat` group seatd grants its socket to (seatd -g seat), so the desktop
# user can run the compositor; the users table also adds the greeter's user.
# Automatic login is opt-in (installer, `pengyos-autologin`), as on Ubuntu.
BR2_PACKAGE_GREETD=y
# File modes set under fakeroot (board/desktop/permissions.txt) on top of the
# Server layer's table; like the users tables, not an accumulating list.
BR2_ROOTFS_DEVICE_TABLE="system/device_table.txt $(BR2_EXTERNAL_PENGYOS_PATH)/board/server/permissions.txt $(BR2_EXTERNAL_PENGYOS_PATH)/board/desktop/permissions.txt"
# Not an accumulating list (compose-defconfigs.py): name Core's table too.
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_PENGYOS_PATH)/board/core/users.table $(BR2_EXTERNAL_PENGYOS_PATH)/board/desktop/users.table"

# --- Full hardware control (desktop) -------------------------------------------
# Hardware video decode/encode: VA-API with Intel's iHD driver (Broadwell and
# newer, incl. the N100's Gen12 GPU) and Mesa's Gallium VA for AMD (radeonsi);
# `vainfo` to check it.
BR2_PACKAGE_INTEL_MEDIADRIVER=y
BR2_PACKAGE_MESA3D_GALLIUM_VA=y
BR2_PACKAGE_LIBVA_UTILS=y
# Thermal management for Intel (DPTF-aware; matters on fanless boxes) and power
# profiles for COSMIC's power menu / Settings → Power (our package: Buildroot has
# none). powerprofilesctl needs PyGObject.
BR2_PACKAGE_THERMALD=y
BR2_PACKAGE_POWER_PROFILES_DAEMON=y
BR2_PACKAGE_PYTHON_GOBJECT=y
# Firmware updates from LVFS (UEFI capsules incl. the system firmware, SSDs,
# docks, …). fwupd-efi is the capsule loader it stages on the ESP (/efi).
BR2_PACKAGE_FWUPD=y
BR2_PACKAGE_FWUPD_EFI=y
# fwupd-efi's build runs host `uswid`, which imports lzma; Buildroot's recipe
# does not pull the host Python's xz support in ("No module named '_lzma'").
BR2_PACKAGE_HOST_PYTHON3_XZ=y
# Disk health (SMART, NVMe) and the TPM 2.0 userspace.
BR2_PACKAGE_SMARTMONTOOLS=y
BR2_PACKAGE_NVME=y
# With tpm2-tss present systemd is built with TPM2 support, and its
# systemd-tpm2-generator makes early boot WAIT (90 s) for /dev/tpmrm0 whenever it
# believes the firmware has a TPM but no driver is bound yet — on a VM or a board
# whose firmware reports a TPM that never appears, every boot stalled 90 s behind
# the splash. Nothing here needs the TPM during early boot (no TPM-bound disk
# unlock), so the overlay masks the generator
# (etc/systemd/system-generators/systemd-tpm2-generator -> /dev/null).
BR2_PACKAGE_TPM2_TSS=y
BR2_PACKAGE_TPM2_TOOLS=y
# Removable media: UDisks2 (what COSMIC Files mounts drives through, via GIO/gvfs;
# also fwupd's ESP discovery) and gvfs (its UDisks2 volume monitor is enabled by
# the gvfs recipe when UDisks is on). Neither was installed, so plugging in a
# drive did nothing. Plus the tools to check/format the filesystems the kernel
# now mounts (linux.fragment).
BR2_PACKAGE_UDISKS=y
# glibc's UTF-16/UTF-32 converters are gconv modules, and the image had none
# (only glibc's built-in charsets): iconv_open("UTF-16LE", "UTF-8") failed, so
# UDisks/libblockdev refused every exFAT label ("must be a valid UTF-8 string",
# its g_convert to UTF-16 failing) after it had already rewritten the partition
# table. Found testing Disks (tools/pengyos-disks). Just the Unicode modules
# (92 KB); the legacy codepages (8.3 MB in all) are not copied.
BR2_TOOLCHAIN_GLIBC_GCONV_LIBS_COPY=y
BR2_TOOLCHAIN_GLIBC_GCONV_LIBS_LIST="UTF-16 UTF-32 UTF-7 UNICODE"
# The user folders (Downloads, Documents, …): created at session start
# (the session script, /usr/libexec/pengyos/start-cosmic). Also what COSMIC Files' sidebar lists.
BR2_PACKAGE_XDG_USER_DIRS=y
# The Secret Service (org.freedesktop.secrets, our package): where browsers,
# VS Code, the GitHub CLI … keep passwords and tokens. There was none —
# portals.conf already named oo7-portal for the Secret portal, but nothing
# provided it. oo7 is the Rust replacement for gnome-keyring.
BR2_PACKAGE_OO7=y
# A mouse cursor theme (our package): there was none, so cosmic-comp logged
# "Unable to load xcursor, using fallback cursor" and drew one arrow for every
# shape (no text I-beam, no resize arrows); X11 apps got the bare X cursor.
BR2_PACKAGE_POP_CURSOR_THEME=y
BR2_PACKAGE_GVFS=y
BR2_PACKAGE_DOSFSTOOLS_FATLABEL=y
BR2_PACKAGE_NTFS_3G=y
BR2_PACKAGE_NTFS_3G_NTFSPROGS=y
BR2_PACKAGE_XFSPROGS=y
# Printing (CUPS + filters; USB printers use the usblp driver) and scanning
# (SANE backends), cameras over PTP (libgphoto2, gvfs's gphoto2 backend).
BR2_PACKAGE_CUPS=y
BR2_PACKAGE_CUPS_FILTERS=y
BR2_PACKAGE_SANE_BACKENDS=y
# Network discovery for printers and scanners (mDNS/DNS-SD). Without avahi CUPS
# was built --with-dnssd=no and cups-browsed/SANE's escl backend could find
# nothing: no network printer or scanner ever appeared. With it, driverless
# (IPP Everywhere / AirPrint) printers show up in every print dialog on their
# own. sane-airscan: driverless network scanners (eSCL / WSD). The firewall
# lets mDNS in (Server layer nftables.conf).
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
# nss-mdns: programs resolve name.local through avahi ("ssh behoserver.local"
# failed). The package adds mdns4_minimal to nsswitch.conf itself.
BR2_PACKAGE_NSS_MDNS=y
BR2_PACKAGE_SANE_AIRSCAN=y
BR2_PACKAGE_LIBGPHOTO2=y
# Hardware inspection and control: real lsusb/lspci with ID names (busybox's
# have none), DMI/SMBIOS, I2C, disk and NIC tuning, Wi-Fi, the UEFI boot
# manager, lshw, ACPI events.
BR2_PACKAGE_USBUTILS=y
BR2_PACKAGE_PCIUTILS=y
BR2_PACKAGE_HWDATA=y
BR2_PACKAGE_HWDATA_PCI_IDS=y
BR2_PACKAGE_HWDATA_USB_IDS=y
BR2_PACKAGE_HWDATA_PNP_IDS=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_HDPARM=y
BR2_PACKAGE_ETHTOOL=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_LSHW=y
# Our packages (buildroot-external/package): phones over MTP (and gvfs's MTP
# backend, external.mk), monitor control over DDC/CI, Thunderbolt/USB4 authorization.
BR2_PACKAGE_LIBMTP=y
BR2_PACKAGE_DDCUTIL=y
BR2_PACKAGE_BOLT=y
# Audio tools: pw-play / pw-record / pw-cat (PipeWire builds them only with
# libsndfile) and alsa-utils (aplay, speaker-test, alsamixer) — there was no way
# to play a test sound from a shell.
BR2_PACKAGE_LIBSNDFILE=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_ALSAMIXER=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y

# --- Everyday apps not in COSMIC -----------------------------------------------
# xdg-open / xdg-mime & co. (our package; not in stock Buildroot): scripts and
# "open with the default app" from the command line. COSMIC runs xdg-utils'
# generic backend, patched to ask gio for file types (no `file` in the image).
BR2_PACKAGE_XDG_UTILS=y
# Boot splash (our package): Pengy + a spinner from early userspace until the
# COSMIC session takes the screen (greetd.service.d/x-plymouth-handoff).
# Needs `splash` on the kernel command line (grub-efi.cfg, pengyos-install).
BR2_PACKAGE_PLYMOUTH=y
# COSMIC's sound theme (our package; also answers COSMIC's "Pop" lookups) +
# the freedesktop theme it selects: notification, volume, battery and plug
# sounds. Before this /usr/share/sounds held only ALSA's test files.
BR2_PACKAGE_COSMIC_SOUND_THEME=y
# Fonts (our packages): Fira Sans/Mono, the interface and monospace fonts
# COSMIC defaults to (the UI was falling back to DejaVu), and Noto Color Emoji
# (emoji were empty boxes or monochrome DejaVu glyphs). DejaVu stays as the
# wide-coverage fallback.
BR2_PACKAGE_FONT_FIRA=y
BR2_PACKAGE_FONT_NOTO_COLOR_EMOJI=y
# Pengy desktop app (package/pengy; CLI from Core, web UI from Server): Qt6
# Widgets/Network/Svg, native on Wayland (qt6wayland), pinned first in the
# dock (post-build favorites). Qt's text/image stack uses the system fontconfig,
# harfbuzz, PNG/JPEG; D-Bus for portals and the system theme.
BR2_PACKAGE_QT6=y
BR2_PACKAGE_QT6BASE_GUI=y
BR2_PACKAGE_QT6BASE_WIDGETS=y
BR2_PACKAGE_QT6BASE_NETWORK=y
BR2_PACKAGE_QT6BASE_OPENGL=y
BR2_PACKAGE_QT6BASE_FONTCONFIG=y
BR2_PACKAGE_QT6BASE_HARFBUZZ=y
BR2_PACKAGE_QT6BASE_PNG=y
BR2_PACKAGE_QT6BASE_JPEG=y
BR2_PACKAGE_QT6BASE_DBUS=y
# PrintSupport: mdit's PDF export (QPdfWriter).
BR2_PACKAGE_QT6BASE_PRINTSUPPORT=y
BR2_PACKAGE_QT6SVG=y
BR2_PACKAGE_QT6WAYLAND=y
BR2_PACKAGE_PENGY_GUI=y
# mdit (our package): the Markdown editor, a Qt6 Widgets app with a live
# preview and HTML/PDF export; themed by cutecosmic like Pengy.
BR2_PACKAGE_MDIT=y
# cutecosmic (our package): the Qt platform theme that makes Qt apps follow
# COSMIC's dark/light mode, accent, fonts, icons and file dialogs; loaded
# automatically inside the COSMIC session. Built without Qt Quick (patch).
BR2_PACKAGE_CUTECOSMIC=y
# The image viewer is COSMIC Viewer (pop-os/cosmic-viewer, built on the host
# with the other COSMIC apps; post-build installs it). It decodes in Rust, so it
# needs no image libraries here. The overlay's
# /usr/share/applications/mimeapps.list makes it the default for images (and
# COSMIC Edit / Player / Files for text / media / folders).

# ============================================================================
# Desktop parity, tier 2 (2026-09-30): what Pop!_OS / Fedora / Ubuntu desktops
# have that COSMIC's own apps use or users expect.
# ============================================================================
# COSMIC Settings: Region & Language talks to systemd-localed (locale1), and
# Users to AccountsService (our package) -- both pages were empty.
BR2_PACKAGE_SYSTEMD_LOCALED=y
# Screen brightness survives a reboot: systemd-backlight saves each backlight's
# level at shutdown (/var/lib/systemd/backlight, on the data partition) and
# restores it at boot; without it laptops started at the firmware's dim default.
BR2_PACKAGE_SYSTEMD_BACKLIGHT=y
BR2_PACKAGE_ACCOUNTSSERVICE=y
# "Launch using discrete graphics" (launcher, dock, app library, store) asks
# switcheroo-control (our package) which GPUs there are: hybrid laptops. Its
# unit is WantedBy=graphical.target and not D-Bus activatable; we boot to
# multi-user.target, so the overlay enables it there.
BR2_PACKAGE_SWITCHEROO_CONTROL=y
# VPNs in the network settings (OpenVPN; WireGuard is built into
# NetworkManager, wg for the command line) and mobile broadband modems.
BR2_PACKAGE_OPENVPN=y
BR2_PACKAGE_NETWORK_MANAGER_OPENVPN=y
BR2_PACKAGE_WIREGUARD_TOOLS=y
BR2_PACKAGE_NETWORK_MANAGER_MODEM_MANAGER=y
# Printers: driverless USB printers/scanners through ipp-usb (our package; they
# appear to CUPS and SANE like network ones), and drivers for older printers
# that aren't driverless: Gutenprint (Canon, Epson, …) and HPLIP (HP).
BR2_PACKAGE_IPP_USB=y
BR2_PACKAGE_GUTENPRINT=y
BR2_PACKAGE_HPLIP=y
# Chinese, Japanese and Korean text (our package: Noto Sans CJK, variable).
BR2_PACKAGE_FONT_NOTO_CJK=y
# Thumbnails in COSMIC Files for videos (ffmpegthumbnailer, our package) and
# PDFs (poppler's pdftocairo; overlay /usr/share/thumbnailers).
BR2_PACKAGE_FFMPEGTHUMBNAILER=y
BR2_PACKAGE_POPPLER=y
BR2_PACKAGE_POPPLER_UTILS=y
# Bluetooth audio codecs beyond SBC/Opus: AAC (fdk-aac: Apple and most
# headphones), aptX/aptX HD (libfreeaptx) and LDAC (ldacbt: Sony) -- our
# packages, wired into PipeWire in external.mk -- and LC3 (LE Audio).
BR2_PACKAGE_FDK_AAC=y
BR2_PACKAGE_LIBLC3=y
BR2_PACKAGE_LIBFREEAPTX=y
BR2_PACKAGE_LDACBT=y
# gpg's passphrase prompt in terminals (gnupg2 is in the image).
BR2_PACKAGE_PINENTRY=y
BR2_PACKAGE_PINENTRY_NCURSES=y
