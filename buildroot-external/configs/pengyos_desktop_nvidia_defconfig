# ============================================================================
# GENERATED — do not edit. pengyos_desktop_nvidia_defconfig = core + server + desktop + nvidia-compute + nvidia
# Edit buildroot-external/configs/layers/*.config, then run
# scripts/compose-defconfigs.py (docs: configs/layers/README.md).
# ============================================================================

# ############################################################################
# ## layer: core
# ############################################################################

# ============================================================================
# PengyOS Core — the systemd base every edition builds on
# ----------------------------------------------------------------------------
# The core layer of the external-tree (BR2_EXTERNAL) defconfigs; its board glue
# is board/core.
#
# Buildroot defconfigs are bare filenames (no ".defconfig" suffix).
#
# Every symbol below exists in Buildroot 2026.08 (verified against
# buildroot-2026.08's kconfig sources). Buildroot silently ignores unknown
# symbols in a defconfig, so a made-up BR2_ name is a silent no-op — the
# symbol-existence verifier (tests/test_symbol_verifier.py) checks every name
# here against the vendored 2026.08 kconfig list (data/buildroot-2026.08-
# symbols.txt) and fails the suite on any symbol Buildroot would drop.
# ============================================================================

# --- Architecture -----------------------------------------------------------
# x86-64 (choice symbol; the toolchain/endianness details follow from it).
BR2_x86_64=y

# --- Toolchain / C library --------------------------------------------------
# systemd will not run on musl/uClibc: BR2_INIT_SYSTEMD depends on
# BR2_TOOLCHAIN_USES_GLIBC. Selecting the glibc C library for the Buildroot
# (internal) toolchain satisfies that. (BR2_TOOLCHAIN_BUILDROOT is selected
# implicitly by the C-library choice; BR2_TOOLCHAIN_HAS_THREADS comes along
# with any dynamic glibc toolchain.)
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_HAS_THREADS=y

# --- Reproducible builds -----------------------------------------------------
# UTC + C locale, fixed kernel build user/host/timestamp, SOURCE_DATE_EPOCH
# everywhere (scripts/release.sh pins it to the PengyOS commit date). Buildroot
# only promises identical output for the same output directory: build from the
# same absolute paths on every host you compare. (That is also why external.mk
# can turn the build-id back on, which BR2_REPRODUCIBLE switches off.)
BR2_REPRODUCIBLE=y

# --- System init ------------------------------------------------------------
# systemd is PID 1.
BR2_INIT_SYSTEMD=y
# systemd-analyze (blame / critical-chain): measure where boot time goes on
# real hardware; the journal alone does not show per-unit durations.
BR2_PACKAGE_SYSTEMD_ANALYZE=y
# systemd-coredump + coredumpctl: without it the kernel discards a crashing
# program's core and only a one-line "segfault at" survives (no aborts, no stack).
# With libdw in the image each crash also logs a symbolized backtrace. Storage is
# capped in board/core/rootfs-overlay/usr/lib/systemd/coredump.conf.d/.
BR2_PACKAGE_SYSTEMD_COREDUMP=y

# --- System name / accounts -------------------------------------------------
# BR2_TARGET_GENERIC_HOSTNAME: set by the desktop layer
# Root password placeholder "pengyos" (override with a real hash in a secure
# build). Given pre-hashed, with a fixed salt: Buildroot would hash a clear-text
# value with a random salt, and two builds of one commit would differ in
# /etc/shadow. `openssl passwd -5 -salt pengyosroot pengyos`, each $ doubled.
BR2_TARGET_GENERIC_ROOT_PASSWD="$$5$$pengyosroot$$0NxsYkraU5R8qP3TNBTMVJ3Pt2EVVGKNU6vJ9ljsW99"

# --- Serial console / getty -------------------------------------------------
# Buildroot has no BR2_SERIAL symbol: the serial console IS a getty on a
# serial port. The port is tty1, not ttyS0: "ttyS0" made Buildroot set
# DefaultInstance=ttyS0 on serial-getty@.service, so preset-all enabled a ttyS0
# getty on every machine. serial8250 always registers ttyS0, so on a laptop
# with no UART it failed and restarted every 10 s forever (beholaptop,
# 26.10.31). systemd-getty-generator starts serial-getty@ttyS0 from
# console=ttyS0, which grub.cfg adds only when GRUB finds a real UART (QEMU
# does), and the rootfs-overlay's serial-getty@ttyS0 drop-in logs it in without
# a password.
BR2_TARGET_GENERIC_GETTY_PORT="tty1"

# --- Userspace packages -----------------------------------------------------
# D-Bus: the systemd userspace messaging bus.
BR2_PACKAGE_DBUS=y
# Core utilities: uutils/coreutils — the Rust coreutils (SPEC §2.1). Our own
# recipe (package/uutils-coreutils; Buildroot 2026.08 ships no uutils recipe),
# pinned to 0.11.0 and built with `--features unix`, which is the set GNU
# coreutils ships on Linux: the 78 common-core utilities plus arch, chgrp,
# chmod, chown, chroot, groups, hostname, id, install, kill, logname, mkfifo,
# mknod, nice, nohup, nproc, pinky, stat, stdbuf, stty, sync, timeout, uname,
# uptime, users, who, whoami, hostid. It installs as one multicall binary plus
# a symlink per utility, so `ls`/`cp`/`stat`/`install` are ordinary commands.
# GNU coreutils (GPL-3) is dropped: MIT, memory-safe, and the same choice
# Ubuntu 25.10 made.
BR2_PACKAGE_UUTILS_COREUTILS=y
# The text/search tools agents reach for, from the projects that define the
# behaviour: findutils (find -printf, xargs -0 -d -P), grep (-P, --include, -o),
# sed (-E, \b, -i), gawk (gensub, asort, -v), GNU time (-v, -o, -f), which,
# diffutils (diff -u -r -N), patch, Info-ZIP unzip, gzip, tree, lsof, less,
# attr (getfattr/setfattr) and psmisc (killall -q, fuser, pstree). BusyBox
# ships an applet for every one of these; the applets are compiled out (see
# board/core/busybox.fragment) so there is exactly one implementation of each.
BR2_PACKAGE_FINDUTILS=y
BR2_PACKAGE_GREP=y
BR2_PACKAGE_SED=y
BR2_PACKAGE_GAWK=y
BR2_PACKAGE_TIME=y
BR2_PACKAGE_WHICH=y
BR2_PACKAGE_DIFFUTILS=y
BR2_PACKAGE_PATCH=y
BR2_PACKAGE_UNZIP=y
BR2_PACKAGE_GZIP=y
BR2_PACKAGE_TREE=y
BR2_PACKAGE_LSOF=y
# strace: the difference between a guess and a proof when a process dies or
# misbehaves. Absent on 2026-10-25, when the question "does os.killpg(1, ...)
# really signal every process I own?" needed a syscall answer and the machine
# could only offer web docs. Diagnostic primitive, about 1.4 MB, no daemon.
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_ATTR=y
BR2_PACKAGE_PSMISC=y
# BusyBox applets are resolved in the config, not by install order: the
# fragment compiles out every applet another package owns (and the early-boot /
# embedded ones, since the image has no initramfs and no sysvinit).
# BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES: set by the server layer
# Buildroot's ifupdown-scripts (default y with the default skeleton) installs
# network.service, which runs `ip addr flush dev lo` and then `ifup -a`. systemd
# already configures loopback at boot and networkd/NetworkManager own every
# other interface, so the unit had nothing to do; once the Server fragment
# compiled BusyBox's ifup out it flushed 127.0.0.1 off `lo` and then failed,
# leaving the machine with no localhost (found on behoweather, 2026-10-12).
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
# util-linux: the 2026.08 top-level BR2_PACKAGE_UTIL_LINUX package no longer
# exists; the binaries are split into per-tool subpackages. systemd needs
# mount/umount/losetup/fsck/swap, which BR2_PACKAGE_UTIL_LINUX_MOUNT ships.
BR2_PACKAGE_UTIL_LINUX_MOUNT=y
# The util-linux tools whose BusyBox applet is the cut-down one an agent meets:
# losetup -f (the installer and every loop-mount), last -x/-i (wtmp history),
# eject, su -l, hwclock, chrt/ionice, fallocate, mesg, mountpoint, logger.
BR2_PACKAGE_UTIL_LINUX_LOSETUP=y
BR2_PACKAGE_UTIL_LINUX_LAST=y
BR2_PACKAGE_UTIL_LINUX_EJECT=y
BR2_PACKAGE_UTIL_LINUX_SU=y
BR2_PACKAGE_UTIL_LINUX_HWCLOCK=y
BR2_PACKAGE_UTIL_LINUX_SCHEDUTILS=y
BR2_PACKAGE_UTIL_LINUX_FALLOCATE=y
BR2_PACKAGE_UTIL_LINUX_MESG=y
BR2_PACKAGE_UTIL_LINUX_MOUNTPOINT=y
BR2_PACKAGE_UTIL_LINUX_LOGGER=y
# unshare: the safe way to run a risky syscall experiment -- a private PID
# namespace where pid 1 is the shell, so kill(-1) is harmless. Absent on
# 2026-10-25, which is how the diagnosis of a session-wide SIGTERM ended in
# "I could not demonstrate it live", with only web docs for an answer.
BR2_PACKAGE_UTIL_LINUX_UNSHARE=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_IPROUTE2=y
# procps-ng: the real ps/top/free (core utils, SPEC §2.1). BusyBox also ships
# a ps applet, but procps-ng's is the full-featured one.
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_BASH=y
# The default-deny firewall: its ruleset, unit and pengyos-firewall are in
# board/core's overlay, so every edition starts closed (Desktop opens >1024).
BR2_PACKAGE_NFTABLES=y
# chrony is the one time daemon (SPEC: timesyncd rejected). Buildroot builds
# systemd-timesyncd by default, and the two ran side by side on every edition:
# chronyd logged "System clock interference detected" every few minutes
# (behoweather, 26.10.19). The overlay's ntp-units.d entry points timedated
# (`timedatectl set-ntp`, COSMIC Settings' automatic time) at chrony instead.
BR2_PACKAGE_CHRONY=y
# BR2_PACKAGE_SYSTEMD_TIMESYNCD is not set
BR2_PACKAGE_CA_CERTIFICATES=y
BR2_PACKAGE_OPENSSL=y
# GNU tar: BusyBox's tar applet has no -z/-J and no --ignore-failed-read, so the
# nightly pengyos-backup failed every run and every upstream "curl … | tar xz"
# install line (uv, Go, Syncthing) broke. BusyBox defers to it (noclobber); the
# applet is now compiled out outright (board/core/busybox.fragment).
BR2_PACKAGE_TAR=y

# --- SSH (US-CORE-2: reach a headless node over the network) ----------------
# openssh-pengyos (our fork of openssh, pinned at 10.6p1), enabled at boot by the
# overlay symlink etc/systemd/system/multi-user.target.wants/sshd.service.
# KEY_UTILS ships ssh-keygen, which sshd.service runs (ssh-keygen -A) to mint host
# keys on first boot. Root login is key-only (PasswordAuthentication no in the
# overlay sshd_config); inject a public key at build time via
# PENGYOS_AUTHORIZED_KEYS_FILE (see board/core/post-build.sh).
# The fork exists because 10.5p1 carries remote unauthenticated sshd CVEs fixed
# upstream in 10.6 and a br2-external tree cannot move a stock version: see
# divergence.toml -> openssh-10.6p1-fork, which carries the expiry that ends it.
BR2_PACKAGE_OPENSSH=n
BR2_PACKAGE_OPENSSH_PENGYOS=y
BR2_PACKAGE_OPENSSH_PENGYOS_SERVER=y
BR2_PACKAGE_OPENSSH_PENGYOS_CLIENT=y
BR2_PACKAGE_OPENSSH_PENGYOS_KEY_UTILS=y

# --- Groups systemd expects (board/core/users.table) --------------------------
# No systemd-sysusers in the image, so groups its sysusers.d would create are
# made at build time instead. The Desktop layer lists this table with its own.
# BR2_ROOTFS_USERS_TABLES: set by the desktop layer

# --- Hardware firmware (real-hardware support: GPU, wired NIC, WiFi) ---------
# On the N100 weather station /lib/firmware was empty: i915 (Alder Lake-N GPU)
# failed to load DMC/GuC firmware and WiFi had no regulatory.db. Ship the small
# subset an Intel mini-PC actually needs (not all of linux-firmware).
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_I915=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_8169=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_9XXX=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_QUZ=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_6E=y
# AX200 = iwlwifi-cc-a0 (Buildroot ships it under the 22260 option); miniserv.
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_22260=y
# Intel Wireless 8265 (iwlwifi-8265) — behothinkpad.
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_8265=y
# Realtek RTL8821CE (rtw88) — behobasement.
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW88=y
# Broader firmware so the "boot anywhere" stick works on other hardware: AMD GPU,
# Atheros/Broadcom/Realtek WiFi families.
BR2_PACKAGE_LINUX_FIRMWARE_AMDGPU=y
BR2_PACKAGE_LINUX_FIRMWARE_QUALCOMM_6174=y
BR2_PACKAGE_LINUX_FIRMWARE_ATHEROS_11K_WCN6855=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XXX=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_RTW89=y
# regulatory.db — required for any WiFi regulatory domain.
BR2_PACKAGE_WIRELESS_REGDB=y

# --- CPU microcode (Intel + AMD) ----------------------------------------------
# No edition shipped any: behoweather's N100 ran its factory revision 0xe
# ("Running old microcode", "Register File Data Sampling: Vulnerable: No
# microcode"; Intel's 20260812 release has 0x21). The image has no initramfs, so
# the files are built INTO the kernel (CONFIG_EXTRA_FIRMWARE, set by external.mk)
# and the early loader applies them at boot. Riding inside bzImage means every
# existing install gets them from a normal update - no grub.cfg or updater change.
# Not installed to /lib/firmware: the kernel copy is the one that is used.
BR2_PACKAGE_INTEL_MICROCODE=y
# BR2_PACKAGE_INTEL_MICROCODE_INSTALL_TARGET is not set
BR2_PACKAGE_LINUX_FIRMWARE_AMD_UCODE=y

# --- Installer / rescue tooling (future: install PengyOS to a target disk) ---
# The stick doubles as a rescue/installer: partition a target disk (parted /
# sgdisk / fdisk), format it (mke2fs / mkfs.vfat / btrfs), and make it bootable
# (grub-install + efibootmgr). grub-install/grub-mkimage/grub-mkconfig come from
# BR2_TARGET_GRUB2_INSTALL_TOOLS. fdisk is already present via util-linux.
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_E2FSPROGS_RESIZE2FS=y
BR2_PACKAGE_DOSFSTOOLS=y
BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT=y
BR2_PACKAGE_DOSFSTOOLS_FSCK_FAT=y
BR2_PACKAGE_PARTED=y
BR2_PACKAGE_BTRFS_PROGS=y
BR2_PACKAGE_EXFATPROGS=y
BR2_PACKAGE_EFIBOOTMGR=y
BR2_PACKAGE_DMIDECODE=y
BR2_PACKAGE_RSYNC=y
BR2_PACKAGE_CRYPTSETUP=y
BR2_PACKAGE_LVM2=y
BR2_PACKAGE_UTIL_LINUX_FSCK=y
BR2_PACKAGE_UTIL_LINUX_PARTX=y
BR2_PACKAGE_UTIL_LINUX_WIPEFS=y
BR2_TARGET_GRUB2_INSTALL_TOOLS=y

# --- Python (agent-operable OS) ---------------------------------------------
# Agents script in Python constantly for tasks beyond shell. Ship a
# batteries-included interpreter + the common stdlib extension modules so an
# agent (and a human) can operate the system comfortably.
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_SSL=y          # ssl / https
BR2_PACKAGE_PYTHON3_ZLIB=y
BR2_PACKAGE_PYTHON3_BZIP2=y
BR2_PACKAGE_PYTHON3_XZ=y
BR2_PACKAGE_PYTHON3_ZSTD=y
BR2_PACKAGE_PYTHON3_SQLITE=y       # sqlite3
BR2_PACKAGE_PYTHON3_READLINE=y     # interactive REPL
BR2_PACKAGE_PYTHON3_CURSES=y
BR2_PACKAGE_PYTHON3_PYEXPAT=y      # xml
BR2_PACKAGE_PYTHON3_UNICODEDATA=y
BR2_PACKAGE_PYTHON3_DECIMAL=y

# --- Pengy: the built-in agent ------------------------------------------------
# package/pengy (PengyR): one Rust agent core, three front ends — pengy-cli in
# every edition, pengy-web from Server, the Qt6 desktop app from Desktop.
# Configured at install, not at build: the installer's Pengy page (base URL, API
# key, model — skippable) seeds ~/.config/pengy/settings.json for the user it
# creates, and the core overlay's /etc/skel/skills gives every home the skills
# the system message points at. A machine that skipped the page keeps Pengy's
# own defaults (the local endpoint, no key, no model).
BR2_PACKAGE_PENGY=y
BR2_PACKAGE_PENGY_CLI=y

# --- Rootfs overlay ---------------------------------------------------------
# $(BR2_EXTERNAL_PENGYOS_PATH) is the absolute path to this external tree
# (Buildroot exports it because external.desc names the tree "PENGYOS");
# absolute board-file references keep the target working from any output dir.
# BR2_ROOTFS_OVERLAY: set by the desktop layer

# --- Kernel -----------------------------------------------------------------
# Pin the kernel explicitly — never a floating "latest" (SPEC §1.6).
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.2.12"
# Kernel headers: use a series Buildroot 2026.08 knows (7.1). Headers <= kernel
# is the correct relationship; AS_KERNEL starves glibc's dependency check when
# Buildroot does not yet know the kernel's series (learned on the first builds).
BR2_KERNEL_HEADERS_7_1=y
# Build the qemu x86_64 defconfig kernel, then layer the systemd fragment on
# top (BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES). The fragment supplies the
# kernel symbols systemd needs at boot (virtio, devtmpfs, serial8250, ext4).
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
# BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES: set by the desktop layer

# --- Root filesystem (ext4) --------------------------------------------------
# 1G: the base system is ~70M, but the firmware set + installer tooling above
# (i915/amdgpu/wifi firmware, e2fsprogs/parted/btrfs/xfs) add up to hundreds of MB.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
# BR2_TARGET_ROOTFS_EXT2_SIZE: set by the nvidia layer
# Post-build tweaks: hostname, provenance copy, GRUB menu install.
# BR2_ROOTFS_POST_BUILD_SCRIPT: set by the desktop layer

# --- Bootable USB/disk image: GRUB2 (UEFI) + genimage -------------------------
# BR2_TARGET_GRUB2 is a *menuconfig* in Buildroot 2026.08 — a valid symbol,
# settable in defconfigs like any other bool.
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_X86_64_EFI=y
# Video/gfxterm modules so GRUB can draw a full-screen menu with a real font.
# The stock EFI module list has no video/terminal support, so GRUB falls back to
# the firmware's tiny 80x25 text mode.
# serial: grub.cfg probes for a real UART before adding console=ttyS0.
# BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI: set by the server layer
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
# The core post-build prunes linux-firmware's iwlwifi API versions
# (board/common/prune-iwlwifi.py), and that script imports lzma to read the .xz
# firmware files. Buildroot pulls host Python's xz support in only when this is
# set: the Desktop got it by accident through fwupd-efi's `uswid` (see the
# desktop layer), Core and Server never did, so the first build after the prune
# landed died in post-build with "No module named '_lzma'" (26.10.33). Same
# reason and same symbol as the Desktop's.
# BR2_PACKAGE_HOST_PYTHON3_XZ: set by the desktop layer
# post-image.sh stamps the rootfs UUID into grub.cfg + genimage.cfg and
# assembles the GPT disk image with genimage.
# BR2_ROOTFS_POST_IMAGE_SCRIPT: set by the desktop layer

# --- Swap on zram (every edition) ---------------------------------------------
# No edition had any swap: running out of RAM froze the machine. zram-generator
# (our package) makes /dev/zram0 a zstd-compressed swap device at boot, sized
# min(RAM, 8 GiB) of uncompressed data, as Fedora and Pop!_OS do. Kernel side:
# board/core/linux.fragment.
BR2_PACKAGE_ZRAM_GENERATOR=y
# util-linux's mkswap/swapon (and the rest of its basic set): systemd-makefs
# and the generated swap unit drive them with options BusyBox's applets lack
# ("Usage: mkswap [-L LBL] BLOCKDEV", zram swap failed). zramctl to inspect it.
# BR2_PACKAGE_UTIL_LINUX_BINARIES: set by the server layer
BR2_PACKAGE_UTIL_LINUX_ZRAMCTL=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_PENGYOS_PATH)/patches"

# ############################################################################
# ## layer: server
# ############################################################################

# ============================================================================
# PengyOS Server layer — Core + remote work + services
# ----------------------------------------------------------------------------
# Stacked on layers/core.config (everything Core has, Server has). Adds the
# server toolset (mosh, tmux, ripgrep, jq, the comfort-CLI set), rootless
# podman, and the server board (overlay: monitoring, backup, sshd
# config; the firewall is Core's). See configs/layers/README.md.
# ============================================================================

# --- Toolchain ---------------------------------------------------------------
# C++ runtime: mosh is C++, and it is silently dropped without a C++ toolchain
# (the same trap Core hit). Enable it up front so the Server toolset holds.
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# --- System name --------------------------------------------------------------
# BR2_TARGET_GENERIC_HOSTNAME: set by the desktop layer

# --- Userspace: Server toolset ----------------------------------------------
# tmux — persistent terminal sessions for servers/remote admin.
BR2_PACKAGE_TMUX=y
# mosh — remote shell with roaming/handoff (works across NAT and flaky links).
# BR2_PACKAGE_MOSH=y  # probe: mosh selects BR2_PACKAGE_OPENSSH (package/mosh/Config.in:20), which forces stock openssh 10.5p1 back into the image
# ripgrep — server-side text search.
BR2_PACKAGE_RIPGREP=y
# jq — JSON on the command line (config/data wrangling, backup manifests).
BR2_PACKAGE_JQ=y

# --- Userspace: Server comfort-CLI set (US-SRV-1) --------------------
BR2_PACKAGE_BAT=y
BR2_PACKAGE_EZA=y
BR2_PACKAGE_FD=y
BR2_PACKAGE_ZOXIDE=y
# The interactive shell set the comfort profile wires (tools/pengyos-server-toolset):
# fzf (Ctrl-R history / Ctrl-T files), the starship prompt, and the zsh plugins
# (autosuggestions + syntax highlighting). Our recipes; Buildroot has none.
BR2_PACKAGE_FZF=y
BR2_PACKAGE_STARSHIP=y
BR2_PACKAGE_ZSH_AUTOSUGGESTIONS=y
BR2_PACKAGE_ZSH_SYNTAX_HIGHLIGHTING=y

# --- Userspace: the full-featured network + hardware readers ---------------
# The Server's answer to "the tool is there but it is the BusyBox one": real
# netstat/ifconfig/route/arp (net-tools), real ping (iputils), real traceroute,
# lspci/lsusb that resolve IDs to names (pciutils, usbutils), and hdparm -I.
# The matching BusyBox applets are compiled out (board/server/busybox.fragment).
BR2_PACKAGE_NET_TOOLS=y
BR2_PACKAGE_IPUTILS=y
BR2_PACKAGE_TRACEROUTE=y
# BR2_PACKAGE_PCIUTILS: set by the desktop layer
# BR2_PACKAGE_USBUTILS: set by the desktop layer
# BR2_PACKAGE_HDPARM: set by the desktop layer
# zip: unzip came in with Core; the Server also has to produce archives
# (backup bundles, artifacts handed to a laptop).
BR2_PACKAGE_ZIP=y
# BusyBox fragments: the list is replaced, not appended, by a later layer, so
# the Server names Core's fragment alongside its own.
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_PENGYOS_PATH)/board/core/busybox.fragment $(BR2_EXTERNAL_PENGYOS_PATH)/board/server/busybox.fragment"

# --- Userspace: rootless podman ---------------------------------------------
# podman — the rootless container engine the Server edition runs on. The
# overlay's podman.socket + drop-in make it usable without a privileged
# daemon; the package supplies the `podman` binary.
BR2_PACKAGE_PODMAN=y

# --- The developer (US-DEV-*, US-DSK-3) ------------------------------------------
# Every Server is a build box (and so is every Desktop, which stacks on this).
# Python and its stdlib modules come from Core (ssl, zlib, sqlite, xz/bz2/zstd,
# readline, curses, expat, decimal); this adds the CJK codecs and pip. `pip install --user`, venvs and uv work against it; wheels that need
# compiling do so in the distrobox (below).
BR2_PACKAGE_PYTHON3_CODECSCJK=y
BR2_PACKAGE_PYTHON_PIP=y
BR2_PACKAGE_PYTHON_SETUPTOOLS=y
# Shells and source control. zsh is the Desktop installer's default shell for
# the user it creates; root keeps bash.
BR2_PACKAGE_ZSH=y
BR2_PACKAGE_NCURSES_WCHAR=y
BR2_PACKAGE_GIT=y
# The toolchain lane: Buildroot cannot put a compiler on the target (by design,
# since 2012). gcc/clang/rustc/go/headers live in a distrobox container
# (podman) that shares $HOME and feels native — our package.
BR2_PACKAGE_DISTROBOX=y
# util-linux's standard tools (rev — distrobox-enter needs it —, findmnt, lsblk,
# a blkid that knows btrfs, …) instead of busybox's cut-down applets.
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
# curl: every "install X" line (rustup, uv, …) and distrobox itself expect it;
# busybox wget cannot do HTTPS.
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
# The openssl command: pengyos-update checks release signatures (ed25519) with
# it, so the updater carries no crypto code of its own; also handy for admins.
BR2_PACKAGE_LIBOPENSSL_BIN=y
# FUSE (kernel CONFIG_FUSE_FS via libfuse3's kconfig fixup, plus fusermount3):
# rclone mount, sshfs-style tools, AppImages. The Desktop already pulled it in
# through its portals; the Server had no /dev/fuse at all.
BR2_PACKAGE_LIBFUSE3=y

# --- An unattended box: health, VPN, NIC, GPU firmware, wheels (2026-10-25) ----
# Found by setting the 26.10.40 Server against its user stories next to the
# Desktop, which had these (moved here; Desktop inherits them).
# - Disk health (US-SRV-3): a failing disk is how a home server usually dies, and
#   the Server could not read SMART or NVMe health logs at all.
BR2_PACKAGE_SMARTMONTOOLS=y
BR2_PACKAGE_NVME=y
# - WireGuard (US-SRV-5): the kernel module was there, but not `wg`, so a tunnel's
#   keys could not be made (`wg genkey`) or a live one inspected (`wg show`).
BR2_PACKAGE_WIREGUARD_TOOLS=y
# - ethtool: link speed, offloads, and Wake-on-LAN for a box that sleeps.
BR2_PACKAGE_ETHTOOL=y
# - Firmware for the xe GPU driver (server/linux.fragment): US-SRV-9 transcoding
#   on Battlemage / Lunar Lake and later.
BR2_PACKAGE_LINUX_FIRMWARE_XE=y
# - Python wheels (US-SRV-10): the manylinux policy lets a wheel assume the host
#   has libGL.so.1 and five X11 client libraries, so wheels never bundle them.
#   Without them `uv add opencv-python` installed and then failed at import
#   ("libGL.so.1: cannot open shared object file"). libglvnd's dispatch
#   libraries and the X11 client libraries only, no GL driver: see
#   BR2_PENGYOS_MANYLINUX_LIBS in Config.in. XORG7 is only the menu the X11
#   libraries live under; no X server is built.
# BR2_PACKAGE_XORG7: set by the desktop layer
BR2_PENGYOS_MANYLINUX_LIBS=y

# --- The installer + the partition & state layout (docs/state-layout.md) -------
# Server and Desktop install the same way: the USB stick carries the image as a
# payload, `pengyos-install image` lays it onto a disk as ESP + two root slots +
# a btrfs data partition, and installed systems boot the root READ-ONLY through
# preinit. The engine and the console installer are stdlib-only Python
# (post-build.sh installs them). What they need beyond Core:
#   zstd    the payload is zstd-compressed
#   sgdisk  partitioning + relabelling (GUIDs, backup GPT) the installed disk
#   sudo    the created user is the admin (wheel; overlay: /etc/sudoers.d/wheel)
BR2_PACKAGE_ZSTD=y
BR2_PACKAGE_GPTFDISK=y
BR2_PACKAGE_GPTFDISK_SGDISK=y
BR2_PACKAGE_SUDO=y
# Login sessions: PAM + systemd-logind, so an SSH (or console) login is a real
# logind session — /run/user/UID, the user's systemd manager and a delegated
# cgroup. Rootless podman (and so distrobox) needs that: without it runc failed
# with "rootless needs no limits + no cgrouppath" for every SSH user.
# sshd uses PAM (overlay: /etc/pam.d/sshd, UsePAM yes) but stays key-only.
BR2_PACKAGE_LINUX_PAM=y
# File permissions (board/server/permissions.txt): unix_chkpwd
# setuid so pam_unix can check an unprivileged user's password.
# BR2_ROOTFS_DEVICE_TABLE: set by the desktop layer
BR2_PACKAGE_SYSTEMD_LOGIND=y
# GRUB: Core's modules + loadenv/test — the installed grub.cfg picks the root
# slot from grubenv.
BR2_TARGET_GRUB2_BUILTIN_MODULES_EFI="boot linux ext2 fat part_msdos part_gpt normal efi_gop gfxterm gfxmenu font all_video videoinfo loadenv test smbios serial"

# --- Virtual machines: QEMU + KVM (2026-10-11) ---------------------------------
# Server and Desktop run VMs out of the box (`qemu-system-x86_64 -enable-kvm`);
# KVM itself is in board/server/linux.fragment, and /dev/kvm is 0666 (systemd's
# default rule). x86_64 guests only: one target keeps the build and the image
# small. TCG stays as the fallback where KVM is unavailable (nested, VT-x off).
# The blobs are the guest firmware: SeaBIOS, option ROMs, and QEMU's own edk2
# builds for UEFI guests. qemu-img for disk images, SLIRP for -nic user.
BR2_PACKAGE_QEMU=y
BR2_PACKAGE_QEMU_SYSTEM=y
BR2_PACKAGE_QEMU_SYSTEM_KVM=y
BR2_PACKAGE_QEMU_SYSTEM_TCG=y
BR2_PACKAGE_QEMU_CHOOSE_TARGETS=y
BR2_PACKAGE_QEMU_TARGET_X86_64=y
BR2_PACKAGE_QEMU_BLOBS=y
BR2_PACKAGE_QEMU_SLIRP=y
BR2_PACKAGE_QEMU_TOOLS=y

# --- Board: server ----------------------------------------------
# The Server's overlay (sshd config, monitoring + backup
# timers, podman socket, rootless-podman defaults) and post-build stack on
# Core's; the post-image script replaces Core's.
# BR2_ROOTFS_OVERLAY: set by the desktop layer
# BR2_ROOTFS_POST_BUILD_SCRIPT: set by the desktop layer
# BR2_ROOTFS_POST_IMAGE_SCRIPT: set by the desktop layer
# Kernel: stacked on Core's fragment (fragments accumulate across layers).
# BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES: set by the desktop layer

# --- Pengy web UI (package/pengy; the CLI comes from Core) --------------------
BR2_PACKAGE_PENGY_WEB=y

# ############################################################################
# ## layer: desktop
# ############################################################################

# ============================================================================
# PengyOS Desktop layer — Server + the graphical stack + apps + full hardware
# ----------------------------------------------------------------------------
# Stacked on layers/core.config + layers/server.config (everything Server has,
# Desktop has). Adds the Wayland/COSMIC stack, desktop hardware support, the
# installer, and the developer set, on the desktop board.
# See configs/layers/README.md.
# ============================================================================

# --- System name --------------------------------------------------------------
BR2_TARGET_GENERIC_HOSTNAME="pengyos-desktop"

# --- Userspace additions to the base -------------------------------------------
# polkit: authorizes the flatpak system helper so cosmic-store can INSTALL apps
# (the helper routes privileged writes through org.freedesktop.PolicyKit1).
BR2_PACKAGE_POLKIT=y
# --- Flatpak: the app lane (SPEC §2.5) ----------------------------------------
# Built from source (package/flatpak, with package/appstream and
# package/libfyaml) — it used to be copied from the build host by post-build.
BR2_PACKAGE_FLATPAK=y
# update-desktop-database for flatpak's install trigger ("Open with" sees new apps).
BR2_PACKAGE_DESKTOP_FILE_UTILS_TARGET=y
# --- Flatpak sandbox runtime (bwrap + xdg-dbus-proxy) -------------------------
# flatpak EXECs two runtime helpers for every app run that weren't staged, so
# `flatpak run org.mozilla.firefox` died:
#   error: Failed to execute child process "bwrap" (No such file or directory)
# and, once bwrap was present,
#   bwrap: execvp xdg-dbus-proxy: No such file or directory
#   error: Failed to sync with dbus proxy
# The app-lane's whole point is the sandbox, so build both into the image
# (both are stock Buildroot 2026.08 meson recipes, same class as flatpak).
# bubblewrap installs /usr/bin/bwrap setuid (1755 root:root) so it works even
# where unprivileged user namespaces are off; xdg-dbus-proxy is the filtered
# D-Bus proxy the sandbox talks through. Verified end-to-end on the flashed
# Desktop image: with both on PATH, `flatpak run --command=sh … -c` reaches
# SANDBOX_OK as the desktop user.
BR2_PACKAGE_BUBBLEWRAP=y
BR2_PACKAGE_XDG_DBUS_PROXY=y
# hicolor-icon-theme: the freedesktop fallback theme's index.theme with a
# section per directory. Icon lookup ignores any directory without one, so
# COSMIC's hicolor-only icons (e.g. cosmic-settings' Dark/Light illustrations
# in scalable/status) resolved to nothing.
BR2_PACKAGE_HICOLOR_ICON_THEME=y

# --- Board: desktop ------------------------------------------------
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PENGYOS_PATH)/board/core/rootfs-overlay $(BR2_EXTERNAL_PENGYOS_PATH)/board/server/rootfs-overlay $(BR2_EXTERNAL_PENGYOS_PATH)/board/desktop/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_PENGYOS_PATH)/board/core/post-build.sh $(BR2_EXTERNAL_PENGYOS_PATH)/board/server/post-build.sh $(BR2_EXTERNAL_PENGYOS_PATH)/board/desktop/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_PENGYOS_PATH)/board/desktop/post-image.sh"
# Kernel: the desktop fragment (DRM, audio, Wi-Fi/BT, input, filesystems, …)
# stacked on Core's and Server's (fragments accumulate across layers).
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_PENGYOS_PATH)/board/core/linux.fragment $(BR2_EXTERNAL_PENGYOS_PATH)/board/server/linux.fragment $(BR2_EXTERNAL_PENGYOS_PATH)/board/desktop/linux.fragment"
# The whole system image. ~2.2G used with the full desktop hardware stack
# (firmware ~350M, the COSMIC apps ~800M — each statically links its GUI
# toolkit — Mesa + LLVM, the media driver). Installed systems grow it to their
# 8 GiB root slot (docs/state-layout.md), so it must stay under 8G.
# 2.5G used at 3000M (92%) once Xwayland/X11 landed; 3500M then 4000M (the
# distro-parity additions, 2026-09-30). Slots are 8 GiB.
# BR2_TARGET_ROOTFS_EXT2_SIZE: set by the nvidia layer

# --- Graphics: Mesa (EGL/GBM/GLES) -------------------------------------------
# virgl: QEMU's virtio-gpu-gl. llvmpipe: the software rasterizer (LLVM JIT,
# already in the image for radeonsi) EGL/GBM needs when the DRM device has no
# GPU driver — a VM, or on real hardware the firmware framebuffer (simpledrm) of
# a GPU we have no driver for. (softpipe, Mesa's slow reference rasterizer,
# comes along with lavapipe below.)
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_LLVMPIPE=y
BR2_PACKAGE_MESA3D_GBM=y
BR2_PACKAGE_MESA3D_OPENGL_EGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y
# Fonts: fontconfig/FreeType, and DejaVu as the wide-coverage fallback (COSMIC's
# own fonts are below).
BR2_PACKAGE_FONTCONFIG=y
BR2_PACKAGE_FREETYPE=y
BR2_PACKAGE_DEJAVU=y

# --- Locales ----------------------------------------------------------------
# COSMIC, GTK and Qt need a valid UTF-8 locale. Until 26.10.23 only en_US
# existed, so anyone outside the US could not pick their language or date/number
# format: COSMIC Settings -> Region & Language lists what `locale -a` prints
# (external.mk installs `locale`), and the list was empty. The common UTF-8
# locales (~50 MB in /usr/lib/locale/locale-archive, against 3 MB for en_US).
BR2_GENERATE_LOCALE="C.UTF-8 en_US.UTF-8 en_GB.UTF-8 en_CA.UTF-8 en_AU.UTF-8 en_IE.UTF-8 en_NZ.UTF-8 en_IN.UTF-8 en_ZA.UTF-8 fr_FR.UTF-8 fr_CA.UTF-8 fr_BE.UTF-8 fr_CH.UTF-8 de_DE.UTF-8 de_AT.UTF-8 de_CH.UTF-8 es_ES.UTF-8 es_MX.UTF-8 es_AR.UTF-8 es_CO.UTF-8 es_CL.UTF-8 es_US.UTF-8 it_IT.UTF-8 pt_BR.UTF-8 pt_PT.UTF-8 nl_NL.UTF-8 nl_BE.UTF-8 sv_SE.UTF-8 nb_NO.UTF-8 da_DK.UTF-8 fi_FI.UTF-8 pl_PL.UTF-8 cs_CZ.UTF-8 sk_SK.UTF-8 hu_HU.UTF-8 ro_RO.UTF-8 ru_RU.UTF-8 uk_UA.UTF-8 tr_TR.UTF-8 el_GR.UTF-8 he_IL.UTF-8 ar_EG.UTF-8 hi_IN.UTF-8 ja_JP.UTF-8 zh_CN.UTF-8 zh_TW.UTF-8 ko_KR.UTF-8 vi_VN.UTF-8 th_TH.UTF-8 id_ID.UTF-8"

# --- Portals (screenshots, file pickers, sandboxed apps) ---------------------
# xdg-desktop-portal and COSMIC's backend are our packages (Buildroot has
# neither; package/xdg-desktop-portal fetches its libglnx and gvdb meson
# subprojects at pinned revisions).
BR2_PACKAGE_XDG_DESKTOP_PORTAL=y
BR2_PACKAGE_COSMIC_PORTAL=y
# The portals COSMIC's backend doesn't implement (even upstream: it has only
# Access, FileChooser, RemoteDesktop, Screenshot, Settings, ScreenCast), as
# Pop!_OS ships them: portals.conf says "cosmic;gtk". Without an AppChooser
# backend xdg-desktop-portal doesn't offer OpenURI at all, so Flatpak apps
# could not open a link or a file in another app; Inhibit, Notification,
# Print, DynamicLauncher were missing too. Needs GTK3 on the host (Wayland +
# X11 backends; not Broadway, GTK-in-a-web-browser).
BR2_PACKAGE_LIBGTK3=y
# BR2_PACKAGE_LIBGTK3_BROADWAY is not set
BR2_PACKAGE_XDG_DESKTOP_PORTAL_GTK=y
# dconf: the GSettings backend. Without it GLib uses its keyfile backend, where
# concurrent writers lose each other's keys: cosmic-settings-daemon's login
# writes raced and Firefox/Chrome came up with a close button only (beholaptop,
# 26.10.32). dconf-service applies writes in order. The user unit
# pengyos-gsettings-keyfile-migrate.service moves an existing keyfile into it.
BR2_PACKAGE_DCONF=y
# librsvg, for its gdk-pixbuf SVG loader (enabled in external.mk): host GTK3
# windows (the portal's app chooser, print dialog) could not load a single
# icon of the SVG-only Cosmic theme.
BR2_PACKAGE_LIBRSVG=y

# --- Mesa hardware drivers ---------------------------------------------------
# Without a hardware driver Mesa falls back to software GL, which has no
# dmabuf import, so cosmic-comp cannot composite client buffers ("Dmabuf import
# extension not available": grey screen, no panel). Intel: iris (Gen8+, incl.
# the N100's Gen12). NVIDIA uses NVIDIA's driver (layers/nvidia.config).
BR2_PACKAGE_MESA3D_LLVM=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_IRIS=y
# AMD: radeonsi (GL), radv (Vulkan), libdrm_amdgpu, firmware; LLVM for both.
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_RADEONSI=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_AMD=y
BR2_PACKAGE_LIBDRM_AMDGPU=y
BR2_PACKAGE_LINUX_FIRMWARE_RADEON=y
BR2_PACKAGE_LLVM=y

# --- Vulkan -----------------------------------------------------------------
# COSMIC's apps render through wgpu, which wants Vulkan; without it wgpu falls
# back to its GL backend, and that backend draws only the LAST canvas of a
# window: cosmic-monitor showed one graph, in the wrong place, left over from
# the previous page (behoweather N100 and QEMU llvmpipe, 2026-09-30; the
# tiny-skia renderer draws the same window correctly). The image had radv but
# no Vulkan loader, so not even AMD machines used Vulkan.
# anv (Intel, the N100's Gen12) and lavapipe (CPU: VMs, and a GPU we have no
# driver for) join radv; the loader picks the device.
BR2_PACKAGE_VULKAN_LOADER=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_INTEL=y
BR2_PACKAGE_MESA3D_VULKAN_DRIVER_SWRAST=y

# --- X11 apps: Xwayland -----------------------------------------------------------
# Steam (and most games through it), plus any app that still only speaks X11,
# need an X server; cosmic-comp starts Xwayland at login when it finds it on
# PATH (else it logs "Running without Xwayland"). No Xorg server: the session
# stays Wayland, X11 clients are windows in it. The X.org client libraries this
# pulls in are also what NVIDIA's Vulkan driver links (layers/nvidia.config).
# - libepoxy: Xwayland's glamor, so X11 apps draw on the GPU, not pixman.
# - GLX: X11 OpenGL apps. Mesa's GLX beside its VA-API drivers requires
#   libglvnd (Mesa then ships as a glvnd vendor, as on every distro); the
#   NVIDIA driver plugs into the same libglvnd.
# - xkbcomp: Xwayland compiles its keymap with it at startup and exits without.
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XWAYLAND=y
BR2_PACKAGE_XAPP_XKBCOMP=y
# xrdb: cosmic-comp hands X11 apps (Steam) the cursor theme and size with
# `xrdb -merge`; without it they got X's default cursor ("`xrdb` not found,
# cannot update Xresources"). With no cpp in the image xrdb skips preprocessing.
BR2_PACKAGE_XAPP_XRDB=y
BR2_PACKAGE_LIBEPOXY=y
BR2_PACKAGE_LIBGLVND=y
BR2_PACKAGE_MESA3D_OPENGL_GLX=y

# --- Prebuilt apps (AppImages): the libraries they link but do not bundle ----
# Xwayland already pulls in most of the X client stack, but not all of it, so a
# prebuilt X11 binary still died at load. Measured on beholaptop (26.10.42,
# 2026-10-25): Playwright's Chromium lacked libnss3/libnssutil3/libsmime3/
# libnspr4/libXcomposite; Qt >= 6.5 dlopens libxcb-cursor from its xcb platform
# plugin, so a Qt 6 AppImage that doesn't bundle it fails with a platform-plugin
# error, not a missing library. Well-built AppImages bundle their toolkit; these
# are the libraries they expect the host to provide. Rule for adding more:
# small linkage glue only (no daemon, no codecs, no language runtimes; the app
# ships those). This does not make Chromium a supported browser engine; see
# docs/browser-engine-viability.md (Band 5, Flatpak).
# - NSS/NSPR: Chromium and Electron TLS/cert code (libfreebl3, libsoftokn3 and
#   libnssckbi come with it; NSS dlopens them).
BR2_PACKAGE_LIBNSS=y
# - libsecret: the keyring client Chromium, Electron and VS Code dlopen. It talks
#   to the oo7 Secret Service below; without it they store secrets in plain text.
BR2_PACKAGE_LIBSECRET=y
# - X client libraries Xwayland did not pull in. libXss: older Electron links it
#   directly (current Chromium no longer does). Xft/Xpm/Xcursor/Xinerama: older
#   X11 toolkits and apps.
BR2_PACKAGE_XLIB_LIBXCOMPOSITE=y
BR2_PACKAGE_XLIB_LIBXCURSOR=y
BR2_PACKAGE_XLIB_LIBXINERAMA=y
BR2_PACKAGE_XLIB_LIBXFT=y
BR2_PACKAGE_XLIB_LIBXPM=y
BR2_PACKAGE_XLIB_LIBXSCRNSAVER=y
# - xcb-util family: Qt 6's xcb plugin (cursor, icccm, image, keysyms,
#   render-util), SDL and other xcb clients. -wm provides icccm and ewmh.
BR2_PACKAGE_XCB_UTIL=y
BR2_PACKAGE_XCB_UTIL_CURSOR=y
BR2_PACKAGE_XCB_UTIL_IMAGE=y
BR2_PACKAGE_XCB_UTIL_KEYSYMS=y
BR2_PACKAGE_XCB_UTIL_RENDERUTIL=y
BR2_PACKAGE_XCB_UTIL_WM=y

# --- GPU firmware (linux-firmware subset) ------------------------------------
# Without firmware i915 logs adlp_dmc.bin/tgl_guc_70.bin -ENOENT and declares
# the GPU wedged (no hardware GL). i915 is a module (=m in linux.fragment) so it
# loads after the rootfs and can find these; a built-in driver with no
# initramfs never does.
# Wi-Fi firmware for the drivers in linux.fragment (the N100's Intel CNVi had no
# driver or firmware: no wlan interface at all).
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_22000=y
BR2_PACKAGE_LINUX_FIRMWARE_IWLWIFI_7=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7921=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7922=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX=y
# The wireless regulatory database (cfg80211: "regulatory.db failed with error
# -2" without it -> world-roaming limits), and the Realtek r8169 NIC firmware
# (rtl8168h-2.fw on the N100; it runs without, but the vendor fixes are in it).
# Bluetooth firmware for btusb (linux.fragment): Intel (ibt-*, the N100's AX101
# Bluetooth), Realtek, MediaTek.
BR2_PACKAGE_LINUX_FIRMWARE_IBT=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_87XX_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_RTL_88XX_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7921_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7922_BT=y
# Firmware for the drivers linux.fragment added for hardware outside the fleet
# (2026-10-11): MediaTek MT7925 Wi-Fi + Bluetooth, Qualcomm WCN7850 (ath12k);
# the xe GPU firmware is in server.config. Intel Wi-Fi 7, the Qualcomm WCN7850
# Bluetooth and the laptop speaker amplifiers have no Buildroot option:
# external.mk installs those files.
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7925=y
BR2_PACKAGE_LINUX_FIRMWARE_MEDIATEK_MT7925_BT=y
BR2_PACKAGE_LINUX_FIRMWARE_QUALCOMM_WCN7850=y

# --- Input: libinput ------------------------------------------------------------
# cosmic-comp links libinput.so.10. It used to arrive only because Weston
# selected it; once Weston went (10-01) a fresh build had none, and 26.10.3's
# compositor exited at start (127). Name it here. (board/common/
# check-needed-libs.py now fails the build on any unresolved library.)
BR2_PACKAGE_LIBINPUT=y

# --- EDID parsing: libdisplay-info ---------------------------------------------
# cosmic-comp links libdisplay-info.so.3 to parse every monitor's EDID. Stock
# 0.4.0 is soversion 4 and cosmic-comp's libdisplay-info-sys accepts < 0.4.0, so
# the image builds a 0.3.0 fork; post-build used to copy the build host's Ubuntu
# copy instead. divergence.toml -> libdisplay-info-0.3.0-fork.
BR2_PACKAGE_LIBDISPLAY_INFO=n
BR2_PACKAGE_LIBDISPLAY_INFO_PENGYOS=y

# --- Seat management (libseat) -----------------------------------------------
# cosmic-comp acquires the DRM device through smithay's libseat backend and
# must become DRM *master* to drive the scanout. Buildroot auto-selects
# BR2_PACKAGE_SEATD_BUILTIN when neither logind nor the seatd *daemon* is on;
# with the builtin backend the compositor logs
#   smithay::backend::drm::device::fd: Unable to become drm master,
#   assuming unprivileged mode
# and the screen stays black. Ship the seatd daemon so libseat's seatd backend
# can activate the VT and hand out a DRM-master device (logind, below, serves
# the login1 API alongside it).
BR2_PACKAGE_SEATD=y
BR2_PACKAGE_SEATD_DAEMON=y
# --- Power / session D-Bus API (systemd-logind) ------------------------------
# COSMIC's power actions (cosmic-osd restart/shutdown confirm, the Power
# settings page, cosmic-idle suspend, lid/power-key handling) all call
# org.freedesktop.login1 on the system bus. Without logind the confirm dialog
# failed with "ServiceUnknown: org.freedesktop.login1" and nothing happened.
# logind runs ALONGSIDE seatd: the session still gets its DRM master from seatd
# (LIBSEAT_BACKEND=seatd in start-cosmic and cosmic-greeter-start); logind only serves the
# login1 API. systemd is built with polkit support (-Dpolkit=enabled) so logind
# authorizes callers through the polkit daemon already in the image (root is
# allowed regardless). (logind itself: Server layer.)
# NOT via BR2_PACKAGE_SYSTEMD_POLKIT: that makes systemd depend on polkit, while
# polkit's logind session tracking (external.mk) needs libsystemd first -- a
# dependency cycle that broke any build of systemd after polkit. external.mk
# sets the meson option instead; systemd needs polkit only at runtime.
# BR2_PACKAGE_SYSTEMD_POLKIT is not set
# --- Networking ----------------------------------------------------------------
# NetworkManager is the network service (board/desktop/rootfs-overlay/etc/
# NetworkManager/NetworkManager.conf); systemd-networkd is not built. The panel's
# network applet and the Settings network page drive it. (Until 26.10.23 this
# section pointed at tools/pengyos-desktop-net, retired: its overlay files were
# not read by anything.)
#
# Wi-Fi backend: wpa_supplicant is a real Buildroot 2026.08 symbol and configures
# cleanly (it selects BR2_PACKAGE_WPA_SUPPLICANT_NL80211, the driver interface
# NetworkManager's wpa_supplicant plugin drives).
BR2_PACKAGE_WPA_SUPPLICANT=y
# NetworkManager drives wpa_supplicant over D-Bus (it starts it as `-u`); built
# without D-Bus it printed its usage and exited, so on the N100 NM showed the
# Wi-Fi as enabled but "unavailable" with no networks ("Failed to D-Bus activate
# wpa_supplicant service"). WPA3 (SAE) for current routers, EAP for WPA2/3-
# Enterprise (work/campus networks), autoscan for roaming.
BR2_PACKAGE_WPA_SUPPLICANT_DBUS=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
BR2_PACKAGE_WPA_SUPPLICANT_WPA3=y
BR2_PACKAGE_WPA_SUPPLICANT_EAP=y
BR2_PACKAGE_WPA_SUPPLICANT_AUTOSCAN=y
# NetworkManager is THE network service on the Desktop (the wpa_supplicant
# backend above is what it drives). It is a stock 2026.08 package
# (BR2_PACKAGE_NETWORK_MANAGER, package/network-manager/): enabling it pulls dbus,
# libglib2, util-linux and the keyfile plugin the overlay's /etc/NetworkManager
# config expects. nmcli (BR2_PACKAGE_NETWORK_MANAGER_CLI) gives the installer a
# CLI path to the same service. With NM owning the link and the networkd stub
# removed, NM is the sole network service.
BR2_PACKAGE_NETWORK_MANAGER=y
BR2_PACKAGE_NETWORK_MANAGER_CLI=y
# Wi-Fi hotspot ("share this connection"): NetworkManager's shared mode starts
# /usr/sbin/dnsmasq for the DNS + DHCP lease pool. external.mk names that path so
# the build is host-independent, but the image carried no dnsmasq, so a hotspot
# could never come up. Ship it. Buildroot's dnsmasq only installs an init script
# under sysvinit, and PengyOS is systemd, so this adds the binary and nothing
# that starts by itself: NM spawns it per shared connection.
BR2_PACKAGE_DNSMASQ=y
# ...but Buildroot builds systemd-networkd by default, and removing the .network
# stub left networkd itself enabled: systemd-networkd-wait-online then waited
# out its 2-minute timeout on every boot and failed. NM is the network service,
# so don't build networkd at all.
# BR2_PACKAGE_SYSTEMD_NETWORKD is not set
# The GUI path to Wi-Fi: cosmic-applet-network (in the cosmic-applets package)
# lives in the cosmic-build release, so post-build.sh drops it into the image
# (it is NOT a Buildroot recipe). COSMIC's default panel shows it, and
# cosmic-settings' network page serves over NetworkManager.

# --- Audio + Bluetooth ---------------------------------------------------------
# PipeWire + WirePlumber (policy and units in the board overlay), BlueZ.
# WirePlumber's scripts need Lua 5.3; set it first so its `depends on` holds.
BR2_PACKAGE_LUA=y
BR2_PACKAGE_LUA_5_3=y
BR2_PACKAGE_PIPEWIRE=y
