BR2_PACKAGE_RTKIT=y
BR2_PACKAGE_GEOCLUE=y
BR2_PACKAGE_GLIB_NETWORKING=y
BR2_PACKAGE_V4L2LOOPBACK=y

# --- Programs COSMIC runs by name (2026-10-11) ----------------------------------
