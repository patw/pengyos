BR2_PACKAGE_BLUEZ5_UTILS_MONITOR=y
# l2ping/btattach/hex2hcd/rctest: btattach is the one that matters for hardware
# people actually own — UART/SPI-attached adapters on laptops and mini PCs, which
# bluetoothd cannot see otherwise.
BR2_PACKAGE_BLUEZ5_UTILS_TOOLS=y
# hcitool/sdptool/hcidump/hciconfig/rfcomm: the tools for old or odd devices, and
# the only way to ask a device what it is without pairing it. BlueZ calls them
# deprecated; every BT debugging guide still starts with them.
BR2_PACKAGE_BLUEZ5_UTILS_DEPRECATED=y
# DualShock 3 has no HID descriptor the kernel can use: it needs BlueZ's own
# sixaxis plugin, so without this a DS3 pairs and then does nothing at all.
BR2_PACKAGE_BLUEZ5_UTILS_PLUGINS_SIXAXIS=y

