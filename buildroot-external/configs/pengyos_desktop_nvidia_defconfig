# Pengy desktop app (package/pengy; CLI from Core, web UI from Server): Qt6
# Widgets/Network/Svg, native on Wayland (qt6wayland), pinned first in the
# dock (post-build favorites). Qt's text/image stack uses the system fontconfig,
# harfbuzz, PNG/JPEG; D-Bus for portals and the system theme.
BR2_PACKAGE_QT6=y
BR2_PACKAGE_QT6BASE_GUI=y
BR2_PACKAGE_QT6BASE_WIDGETS=y
BR2_PACKAGE_QT6BASE_NETWORK=y
BR2_PACKAGE_QT6BASE_OPENGL=y
BR2_PACKAGE_QT6BASE_FONTCONFIG=y
BR2_PACKAGE_QT6BASE_HARFBUZZ=y
BR2_PACKAGE_QT6BASE_PNG=y
BR2_PACKAGE_QT6BASE_JPEG=y
BR2_PACKAGE_QT6BASE_DBUS=y
# PrintSupport: mdit's PDF export (QPdfWriter).
BR2_PACKAGE_QT6BASE_PRINTSUPPORT=y
BR2_PACKAGE_QT6SVG=y
BR2_PACKAGE_QT6WAYLAND=y
BR2_PACKAGE_PENGY_GUI=y
# mdit (our package): the Markdown editor, a Qt6 Widgets app with a live
# preview and HTML/PDF export; themed by cutecosmic like Pengy.
BR2_PACKAGE_MDIT=y
# cutecosmic (our package): the Qt platform theme that makes Qt apps follow
# COSMIC's dark/light mode, accent, fonts, icons and file dialogs; loaded
# automatically inside the COSMIC session. Built without Qt Quick (patch).
BR2_PACKAGE_CUTECOSMIC=y
# The image viewer is COSMIC Viewer (pop-os/cosmic-viewer, built on the host
# with the other COSMIC apps; post-build installs it). It decodes in Rust, so it
# needs no image libraries here. The overlay's
# /usr/share/applications/mimeapps.list makes it the default for images (and
# COSMIC Edit / Player / Files for text / media / folders).

# ============================================================================
# Desktop parity, tier 2 (2026-09-30): what Pop!_OS / Fedora / Ubuntu desktops
# have that COSMIC's own apps use or users expect.
# ============================================================================
# COSMIC Settings: Region & Language talks to systemd-localed (locale1), and
# Users to AccountsService (our package) -- both pages were empty.
BR2_PACKAGE_SYSTEMD_LOCALED=y
# Screen brightness survives a reboot: systemd-backlight saves each backlight's
# level at shutdown (/var/lib/systemd/backlight, on the data partition) and
# restores it at boot; without it laptops started at the firmware's dim default.
BR2_PACKAGE_SYSTEMD_BACKLIGHT=y
BR2_PACKAGE_ACCOUNTSSERVICE=y
# "Launch using discrete graphics" (launcher, dock, app library, store) asks
# switcheroo-control (our package) which GPUs there are: hybrid laptops. Its
# unit is WantedBy=graphical.target and not D-Bus activatable; we boot to
# multi-user.target, so the overlay enables it there.
BR2_PACKAGE_SWITCHEROO_CONTROL=y
# VPNs in the network settings (OpenVPN; WireGuard is built into
# NetworkManager, and `wg` comes from server.config) and mobile broadband modems.
BR2_PACKAGE_OPENVPN=y
BR2_PACKAGE_NETWORK_MANAGER_OPENVPN=y
BR2_PACKAGE_NETWORK_MANAGER_MODEM_MANAGER=y
# Printers: driverless USB printers/scanners through ipp-usb (our package; they
# appear to CUPS and SANE like network ones), and drivers for older printers
# that aren't driverless: Gutenprint (Canon, Epson, …) and HPLIP (HP).
BR2_PACKAGE_IPP_USB=y
BR2_PACKAGE_GUTENPRINT=y
# hplip-pengyos, not hplip: the fork is what ships. The stock symbol is
# switched off explicitly so nothing can bring 3.17.10 back beside it.
# divergence.toml -> hplip-3.26.4-fork.
BR2_PACKAGE_HPLIP=n
BR2_PACKAGE_HPLIP_PENGYOS=y
# Chinese, Japanese and Korean text (our package: Noto Sans CJK, variable).
BR2_PACKAGE_FONT_NOTO_CJK=y
# Thumbnails in COSMIC Files for videos (ffmpegthumbnailer, our package) and
# PDFs (poppler's pdftocairo; overlay /usr/share/thumbnailers).
BR2_PACKAGE_FFMPEGTHUMBNAILER=y
BR2_PACKAGE_POPPLER=y
BR2_PACKAGE_POPPLER_UTILS=y
# Bluetooth audio codecs beyond SBC/Opus: AAC (fdk-aac: Apple and most
# headphones), aptX/aptX HD (libfreeaptx) and LDAC (ldacbt: Sony) -- our
# packages, wired into PipeWire in external.mk -- and LC3 (LE Audio).
BR2_PACKAGE_FDK_AAC=y
BR2_PACKAGE_LIBLC3=y
BR2_PACKAGE_LIBFREEAPTX=y
BR2_PACKAGE_LDACBT=y
# gpg's passphrase prompt in terminals (gnupg2 is in the image).
BR2_PACKAGE_PINENTRY=y
BR2_PACKAGE_PINENTRY_NCURSES=y

# ############################################################################
# ## layer: nvidia-compute
# ############################################################################

# ============================================================================
# PengyOS NVIDIA compute layer — the opt-in proprietary driver, headless half
# ----------------------------------------------------------------------------
# Stacked on core + server for the Server NVIDIA edition, and under the nvidia
# (graphics) layer for the Desktop NVIDIA. Never part of a default image.
#
# The driver is our nvidia-open package: NVIDIA's open GPU kernel modules plus
# the matching proprietary userspace, both from one .run (Turing / RTX 20 and
# newer — the fleet is RTX 30 + RTX 50). Here it is the compute half only:
# kernel modules, GSP firmware, CUDA, NVML (nvidia-smi), NVENC/NVDEC, MPS.
# Buildroot's own nvidia-driver package is the legacy 390 branch: it stops at
# Pascal and does not build on our kernel.
# ============================================================================

BR2_PACKAGE_NVIDIA_OPEN=y
# A headless GPU keeps its state between CUDA jobs (the nvidia layer turns this
# back off: it would keep a laptop's dGPU powered).
# BR2_PACKAGE_NVIDIA_OPEN_PERSISTENCED: set by the nvidia layer

# GPUs in containers: nvidia-ctk writes a CDI spec when the driver loads, and
# podman shares the GPUs with `--device nvidia.com/gpu=all` (llama.cpp and
# friends as quadlets). distrobox --nvidia (the cuda dev box) works without it.
BR2_PACKAGE_NVIDIA_CONTAINER_TOOLKIT=y

# The driver's compute userspace + GSP firmware add ~350 MB to the Server.
# BR2_TARGET_ROOTFS_EXT2_SIZE: set by the nvidia layer

# ############################################################################
# ## layer: nvidia
# ############################################################################

# ============================================================================
# PengyOS Desktop NVIDIA layer — the driver's graphics half (Tier-2)
# ----------------------------------------------------------------------------
# Stacked on core + server + desktop + nvidia-compute (which selects the driver
# itself: nvidia-open, CUDA, the container toolkit). Never part of the default
# Desktop. This layer adds what a Wayland desktop needs from it.
#
# Host Vulkan is on: NVIDIA ships its Vulkan ICD inside libGLX_nvidia, which
# links the X.org client libraries; the Desktop layer has those for Xwayland.
# Without it the loader found only lavapipe, and COSMIC's apps (wgpu) rendered
# on the CPU. Flatpak apps (Steam) still get NVIDIA Vulkan/GL from the Flathub
# GL extension that matches this driver version.
# ============================================================================

# libEGL_nvidia and libGLX_nvidia are glvnd vendor libraries; the Desktop layer
# already builds Mesa as a glvnd vendor (libEGL_mesa, libGLX_mesa), so both
# GPUs' EGL/GLX coexist behind one libEGL/libGL.
BR2_PACKAGE_NVIDIA_OPEN_GRAPHICS=y
BR2_PACKAGE_NVIDIA_OPEN_VULKAN=y
# The display keeps the driver initialized; persistence would also keep a
# laptop's dGPU from powering down.
# BR2_PACKAGE_NVIDIA_OPEN_PERSISTENCED is not set

# The driver's userspace + GSP firmware add ~600 MB to the Desktop.
BR2_TARGET_ROOTFS_EXT2_SIZE="4600M"
