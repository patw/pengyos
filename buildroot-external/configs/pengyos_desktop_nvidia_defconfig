# --- Out of memory: earlyoom --------------------------------------------------
# With swap on zram (core layer), a runaway app would otherwise grind the
# desktop until the kernel's OOM killer acts, minutes later. earlyoom acts
# first (config: overlay /etc/default/earlyoom). Not systemd-oomd: it kills
# whole cgroups, and the COSMIC session is one service cgroup, so it would
# kill the whole desktop.
BR2_PACKAGE_EARLYOOM=y

# --- Intel laptop audio: SOF firmware (kernel driver in linux.fragment) --------
BR2_PACKAGE_SOF_FIRMWARE=y


# --- Login screen and the desktop user's session (greetd, PAM + logind) --------
# greetd (our package) runs COSMIC's greeter at boot (overlay greetd.service);
# the password it takes opens the user's session through PAM (pengyos-session),
# and pam_systemd makes it a real logind session on seat0 — /run/user/UID, the user's systemd manager
# (PipeWire), polkit's "active session" (NetworkManager, Settings, Flatpak), and
# loginctl lock-session. PAM + logind themselves come from the Server layer.
# The user is in wheel: sudo (Server layer) + a polkit admin rule (overlay)
# make it the admin.
# The `seat` group seatd grants its socket to (seatd -g seat), so the desktop
# user can run the compositor; the users table also adds the greeter's user.
# Automatic login is opt-in (installer, `pengyos-autologin`), as on Ubuntu.
BR2_PACKAGE_GREETD=y
# File modes set under fakeroot (board/desktop/permissions.txt) on top of the
# Server layer's table; like the users tables, not an accumulating list.
BR2_ROOTFS_DEVICE_TABLE="system/device_table.txt $(BR2_EXTERNAL_PENGYOS_PATH)/board/server/permissions.txt $(BR2_EXTERNAL_PENGYOS_PATH)/board/desktop/permissions.txt"
# Not an accumulating list (compose-defconfigs.py): name Core's table too.
BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_PENGYOS_PATH)/board/core/users.table $(BR2_EXTERNAL_PENGYOS_PATH)/board/desktop/users.table"

# --- Full hardware control (desktop) -------------------------------------------
# Hardware video decode/encode: VA-API with Intel's iHD driver (Broadwell and
# newer, incl. the N100's Gen12 GPU) and Mesa's Gallium VA for AMD (radeonsi);
# `vainfo` to check it.
BR2_PACKAGE_INTEL_MEDIADRIVER=y
BR2_PACKAGE_MESA3D_GALLIUM_VA=y
BR2_PACKAGE_LIBVA_UTILS=y
# Thermal management for Intel (DPTF-aware; matters on fanless boxes) and power
# profiles for COSMIC's power menu / Settings → Power (our package: Buildroot has
# none). powerprofilesctl needs PyGObject. thermald-pengyos is stock thermald
# linked against upower-pengyos (the stock recipe selects stock upower).
BR2_PACKAGE_THERMALD=n
BR2_PACKAGE_THERMALD_PENGYOS=y
BR2_PACKAGE_POWER_PROFILES_DAEMON=y
BR2_PACKAGE_PYTHON_GOBJECT=y
# Firmware updates from LVFS (UEFI capsules incl. the system firmware, SSDs,
# docks, …). fwupd-efi is the capsule loader it stages on the ESP (/efi).
BR2_PACKAGE_FWUPD=y
BR2_PACKAGE_FWUPD_EFI=y
# fwupd-efi's build runs host `uswid`, which imports lzma; Buildroot's recipe
# does not pull the host Python's xz support in ("No module named '_lzma'").
BR2_PACKAGE_HOST_PYTHON3_XZ=y
# The TPM 2.0 userspace (disk health, smartmontools + nvme-cli: server.config).
# With tpm2-tss present systemd is built with TPM2 support, and its
# systemd-tpm2-generator makes early boot WAIT (90 s) for /dev/tpmrm0 whenever it
# believes the firmware has a TPM but no driver is bound yet — on a VM or a board
# whose firmware reports a TPM that never appears, every boot stalled 90 s behind
# the splash. Nothing here needs the TPM during early boot (no TPM-bound disk
# unlock), so the overlay masks the generator
# (etc/systemd/system-generators/systemd-tpm2-generator -> /dev/null).
BR2_PACKAGE_TPM2_TSS=y
BR2_PACKAGE_TPM2_TOOLS=y
# Removable media: UDisks2 (what COSMIC Files mounts drives through, via GIO/gvfs;
# also fwupd's ESP discovery) and gvfs (its UDisks2 volume monitor is enabled by
# the gvfs recipe when UDisks is on). Neither was installed, so plugging in a
# drive did nothing. Plus the tools to check/format the filesystems the kernel
# now mounts (linux.fragment).
BR2_PACKAGE_UDISKS=y
# glibc's UTF-16/UTF-32 converters are gconv modules, and the image had none
# (only glibc's built-in charsets): iconv_open("UTF-16LE", "UTF-8") failed, so
# UDisks/libblockdev refused every exFAT label ("must be a valid UTF-8 string",
# its g_convert to UTF-16 failing) after it had already rewritten the partition
# table. Found testing Disks (tools/pengyos-disks). Just the Unicode modules
# (92 KB); the legacy codepages (8.3 MB in all) are not copied.
BR2_TOOLCHAIN_GLIBC_GCONV_LIBS_COPY=y
BR2_TOOLCHAIN_GLIBC_GCONV_LIBS_LIST="UTF-16 UTF-32 UTF-7 UNICODE"
