# upower-pengyos, not upower: the fork is what ships (stock 0.99.19 stops updating
# the battery after suspend). The stock symbol is off, and thermald below is the
# fork too, because stock thermald selects stock upower.
# divergence.toml -> upower-1.91.5-fork.
BR2_PACKAGE_UPOWER=n
BR2_PACKAGE_UPOWER_PENGYOS=y
BR2_PACKAGE_LM_SENSORS=y
BR2_PACKAGE_ALSA_LIB=y
