menu "PengyOS (external tree)"

	# The libraries a manylinux wheel may assume the host provides (PEP 600 /
	# auditwheel policy) and so never bundles: libGL.so.1 and the X11 client
	# libraries. libglvnd builds libGL/libEGL only when a GL driver selects its
	# dispatch symbols (Mesa does on the Desktop); a headless Server has no GL
	# driver, so this selects them itself. Selecting them as well as Mesa is
	# what Mesa does anyway, so the Desktop is unchanged. layers/server.config.
	config BR2_PENGYOS_MANYLINUX_LIBS
		bool "libraries manylinux Python wheels expect from the host"
		depends on BR2_PACKAGE_XORG7
		depends on BR2_TOOLCHAIN_HAS_SYNC_4 && BR2_TOOLCHAIN_HAS_THREADS && !BR2_STATIC_LIBS
		select BR2_PACKAGE_LIBGLVND
		select BR2_PACKAGE_LIBGLVND_DISPATCH_GL
		select BR2_PACKAGE_LIBGLVND_DISPATCH_EGL
		select BR2_PACKAGE_XLIB_LIBX11
		select BR2_PACKAGE_XLIB_LIBXEXT
		select BR2_PACKAGE_XLIB_LIBXRENDER
		select BR2_PACKAGE_XLIB_LIBSM
		select BR2_PACKAGE_XLIB_LIBICE

	# COSMIC native (non-Rust) dependencies Buildroot 2026.08 does not ship.
	# Emitted by pengyos-cosmic-native-deps (committed under that tool) and
	# installed here so the Desktop target's `BR2_PACKAGE_*` symbols resolve.
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/greetd/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/xdg-desktop-portal/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/cosmic-portal/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/xdg-desktop-portal-gtk/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/dconf/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/font-fira/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/font-noto-color-emoji/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/font-noto-symbols2/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/font-symbols-nerd/Config.in"

	# Desktop hardware control Buildroot 2026.08 does not ship.
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/power-profiles-daemon/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/libmtp/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/ddcutil/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/bolt/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/distrobox/Config.in"
	# Server comfort shell (US-SRV-1): the interactive pieces the comfort
	# profile wires — fzf (Ctrl-R), the starship prompt, and the two zsh
	# plugins that give a plain zsh the oh-my-zsh feel. Buildroot 2026.08
	# ships none of them.
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/fzf/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/starship/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/zsh-autosuggestions/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/zsh-syntax-highlighting/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/xdg-utils/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/xdg-user-dirs/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/oo7/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/pop-cursor-theme/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/zram-generator/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/sof-firmware/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/steam-devices/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/gamemode/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/accountsservice/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/switcheroo-control/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/ipp-usb/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/rtkit/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/geoclue/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/libfreeaptx/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/ldacbt/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/ffmpegthumbnailer/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/font-noto-cjk/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/plymouth/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/cosmic-sound-theme/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/libnotify/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/libqalculate/Config.in"
	# Core userland: our own recipe for uutils/coreutils, the Rust coreutils
	# (SPEC §2.1). Buildroot 2026.08 ships no uutils recipe at all, so the
	# Core layer's coreutils is ours: package/uutils-coreutils.
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/uutils-coreutils/Config.in"
	# ... and uutils/findutils (find, xargs, locate, updatedb), also ours.
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/uutils-findutils/Config.in"
	# sudo-rs, the Rust sudo (Server): Buildroot 2026.08 has only the C sudo.
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/sudo-rs/Config.in"

	# SSH: our fork of Buildroot's openssh, pinned at 10.6p1. It replaces the
	# stock package in every edition, so the stock symbol is switched off in
	# configs/layers/core.config. divergence.toml -> openssh-10.6p1-fork carries
	# the reason and the expiry that ends it.
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/openssh-pengyos/Config.in"

	# Media: our fork of Buildroot's ffmpeg, pinned at 9.0.2 (25 P0/P1 CVE
	# matches sit in 6.1.5 and seventeen name no upstream commit). ffmpeg is a
	# library, so the plugins that link it are redirected to the fork too:
	# gst1-libav-pengyos below, plus pipewire and our ffmpegthumbnailer.
	# divergence.toml -> ffmpeg-9.0.2-fork.
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/ffmpeg-pengyos/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/gst1-libav-pengyos/Config.in"

	# Printing: our fork of Buildroot's hplip, pinned at 3.26.4 (9 P1 CVE matches
	# sit in 3.17.10 from 2018 and NVD names no fix commit for any of them).
	# divergence.toml -> hplip-3.26.4-fork.
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/hplip-pengyos/Config.in"

	# Power: our fork of Buildroot's upower, pinned at 1.91.5 (Buildroot pins
	# 0.99.19 and has not touched the recipe since 2022; 0.99.19's battery
	# reading freezes after suspend). thermald links libupower-glib and selects
	# the stock symbol, so it is rebuilt against the fork.
	# divergence.toml -> upower-1.91.5-fork.
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/upower-pengyos/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/thermald-pengyos/Config.in"
	# libdisplay-info pinned BELOW Buildroot's 0.4.0: cosmic-comp links
	# libdisplay-info.so.3 and its crate rejects 0.4. Replaces the build
	# host's Ubuntu copy. divergence.toml -> libdisplay-info-0.3.0-fork.
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/libdisplay-info-pengyos/Config.in"

	# Flatpak (the Desktop's app lane) and the two libraries it needs that
	# Buildroot 2026.08 does not ship. Built here instead of copied from the
	# build host.
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/libfyaml/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/appstream/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/flatpak/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/desktop-file-utils-target/Config.in"

	# Pengy, the built-in agent (CLI: Core, web: Server, Qt6 app: Desktop).
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/pengy/Config.in"
	# mdit, the Markdown editor (Qt6, ours).
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/mdit/Config.in"
	# Qt apps (Pengy) themed by COSMIC (dark/light, accent, fonts, icons).
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/cutecosmic/Config.in"

	# NVIDIA editions only: the proprietary driver on the open kernel modules
	# (Buildroot's nvidia-driver is the legacy 390 branch — no Turing+, no GBM).
	# and the CDI half of the container toolkit (GPUs in podman containers).
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/nvidia-open/Config.in"
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/nvidia-container-toolkit/Config.in"

	# Audio: ALSA UCM configuration (Buildroot has none). Without it PipeWire
	# only exposes a generic Analog profile — no HDMI/Display sinks.
	source "$BR2_EXTERNAL_PENGYOS_PATH/package/alsa-ucm-conf/Config.in"

	# COSMIC cargo recipes (pengyos-cosmic-pkg / -recipes) are emitted here next;
	# their `source` lines are added once the vendored digests are pinned.

endmenu
