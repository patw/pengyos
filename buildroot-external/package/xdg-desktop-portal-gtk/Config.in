config BR2_PACKAGE_XDG_DESKTOP_PORTAL_GTK
	bool "xdg-desktop-portal-gtk"
	depends on BR2_PACKAGE_XDG_DESKTOP_PORTAL
	depends on BR2_PACKAGE_LIBGTK3
	select BR2_PACKAGE_FONTCONFIG
	select BR2_PACKAGE_GSETTINGS_DESKTOP_SCHEMAS
	help
	  The GTK portal backend: the portals COSMIC's own backend
	  does not implement, as Pop!_OS ships it. AppChooser (without
	  it xdg-desktop-portal does not offer OpenURI, so Flatpak
	  apps cannot open links or files in another app), Print,
	  Notification, Inhibit, Email, DynamicLauncher, Account,
	  Lockdown, and Settings for the org.gnome.* gsettings keys
	  (a Flatpak GTK app's titlebar buttons come from
	  org.gnome.desktop.wm.preferences button-layout). COSMIC's
	  backend still answers FileChooser, Screenshot, ScreenCast,
	  and Settings for org.freedesktop.appearance (portals.conf).

	  https://github.com/flatpak/xdg-desktop-portal-gtk
