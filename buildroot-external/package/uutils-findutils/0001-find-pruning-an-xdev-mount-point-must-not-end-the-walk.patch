 #[test]
+#[cfg(target_os = "linux")]
+fn find_xdev_prune_mount_point_keeps_siblings() {
+    // Pruning a directory -xdev does not enter (a mount point) must not end
+    // the walk of its siblings. /proc is a mount point under / on Linux.
+    use std::os::unix::fs::MetadataExt;
+    let (Ok(root), Ok(proc_)) = (std::fs::metadata("/"), std::fs::metadata("/proc")) else {
+        return;
+    };
+    if root.dev() == proc_.dev() {
+        return;
+    }
+    let all = std::fs::read_dir("/").unwrap().count();
+    let out = ucmd()
+        .args(&["/", "-maxdepth", "1", "-xdev", "-path", "/proc", "-prune", "-o", "-print"])
+        .run();
+    // "/" itself plus every top-level entry except /proc.
+    assert_eq!(out.stdout_str().lines().count(), all, "{}", out.stdout_str());
+}
