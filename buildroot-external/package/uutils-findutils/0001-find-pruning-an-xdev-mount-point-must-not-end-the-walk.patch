+#[cfg(unix)]
+fn descends(entry: &WalkEntry, root_dev: Option<u64>) -> bool {
+    use std::os::unix::fs::MetadataExt;
+    match root_dev {
+        Some(dev) if entry.depth() > 0 => entry.metadata().map_or(true, |m| m.dev() == dev),
+        _ => true,
+    }
+}
