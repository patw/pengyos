config BR2_PACKAGE_GEOCLUE
	bool "geoclue"
	depends on BR2_PACKAGE_SYSTEMD
	depends on BR2_USE_WCHAR # libglib2
	depends on BR2_TOOLCHAIN_HAS_THREADS # libglib2
	depends on BR2_USE_MMU # libglib2
	select BR2_PACKAGE_LIBGLIB2
	select BR2_PACKAGE_JSON_GLIB
	select BR2_PACKAGE_LIBSOUP3
	select BR2_PACKAGE_LIBNOTIFY # demo agent
	help
	  GeoClue 2 (org.freedesktop.GeoClue2): the location service
	  behind xdg-desktop-portal's Location portal. Wi-Fi networks
	  in range are looked up in BeaconDB (upstream's default since
	  Mozilla Location Service closed); a modem's GPS/cell data is
	  used when ModemManager is in the image.

	  https://gitlab.freedesktop.org/geoclue/geoclue/-/wikis/home
