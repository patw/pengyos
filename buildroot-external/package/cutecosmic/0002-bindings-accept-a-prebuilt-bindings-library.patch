From: Pat Wendorf <dungeons@gmail.com>
Subject: [PATCH] bindings: accept a prebuilt bindings library

The Rust bindings are built through Corrosion, fetched with FetchContent
at configure time. A distribution build is offline and already builds
Rust crates itself: let it pass in the staticlib, the directory with the
cbindgen header, and the native link libraries instead.

Upstream: not submitted
---
--- a/bindings/CMakeLists.txt
+++ b/bindings/CMakeLists.txt
@@ -1,3 +1,17 @@
+# A distribution build can compile the Rust bindings itself (cargo, offline,
+# vendored) and hand the result in: CUTECOSMIC_BINDINGS_LIB = the staticlib,
+# CUTECOSMIC_BINDINGS_INCLUDE_DIR = the directory holding the cbindgen
+# bindings.h, CUTECOSMIC_BINDINGS_LINK_LIBS = its native link libraries.
+if(CUTECOSMIC_BINDINGS_LIB)
+    add_library(bindings STATIC IMPORTED GLOBAL)
+    set_target_properties(bindings PROPERTIES
+        IMPORTED_LOCATION "${CUTECOSMIC_BINDINGS_LIB}"
+        INTERFACE_INCLUDE_DIRECTORIES "${CUTECOSMIC_BINDINGS_INCLUDE_DIR}"
+        INTERFACE_LINK_LIBRARIES "${CUTECOSMIC_BINDINGS_LINK_LIBS}"
+    )
+    return()
+endif()
+
 find_package(Corrosion QUIET)
 if(NOT Corrosion_FOUND)
     include(FetchContent)
