config BR2_PACKAGE_THERMALD_PENGYOS
	bool "thermald-pengyos (thermald against upower-pengyos)"
	depends on BR2_i386 || BR2_x86_64 # needs <cpuid.h>
	depends on BR2_USE_MMU # uses fork()
	depends on BR2_USE_WCHAR # upower -> libgudev
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS # dbus-glib -> glib2, dbus, upower
	depends on BR2_USE_WCHAR # dbus-glib -> glib2
	depends on BR2_PACKAGE_HAS_UDEV # upower
	select BR2_PACKAGE_DBUS
	select BR2_PACKAGE_DBUS_GLIB
	select BR2_PACKAGE_LIBEVDEV
	select BR2_PACKAGE_LIBXML2
	select BR2_PACKAGE_UPOWER_PENGYOS
	select BR2_PACKAGE_XZ
	help
	  Stock thermald, rebuilt to link upower-pengyos. The stock
	  recipe selects BR2_PACKAGE_UPOWER, which would build the
	  stock upower beside the fork. Same version as Buildroot's.
	  See divergence.toml: upower-1.91.5-fork.

	  Say no to thermald (BR2_PACKAGE_THERMALD) when you say yes
	  to this.

	  Thermal Daemon is a Linux daemon for monitoring and
	  controlling platform temperatures. Once the system temperature
	  reaches a certain threshold, the Linux daemon activates
	  various cooling methods to try to cool the system.

	  https://github.com/intel/thermal_daemon

comment "thermald-pengyos needs a toolchain w/ C++, wchar, threads"
	depends on BR2_i386 || BR2_x86_64
	depends on BR2_USE_MMU
	depends on !BR2_USE_WCHAR || !BR2_TOOLCHAIN_HAS_THREADS || \
		!BR2_INSTALL_LIBSTDCPP

comment "thermald-pengyos needs udev /dev management"
	depends on BR2_i386 || BR2_x86_64
	depends on BR2_USE_MMU
	depends on !BR2_PACKAGE_HAS_UDEV
