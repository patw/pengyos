################################################################################
#
# cosmic
#
################################################################################
#
# The COSMIC desktop as ONE package: every component in scripts/cosmic-components.tsv,
# built in one cargo target dir so libcosmic, iced and wgpu compile once for the set
# (25 packages would each compile their own copy). Until 2026-10-28 this was
# scripts/build-cosmic.sh on the build host, copied in by board/desktop/post-build.sh.
#
# Sources: cosmic-sources.inc, generated by scripts/cosmic-recipe.py - the pinned
# commits as GitHub archives, hashed in cosmic.hash, and a version that is a digest
# of everything else the build reads (the libcosmic pin, scripts/cosmic-locks,
# board/desktop/cosmic-patches), so changing any of them rebuilds.
#
# Dependencies: each component builds --locked against scripts/cosmic-locks, so every
# crates.io crate is checked against the lock's sha256 and every git dependency is
# pinned to a commit. Buildroot's cargo infrastructure vendors at download time, before
# patches, which cannot carry the libcosmic coherence pin; so cargo fetches here, into
# Buildroot's shared cargo home (DL_DIR/br-cargo-home). A build of this package needs
# the network the first time; `make source` does not prefetch the crates.
#
# One host dependency remains: bindgen (pam-sys, pipewire-sys, libspa-sys) loads
# libclang, and Buildroot builds no host clang. It comes from the build host
# (LIBCLANG_PATH); it only parses the sysroot's headers, so the bindings it generates
# depend on the sysroot, not on the host.

include $(BR2_EXTERNAL_PENGYOS_PATH)/package/cosmic/cosmic-sources.inc

# legal-info writes this inside single quotes: no apostrophe.
COSMIC_LICENSE = GPL-3.0-only (COSMIC components), MPL-2.0 (libcosmic), vendored crates under their own licenses (not listed)
COSMIC_LICENSE_FILES = cosmic-comp/LICENSE
# Buildroot extracts nothing itself: every archive goes to $(@D)/<component>.
COSMIC_SRCDIR = $(@D)
COSMIC_DEPENDENCIES = \
	host-pkgconf host-rustc \
	dav1d dbus flatpak gst1-plugins-base gstreamer1 libdisplay-info-pengyos \
	libglib2 libinput libxkbcommon linux-pam mesa3d pipewire pixman seatd systemd

COSMIC_TARGET = $(@D)/target
COSMIC_RELEASE = $(COSMIC_TARGET)/$(RUSTC_TARGET_NAME)/release
COSMIC_LIBCOSMIC_REV = $(shell grep -vE '^[[:space:]]*\#' \
	$(BR2_EXTERNAL_PENGYOS_PATH)/../scripts/cosmic-libcosmic.pin \
	| grep -oE '\b[0-9a-f]{7,40}\b' | head -1)
COSMIC_SCRIPTS = $(BR2_EXTERNAL_PENGYOS_PATH)/../scripts
COSMIC_PATCHES = $(BR2_EXTERNAL_PENGYOS_PATH)/board/desktop/cosmic-patches

define COSMIC_EXTRACT_CMDS
	$(foreach c,$(COSMIC_COMPONENTS),
		mkdir -p $(@D)/$(c)
		$(call suitable-extractor,$(c)-$(COSMIC_COMMIT_$(c)).tar.gz) \
			$(COSMIC_DL_DIR)/$(c)-$(COSMIC_COMMIT_$(c)).tar.gz | \
			$(TAR) --strip-components=1 -C $(@D)/$(c) $(TAR_OPTIONS) -
	)
endef

# The carried COSMIC patches are per component (board/desktop/cosmic-patches/<c>/),
# so they are applied inside each component, not by Buildroot's patch step.
define COSMIC_APPLY_COMPONENT_PATCHES
	$(foreach c,$(COSMIC_COMPONENTS),
		for p in $(sort $(wildcard $(COSMIC_PATCHES)/$(c)/*.patch)); do \
			$(APPLY_PATCHES) $(@D)/$(c) $$(dirname $$p) $$(basename $$p) || exit 1; \
		done
	)
endef
COSMIC_POST_PATCH_HOOKS += COSMIC_APPLY_COMPONENT_PATCHES

# The pin reads the component's own lock (upstream's, as --relock read it) to learn
# which crates come out of libcosmic; then the committed lock replaces it.
define COSMIC_CONFIGURE_CMDS
	$(foreach c,$(COSMIC_CARGO_COMPONENTS),
		python3 $(COSMIC_SCRIPTS)/cosmic-libcosmic-pin.py $(@D)/$(c) $(COSMIC_LIBCOSMIC_REV)
		cp -f $(COSMIC_SCRIPTS)/cosmic-locks/$(c).Cargo.lock $(@D)/$(c)/Cargo.lock
	)
	$(COSMIC_WRITE_PKG_CONFIG)
endef

# Some -sys crates build their C library inside the cargo target dir and find it
# through the .pc file they write there (cosmic-viewer's libheif-sys, which links
# libheif statically, as upstream ships it). Buildroot's pkg-config prefixes every
# path with the staging sysroot, which is wrong for those; this wrapper undoes the
# prefix for paths inside the target dir only.
COSMIC_PKG_CONFIG = $(@D)/pkg-config
define COSMIC_WRITE_PKG_CONFIG
	printf '%s\n' '#!/bin/sh' \
		'out=$$(PKG_CONFIG_SYSROOT_DIR=$(STAGING_DIR) "$(PKG_CONFIG_HOST_BINARY)" "$$@") || exit $$?' \
		'[ -n "$$out" ] || exit 0' \
		'printf "%s\n" "$$out" | sed "s|$(STAGING_DIR)$(COSMIC_TARGET)|$(COSMIC_TARGET)|g"' \
		> $(COSMIC_PKG_CONFIG)
	chmod 0755 $(COSMIC_PKG_CONFIG)
endef

# Buildroot's cargo env overrides every crate's release profile (LTO off, opt-level
# from BR2_OPTIMIZE, 16 codegen units). The binaries this replaces were built with
# upstream's profiles (cosmic-comp: lto = "fat"), so those three are left to the
# components. The cargo() wrapper adds --locked to each command of a `&&` list (the
# cosmic-files row builds the app and the applet as two invocations, on purpose).
define COSMIC_BUILD_CMDS
	$(foreach c,$(COSMIC_CARGO_COMPONENTS),
		cd $(@D)/$(c) && \
		$(TARGET_MAKE_ENV) $(TARGET_CONFIGURE_OPTS) $(PKG_CARGO_ENV) \
		CARGO_TARGET_DIR=$(COSMIC_TARGET) PKG_CONFIG=$(COSMIC_PKG_CONFIG) \
		LIBCLANG_PATH="$(COSMIC_LIBCLANG_PATH)" \
		BINDGEN_EXTRA_CLANG_ARGS="--sysroot=$(STAGING_DIR) --target=$(RUSTC_TARGET_NAME)" \
		VERGEN_GIT_SHA=$(COSMIC_COMMIT_$(c)) VERGEN_GIT_COMMIT_DATE=$(COSMIC_DATE_$(c)) \
		env -u CARGO_PROFILE_RELEASE_LTO -u CARGO_PROFILE_RELEASE_OPT_LEVEL \
			-u CARGO_PROFILE_RELEASE_CODEGEN_UNITS \
		sh -ec 'cargo() { command cargo "$$@" --locked; }; eval "cargo $$1"' \
			cargo-locked "$(COSMIC_CARGO_ARGS_$(c))"
		python3 $(COSMIC_SCRIPTS)/cosmic-libcosmic-pin.py --verify $(@D)/$(c) \
			$(COSMIC_LIBCOSMIC_REV)
	)
	$(COSMIC_CHECK_FILES_FEATURES)
endef

# cosmic-files and cosmic-files-applet are one workspace; built in one invocation,
# the app binary gets the applet's desktop-applet code and draws a second file view
# on the wallpaper (reproduced 2026-10-06). Moved here from build-cosmic.sh.
define COSMIC_CHECK_FILES_FEATURES
	if grep -aq "already had surface ID" $(COSMIC_RELEASE)/cosmic-files; then \
		echo "cosmic: cosmic-files was built WITH desktop-applet (see the TSV)" >&2; \
		exit 1; \
	fi
	grep -aq "already had surface ID" $(COSMIC_RELEASE)/cosmic-files-applet || { \
		echo "cosmic: cosmic-files-applet is missing desktop-applet" >&2; exit 1; }
endef

# bindgen's libclang: the newest LLVM the build host has (see the header).
COSMIC_LIBCLANG_PATH = $(firstword $(shell ls -d /usr/lib/llvm-*/lib 2>/dev/null | sort -V -r))

# The binaries the session runs. post-build.sh still installs each component's
# data (schemas, icons, desktop files, pop-launcher's plugins) from $(@D) - it finds
# this package's build dir through BR2_PACKAGE_COSMIC and COSMIC_VERSION.
COSMIC_BINARIES = \
	cosmic-comp cosmic-session cosmic-panel cosmic-panel-button cosmic-launcher \
	cosmic-applets cosmic-settings cosmic-settings-daemon cosmic-notifications \
	cosmic-osd cosmic-osk cosmic-idle cosmic-bg cosmic-randr cosmic-screenshot \
	cosmic-term cosmic-files cosmic-edit cosmic-store cosmic-player \
	cosmic-app-library cosmic-workspaces cosmic-viewer cosmic-greeter cosmic-monitor \
	cosmic-files-applet cosmic-greeter-daemon

define COSMIC_INSTALL_TARGET_CMDS
	$(foreach b,$(COSMIC_BINARIES),
		$(INSTALL) -D -m 0755 $(COSMIC_RELEASE)/$(b) $(TARGET_DIR)/usr/bin/$(b)
	)
	$(INSTALL) -D -m 0755 $(COSMIC_RELEASE)/pop-launcher-bin $(TARGET_DIR)/usr/bin/pop-launcher
endef

$(eval $(generic-package))
