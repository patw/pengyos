CONFIG_STATIC=y
CONFIG_BUSYBOX=y
CONFIG_FEATURE_INSTALLER=y
CONFIG_ASH=y
CONFIG_SH_IS_ASH=y
CONFIG_BASH_IS_NONE=y
CONFIG_ASH_ECHO=y
CONFIG_ASH_TEST=y
CONFIG_ASH_PRINTF=y
CONFIG_ASH_OPTIMIZE_FOR_SIZE=y
CONFIG_MOUNT=y
CONFIG_FEATURE_MOUNT_LOOP=y
CONFIG_FEATURE_MOUNT_LOOP_CREATE=y
CONFIG_FEATURE_MOUNT_FLAGS=y
CONFIG_UMOUNT=y
CONFIG_SWITCH_ROOT=y
CONFIG_MKDIR=y
CONFIG_CAT=y
CONFIG_LS=y
CONFIG_SED=y
CONFIG_SLEEP=y
CONFIG_FEATURE_FANCY_SLEEP=y
CONFIG_FEATURE_FLOAT_SLEEP=y
CONFIG_DMESG=y
CONFIG_LOSETUP=y
CONFIG_ECHO=y
CONFIG_TEST=y
CONFIG_FEATURE_TEST_64=y
# busybox's own crypt: allnoconfig leaves it off, and the system crypt means
# -lcrypt, which has no static library here ("cannot find -lcrypt").
CONFIG_USE_BB_CRYPT=y
