From: PengyOS <https://pengyos.catbee.ca>
Subject: [PATCH] Makefile.am: install-data-hook must respect DESTDIR

install-data-hook copies the prebuilt libImageProcessor shared objects, drops
the ipp-usb quirk file, and creates the sane/libhpmud symlinks using `$(libdir)`
and a hardcoded `/usr/share/ipp-usb/quirks/` - with no `$(DESTDIR)` prefix. The
sane.d lines a few lines below *do* use `$(DESTDIR)`, so the hook is internally
inconsistent; the paths without it are simply the host's own directories.

In a cross build that means the install step writes into the build host:

  cp: cannot create regular file '/usr/lib/libImageProcessor-x86_64.so': Permission denied
  chmod: cannot access '/usr/lib/libImageProcessor-x86_64.so': No such file or directory
  ln: failed to create symbolic link '/usr/lib/libImageProcessor.so': Permission denied
  cp: cannot create regular file '/usr/share/ipp-usb/quirks/HPLIP.conf': Permission denied
  make[4]: *** [Makefile:11391: install-data-hook] Error 1

and, where the host is writable, it would write into the *host's* /usr/lib
instead of the image - the files would be missing from the image and the host
would gain them. Both outcomes are wrong, and the second is the silent one.

Every `$(libdir)` in the hook and the ipp-usb path are prefixed with
`$(DESTDIR)`. Occurrences that already carried it are untouched.

Carried on our own recipe (divergence.toml -> hplip-3.26.6-fork).

--- a/Makefile.am
+++ b/Makefile.am
@@ -707,19 +707,19 @@
 
 install-data-hook:
 if HPLIP_BUILD
-	if [ \( "$(UNAME)" = "x86_64" -a  -d "$(libdir)/" \) ]; then \
-		cp prnt/hpcups/libImageProcessor-x86_64.so $(libdir)/ ; \
-		chmod 775 $(libdir)/libImageProcessor-x86_64.so ; \
-		ln -sf $(libdir)/libImageProcessor-x86_64.so $(libdir)/libImageProcessor.so ; \
+	if [ \( "$(UNAME)" = "x86_64" -a  -d "$(DESTDIR)$(libdir)/" \) ]; then \
+		cp prnt/hpcups/libImageProcessor-x86_64.so $(DESTDIR)$(libdir)/ ; \
+		chmod 775 $(DESTDIR)$(libdir)/libImageProcessor-x86_64.so ; \
+		ln -sf $(DESTDIR)$(libdir)/libImageProcessor-x86_64.so $(DESTDIR)$(libdir)/libImageProcessor.so ; \
 	fi; \
-	if [ \( \( "$(UNAME)" = "i686" -o "$(UNAME)" = "i386" \) -a -d "$(libdir)/" \) ]; then \
-		cp prnt/hpcups/libImageProcessor-x86_32.so $(libdir)/ ; \
-		chmod 775 $(libdir)/libImageProcessor-x86_32.so ; \
-		ln -sf $(libdir)/libImageProcessor-x86_32.so $(libdir)/libImageProcessor.so ; \
+	if [ \( \( "$(UNAME)" = "i686" -o "$(UNAME)" = "i386" \) -a -d "$(DESTDIR)$(libdir)/" \) ]; then \
+		cp prnt/hpcups/libImageProcessor-x86_32.so $(DESTDIR)$(libdir)/ ; \
+		chmod 775 $(DESTDIR)$(libdir)/libImageProcessor-x86_32.so ; \
+		ln -sf $(DESTDIR)$(libdir)/libImageProcessor-x86_32.so $(DESTDIR)$(libdir)/libImageProcessor.so ; \
 	fi
-	if [ -d "/usr/share/ipp-usb/quirks/" ]; then \
+	if [ -d "$(DESTDIR)/usr/share/ipp-usb/quirks/" ]; then \
 		echo "ipp-usb directory exists"; \
-		cp prnt/ipp-usb/HPLIP.conf /usr/share/ipp-usb/quirks/ ; \
+		cp prnt/ipp-usb/HPLIP.conf $(DESTDIR)/usr/share/ipp-usb/quirks/ ; \
 	fi
 if !HPLIP_CLASS_DRIVER
 #	   If scanner build, add hpaio entry to sane dll.conf.
@@ -732,15 +732,15 @@
 		  echo "Adding hpaio entry to /etc/sane.d/dll.conf." ; \
 		  echo hpaio >>$(DESTDIR)/etc/sane.d/dll.conf ; \
 	   fi; \
- 	   if [ \( "$(UNAME)" = "x86_64" -a  -d "$(libdir)/x86_64-linux-gnu/sane" \) ]; then \
-	  	ln -sf $(libdir)/sane/libsane-hpaio.so $(libdir)/x86_64-linux-gnu/sane/ ; \
-	  	ln -sf $(libdir)/sane/libsane-hpaio.so.1 $(libdir)/x86_64-linux-gnu/sane/ ; \
+ 	   if [ \( "$(UNAME)" = "x86_64" -a  -d "$(DESTDIR)$(libdir)/x86_64-linux-gnu/sane" \) ]; then \
+	  	ln -sf $(DESTDIR)$(libdir)/sane/libsane-hpaio.so $(DESTDIR)$(libdir)/x86_64-linux-gnu/sane/ ; \
+	  	ln -sf $(DESTDIR)$(libdir)/sane/libsane-hpaio.so.1 $(DESTDIR)$(libdir)/x86_64-linux-gnu/sane/ ; \
 	   fi; \
-	   if [ \( \( "$(UNAME)" = "i686" -o "$(UNAME)" = "i386" \) -a -d "$(libdir)/i386-linux-gnu" \) ]; then \
-	      ln -sf $(libdir)/libhpmud.so.0.0.6  $(libdir)/i386-linux-gnu/libhpmud.so ; \
-	      ln -sf $(libdir)/libhpmud.so.0.0.6  $(libdir)/i386-linux-gnu/libhpmud.so.0 ; \
-	      ln -sf $(libdir)/sane/libsane-hpaio.so.1.0.0 $(libdir)/i386-linux-gnu/sane/libsane-hpaio.so.1 ; \
-	      ln -sf $(libdir)/sane/libsane-hpaio.so.1.0.0 $(libdir)/i386-linux-gnu/sane/libsane-hpaio.so ; \
+	   if [ \( \( "$(UNAME)" = "i686" -o "$(UNAME)" = "i386" \) -a -d "$(DESTDIR)$(libdir)/i386-linux-gnu" \) ]; then \
+	      ln -sf $(DESTDIR)$(libdir)/libhpmud.so.0.0.6  $(DESTDIR)$(libdir)/i386-linux-gnu/libhpmud.so ; \
+	      ln -sf $(DESTDIR)$(libdir)/libhpmud.so.0.0.6  $(DESTDIR)$(libdir)/i386-linux-gnu/libhpmud.so.0 ; \
+	      ln -sf $(DESTDIR)$(libdir)/sane/libsane-hpaio.so.1.0.0 $(DESTDIR)$(libdir)/i386-linux-gnu/sane/libsane-hpaio.so.1 ; \
+	      ln -sf $(DESTDIR)$(libdir)/sane/libsane-hpaio.so.1.0.0 $(DESTDIR)$(libdir)/i386-linux-gnu/sane/libsane-hpaio.so ; \
 	   fi \
 	fi
 endif #HPLIP_CLASS_DRIVER
