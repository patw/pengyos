config BR2_PACKAGE_OPENSSH_PENGYOS
	bool "openssh-pengyos (fork of openssh)"
	depends on BR2_USE_MMU # fork()
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_ZLIB
	select BR2_PACKAGE_LIBXCRYPT if BR2_TOOLCHAIN_USES_GLIBC
	help
	  PengyOS's fork of OpenSSH, pinned at a version newer than the one
	  Buildroot ships. It exists because OpenSSH 10.5p1 (Buildroot 2026.08)
	  carries remote, unauthenticated sshd vulnerabilities that upstream
	  fixed in 10.6, and a br2-external tree cannot move a stock package's
	  version. See divergence.toml: openssh-10.6p1-fork.

	  Say no to openssh (BR2_PACKAGE_OPENSSH) when you say yes to this:
	  both install the same files, and the image must carry one sshd.

	  Client programs: ssh, scp, sftp, ssh-agent, ssh-add, ssh-copy-id.
	  Server programs: sshd, sshd-session, sshd-auth, sftp-server.
	  Key utilities: ssh-keygen, ssh-keyscan.

	  https://www.openssh.com/

if BR2_PACKAGE_OPENSSH_PENGYOS

config BR2_PACKAGE_OPENSSH_PENGYOS_CLIENT
	bool "client"
	default y
	help
	  Client programs: ssh, scp, sftp, ssh-agent, ssh-add,
	  ssh-copy-id.

config BR2_PACKAGE_OPENSSH_PENGYOS_SERVER
	bool "server"
	default y
	help
	  Server programs: sshd, sshd-session, sshd-auth, sftp-server,
	  and the sshd.service unit.

config BR2_PACKAGE_OPENSSH_PENGYOS_KEY_UTILS
	bool "key utilities"
	default y
	help
	  Key utilities: ssh-keygen, ssh-keyscan. sshd.service runs
	  `ssh-keygen -A` on first boot, so a server image needs these.

config BR2_PACKAGE_OPENSSH_PENGYOS_SANDBOX
	bool "use sandboxing"
	default y
	help
	  Use sandboxing for extra privilege protection of processes.

	  This is normally preferable, but may cause seccomp problems
	  for certain combinations of C libraries and kernel versions.
endif
