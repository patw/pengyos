#!/bin/sh
# Bring the graphical session target up, once the compositor exists.
#
# The portal units (xdg-desktop-portal, xdg-document-portal,
# xdg-permission-store, flatpak-portal, flatpak-session-helper, the gvfs daemons
# and at-spi-dbus-bus) are PartOf=graphical-session.target, and
# graphical-session.target refuses a manual start (RefuseManualStart=yes) — it is
# meant to be pulled in by the session's own target. cosmic-session expects a
# cosmic-session.target for exactly that and we did not ship one, so nothing ever
# started the chain: the portal ran only because something D-Bus-activated it on
# the session bus, and on the systemd user bus it failed outright
# ("Dependency failed for Portal service").
#
# Order matters. The COSMIC portal backend panics (exit 101) when it is activated
# without WAYLAND_DISPLAY, and xdg-desktop-portal then keeps that failure for the
# whole session: no screen sharing, remote desktop, screenshots or file chooser.
# So: wait for the compositor's socket, give the display to both environments,
# then start the target.
#
# Both, because the backend is not a systemd unit: its D-Bus service file has no
# SystemdService=, so dbus-daemon execs it with dbus-daemon's own activation
# environment, which `systemctl --user import-environment` never touches. Only
# importing into systemd left the backend without a display whenever something
# in the target (pengyos-rdp-server, when remote desktop is on) asked for the
# portal before cosmic-comp updated the activation environment itself, about
# half a second later. dbus-update-activation-environment --systemd sets both.
#
# start-cosmic runs this in the background; it must not race the compositor.
set -u

RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

sock=""
i=0
while [ "$i" -lt 120 ]; do
    for c in "$RUNTIME"/wayland-*; do
        if [ -S "$c" ]; then
            sock="$c"
            break
        fi
    done
    [ -n "$sock" ] && break
    sleep 0.5
    i=$((i + 1))
done

if [ -z "$sock" ]; then
    echo "session-target: no Wayland socket in ${RUNTIME} after 60s; leaving the session as it is" >&2
    exit 0
fi

WAYLAND_DISPLAY="${sock##*/}"
export WAYLAND_DISPLAY

dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP ||
    echo "session-target: could not give WAYLAND_DISPLAY to D-Bus activation and the user manager" >&2

if ! systemctl --user start cosmic-session.target; then
    echo "session-target: cosmic-session.target failed to start" >&2
    exit 1
fi

echo "session-target: graphical session up (${WAYLAND_DISPLAY})" >&2
