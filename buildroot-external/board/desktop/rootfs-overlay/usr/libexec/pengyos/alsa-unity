#!/bin/sh
# PengyOS Desktop: put each PCI sound card's master gain at unity (0 dB).
#
# WirePlumber drives PCI cards as plain ALSA PCMs (51-alsa-ucm.conf), so every
# output, HDMI included, is a sink of its own. On that path PipeWire only does
# software volume and nothing manages the codec's mixer, so its master gain
# stays wherever the chip powered up: -20 dB on a ThinkPad T14's ALC257, -23 dB
# on an N100's ALC897 (2026-10-04), and the speakers were quiet at 100%. Run
# after alsa-restore.service at every boot: the software slider is the only
# volume control, with the hardware at unity under it.
set -u
for card in /sys/class/sound/card[0-9]*; do
    [ -e "$card/device" ] || continue
    case "$(readlink -f "$card/device/subsystem")" in */bus/pci) ;; *) continue ;; esac
    n=${card##*card}
    for ctl in Master PCM; do
        amixer -c "$n" sget "$ctl" 2>/dev/null | grep -q 'dB' || continue
        amixer -q -c "$n" sset "$ctl" 0dB unmute 2>/dev/null ||
            amixer -q -c "$n" sset "$ctl" 0dB 2>/dev/null ||
            echo "alsa-unity: card $n: could not set $ctl" >&2
        echo "alsa-unity: card $n: $ctl $(amixer -c "$n" sget "$ctl" | grep -o '\[-\?[0-9.]*dB\]' | head -1)"
    done
done
exit 0
