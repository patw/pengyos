#!/bin/sh
# PengyOS Desktop: put each PCI sound card's master gain at unity (0 dB).
#
# Kept after the 2026-10-06 removal of the split-mode WirePlumber rule
# (51-alsa-ucm.conf). On that path PipeWire did software volume only and left the
# codec's hardware Master at its power-on level: -20 dB on a ThinkPad T14's
# ALC257, -23 dB on an N100's ALC897 (2026-10-04), so 100% in Settings was quiet.
# Under the stock ACP path we now use, PipeWire is expected to manage the mixer
# itself and this service may be redundant; it is retained until that is
# re-measured on a laptop. Runs after alsa-restore.service at every boot.
set -u
for card in /sys/class/sound/card[0-9]*; do
    [ -e "$card/device" ] || continue
    case "$(readlink -f "$card/device/subsystem")" in */bus/pci) ;; *) continue ;; esac
    n=${card##*card}
    for ctl in Master PCM; do
        amixer -c "$n" sget "$ctl" 2>/dev/null | grep -q 'dB' || continue
        amixer -q -c "$n" sset "$ctl" 0dB unmute 2>/dev/null ||
            amixer -q -c "$n" sset "$ctl" 0dB 2>/dev/null ||
            echo "alsa-unity: card $n: could not set $ctl" >&2
        echo "alsa-unity: card $n: $ctl $(amixer -c "$n" sget "$ctl" | grep -o '\[-\?[0-9.]*dB\]' | head -1)"
    done
done
exit 0
