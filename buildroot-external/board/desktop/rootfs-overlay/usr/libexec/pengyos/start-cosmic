#!/bin/sh
# Start a user's COSMIC session: what greetd runs once the greeter accepted a
# password, or at boot for automatic login (PAM service pengyos-session:
# pam_systemd has already made this a logind session on seat0 and started
# user@<uid>, whose bus is /run/user/<uid>/bus).
#
# - XDG_DATA_DIRS: Flatpak apps' exported .desktop files and icons first, the
#   user installation's before the system one's (what flatpak's own profile.d
#   and user environment generator do; neither reaches a greetd session). With
#   only the system folder, an app the Store installed per-user -- the only
#   choice it offers when Flathub is a user remote -- ran but appeared in no
#   menu (a laptop on 26.10.27, 2026-10-13). The user folders are created here
#   for the same reason tmpfiles creates the system ones: the panel scans icon
#   folders once, at startup.
# - PATH: greetd's session worker hands the session a minimal environment, so
#   PATH arrives as /usr/bin alone -- not the /usr/local/bin:/usr/bin a login
#   shell gets. A session started by a system service never sources profile.d
#   (same reason as XDG_DATA_DIRS above), and the comfort profile deliberately
#   returns early for non-interactive shells: the per-user bin dirs it adds
#   worked in a terminal and were missing from every GUI app, and from anything
#   an app forks. `uv`, `cargo`, `pip --user` and an agent harness's tools live
#   in ~/.local/bin, and all of them were "command not found" to an app started
#   from the panel (a Desktop box, 2026-10-26). Prepended in the comfort
#   profile's own add_path order so a terminal and a GUI app resolve the same
#   binary, and skipped when already present so the private-bus re-exec below
#   cannot duplicate an entry.
# - LIBSEAT_BACKEND=seatd: cosmic-comp opens the seat through seatd (the user
#   is in the seat group); desktop.config explains why not logind.
# - xdg-user-dirs-update: ~/Downloads, ~/Documents, … exist before any app
#   (a Flatpak browser's download into a missing ~/Downloads was lost).
# - The session bus is the SYSTEMD USER BUS. It used to be a private
#   dbus-run-session bus, and that is what this file is now careful about:
#     * The portal units (xdg-desktop-portal, xdg-document-portal,
#       xdg-permission-store, flatpak-portal, flatpak-session-helper, gvfs,
#       at-spi-dbus-bus) are PartOf=graphical-session.target. On a private bus
#       nothing could start them; on the user bus they failed outright
#       ("Dependency failed for Portal service") because nothing starts that
#       target either. session-target starts it, once the compositor is up.
#     * Anything launched off the session — ssh, a user service, cron — lands on
#       the user bus, and on a private bus it could not reach a portal at all
#       (a screenshot requested over ssh hung for 120 s; a flatpak started from
#       a terminal timed out on its first portal call).
#     * The keyring is still started before the session, for the same reason it
#       always was: activated on demand it owns its name a moment after the
#       login keyring is set up, and an app's first "which keyring is the
#       default?" in that moment got none.
#   If the user bus never appears (pam_systemd not applied, user@ failed), fall
#   back to the old private bus and re-run this script under dbus-run-session,
#   rather than failing the login.
# - XDG autostart entries (/etc/xdg/autostart, ~/.config/autostart): started by
#   session-autostart once the compositor is up. systemd's own autostart target
#   is not a substitute here: graphical-session.target does not pull
#   xdg-desktop-autostart.target in (checked with
#   `systemctl --user list-dependencies graphical-session.target`), so
#   session-autostart stays the only autostart path and nothing double-starts.
set -u

RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=COSMIC
export XDG_CURRENT_DESKTOP=COSMIC
FLATPAK_USER_SHARE="${XDG_DATA_HOME:-$HOME/.local/share}/flatpak/exports/share"
mkdir -p "$FLATPAK_USER_SHARE/applications" "$FLATPAK_USER_SHARE/icons/hicolor" 2>/dev/null || true
export XDG_DATA_DIRS="$FLATPAK_USER_SHARE:/var/lib/flatpak/exports/share:/usr/local/share:/usr/share"
export XDG_CONFIG_DIRS=/etc/xdg
export LANG="${LANG:-en_US.UTF-8}"
export LIBSEAT_BACKEND=seatd

# Match the comfort profile's per-user bin dirs and its order; `${PATH:-}` keeps
# an unset PATH from producing an empty (== current directory) entry, and the
# case skips a dir already present so the private-bus re-exec below cannot
# duplicate it.
_path="${PATH:-/usr/bin}"
for _d in "$HOME/.local/bin" "$HOME/bin"; do
    case ":$_path:" in
        *":$_d:"*) : ;;
        *) _path="$_d:$_path" ;;
    esac
done
PATH="$_path"
unset _path _d
export PATH

cd "$HOME" 2>/dev/null || cd /
/usr/bin/xdg-user-dirs-update || true

if [ "${PENGYOS_PRIVATE_BUS:-}" != "1" ]; then
    # pam_systemd starts user@<uid> for this session; give its bus a moment.
    i=0
    while [ ! -S "${RUNTIME}/bus" ] && [ "$i" -lt 60 ]; do
        sleep 0.5
        i=$((i + 1))
    done

    if [ -S "${RUNTIME}/bus" ]; then
        export DBUS_SESSION_BUS_ADDRESS="unix:path=${RUNTIME}/bus"
    else
        echo "start-cosmic: no systemd user bus at ${RUNTIME}/bus after 30s; falling back to a private session bus" >&2
        PENGYOS_PRIVATE_BUS=1 exec /usr/bin/dbus-run-session -- "$0"
    fi
fi

eval "$(ssh-agent -s)" >/dev/null
/usr/libexec/pengyos/session-autostart &
/usr/libexec/pengyos/session-target &
dbus-send --session --type=method_call --dest=org.freedesktop.DBus \
    /org/freedesktop/DBus org.freedesktop.DBus.StartServiceByName \
    string:org.freedesktop.secrets uint32:0
exec /usr/bin/cosmic-session /usr/bin/cosmic-comp
