#!/bin/sh
# Write greetd's config for this boot (greetd.service ExecStartPre).
#
# The login screen is always COSMIC's greeter. Automatic login is added only
# when chosen: /etc/pengyos/autologin.conf, in GDM's custom.conf format so that
# AccountsService's SetAutomaticLogin (what settings apps call) reads and
# writes the same file:
#   [daemon]
#   AutomaticLoginEnable=True
#   AutomaticLogin=alex
# `pengyos-autologin on|off` edits it.
#
# A LIVE boot logs root in automatically, the same test the Server/Core console
# gettys use (usr/libexec/pengyos/agetty-autologin): an installed system boots
# with pengyos.data= on the kernel line, a live image does not.
#
# This used to test for the PENGYOS-PAYLOAD partition, which only the *installer*
# stick has. So the plain live image (pengyos-desktop-x86_64.img) showed the
# greeter and demanded a password from a person trying a trial image — found
# 2026-10-08 on behotv booting 26.10.15, and reproducible under QEMU: the plain
# image fails the session check (no cosmic-panel) while the installer stick
# passes it. The payload label says "the installer is available", not "this boot
# is live"; those are different facts and only one of them was being asked.
#
# PENGYOS_CMDLINE / PENGYOS_GREETD_DIR exist so the tests can drive both branches
# without a root; unset, they are the real paths.
set -eu
CONF=${PENGYOS_AUTOLOGIN_CONF:-/etc/pengyos/autologin.conf}
CMDLINE=${PENGYOS_CMDLINE:-/proc/cmdline}
RUN_DIR=${PENGYOS_GREETD_DIR:-/run/greetd}
OUT=$RUN_DIR/config.toml
mkdir -p "$RUN_DIR"

user=""
if ! grep -q 'pengyos\.data=' "$CMDLINE" 2>/dev/null; then
    user=root
elif [ -f "$CONF" ]; then
    enable=$(sed -n 's/^[[:space:]]*AutomaticLoginEnable[[:space:]]*=[[:space:]]*//p' "$CONF" | tail -n1)
    case "$enable" in
        [Tt]rue|1|[Yy]es)
            user=$(sed -n 's/^[[:space:]]*AutomaticLogin[[:space:]]*=[[:space:]]*//p' "$CONF" | tail -n1)
            ;;
    esac
    # Only a real account (and never root on an installed system).
    if [ -n "$user" ] && { [ "$user" = root ] || ! getent passwd "$user" >/dev/null; }; then
        echo "greetd-config: ignoring automatic login for '$user' (no such user, or root)" >&2
        user=""
    fi
fi

{
    echo '[terminal]'
    echo 'vt = 1'
    echo
    echo '[general]'
    echo '# PAM service for users'"'"' sessions (password logins and the automatic one).'
    echo 'service = "pengyos-session"'
    echo
    echo '[default_session]'
    echo 'command = "/usr/libexec/pengyos/cosmic-greeter-start"'
    echo 'user = "cosmic-greeter"'
    if [ -n "$user" ]; then
        echo
        echo '[initial_session]'
        echo 'command = "/usr/libexec/pengyos/start-cosmic"'
        echo "user = \"$user\""
    fi
} > "$OUT.new"
mv "$OUT.new" "$OUT"
echo "greetd-config: automatic login: ${user:-off}"
