# The legacy joystick node /dev/input/jsN: systemd's 50-udev-default.rules
# leaves it root:root at mode 0664, readable by every account on the machine.
# Give it the same owner and mode as the event nodes of the same pad (group
# `input`, 0660), which the desktop user is a member of
# (board/desktop/users.table + the installer's USER_GROUPS).
SUBSYSTEM=="input", KERNEL=="js[0-9]*", GROUP="input", MODE="0660"
