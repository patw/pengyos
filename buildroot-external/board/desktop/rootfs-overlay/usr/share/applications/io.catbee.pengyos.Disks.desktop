[Desktop Entry]
Type=Application
Name=Disks
GenericName=Disk Utility
Comment=Partition and format drives, write disk images, eject USB sticks and memory cards
Exec=pengyos-disks %f
Icon=drive-harddisk-system
Terminal=false
Categories=System;Utility;
Keywords=format;partition;table;gpt;mbr;mount;swap;resize;usb;stick;drive;disk;hard;sd;card;image;iso;installer;eject;
MimeType=application/x-raw-disk-image;application/x-raw-disk-image-xz-compressed;application/x-cd-image;
StartupNotify=true
