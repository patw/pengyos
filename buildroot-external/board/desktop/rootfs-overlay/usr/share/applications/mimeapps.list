# PengyOS Desktop — default applications (freedesktop mimeapps.list, the
# distribution-wide default; a user's ~/.config/mimeapps.list and Settings →
# Default Applications override it). Without it nothing opened an image.
# Images: COSMIC Viewer (pop-os/cosmic-viewer). Markdown: mdit (COSMIC Edit as
# the fallback). Web: Firefox (a Flatpak,
# installed on first boot by pengyos-browser-setup; its .desktop is exported
# to /var/lib/flatpak/exports/share, on XDG_DATA_DIRS).
[Default Applications]
x-scheme-handler/http=org.mozilla.firefox.desktop;
x-scheme-handler/https=org.mozilla.firefox.desktop;
text/html=org.mozilla.firefox.desktop;
application/xhtml+xml=org.mozilla.firefox.desktop;
# PDFs: Firefox's built-in viewer (pdf.js) until a PDF app is installed.
# Evince (org.gnome.Evince), the curated PDF entry, is listed first but NOT
# installed by the image: it needs the GNOME runtime (~290 MB download,
# ~650 MB on disk on top of Firefox's), so it is one click in the Store for
# whoever wants it. xdg-mime walks the list and skips a handler whose .desktop
# does not resolve, so Firefox opens PDFs until Evince is installed, and Evince
# takes over by itself once it is (its .desktop is exported to
# /var/lib/flatpak/exports/share/applications).
application/pdf=org.gnome.Evince.desktop;org.mozilla.firefox.desktop;
image/bmp=com.system76.CosmicViewer.desktop;
image/gif=com.system76.CosmicViewer.desktop;
image/jpeg=com.system76.CosmicViewer.desktop;
image/jpg=com.system76.CosmicViewer.desktop;
image/pjpeg=com.system76.CosmicViewer.desktop;
image/png=com.system76.CosmicViewer.desktop;
image/tiff=com.system76.CosmicViewer.desktop;
image/webp=com.system76.CosmicViewer.desktop;
image/x-bmp=com.system76.CosmicViewer.desktop;
image/x-png=com.system76.CosmicViewer.desktop;
image/x-portable-anymap=com.system76.CosmicViewer.desktop;
image/x-portable-bitmap=com.system76.CosmicViewer.desktop;
image/x-portable-graymap=com.system76.CosmicViewer.desktop;
image/x-portable-pixmap=com.system76.CosmicViewer.desktop;
image/avif=com.system76.CosmicViewer.desktop;
image/heif=com.system76.CosmicViewer.desktop;
image/heic=com.system76.CosmicViewer.desktop;
image/jxl=com.system76.CosmicViewer.desktop;
image/svg+xml=com.system76.CosmicViewer.desktop;
image/x-icon=com.system76.CosmicViewer.desktop;
image/x-qoi=com.system76.CosmicViewer.desktop;
text/plain=com.system76.CosmicEdit.desktop
text/markdown=mdit.desktop;com.system76.CosmicEdit.desktop;
text/x-log=com.system76.CosmicEdit.desktop
application/x-shellscript=com.system76.CosmicEdit.desktop
application/json=com.system76.CosmicEdit.desktop
application/xml=com.system76.CosmicEdit.desktop
inode/directory=com.system76.CosmicFiles.desktop
video/mp4=com.system76.CosmicPlayer.desktop
video/webm=com.system76.CosmicPlayer.desktop
video/x-matroska=com.system76.CosmicPlayer.desktop
video/quicktime=com.system76.CosmicPlayer.desktop
video/x-msvideo=com.system76.CosmicPlayer.desktop
video/mpeg=com.system76.CosmicPlayer.desktop
video/ogg=com.system76.CosmicPlayer.desktop
audio/mpeg=com.system76.CosmicPlayer.desktop
audio/ogg=com.system76.CosmicPlayer.desktop
audio/flac=com.system76.CosmicPlayer.desktop
audio/x-flac=com.system76.CosmicPlayer.desktop
audio/x-wav=com.system76.CosmicPlayer.desktop
audio/wav=com.system76.CosmicPlayer.desktop
audio/mp4=com.system76.CosmicPlayer.desktop
audio/aac=com.system76.CosmicPlayer.desktop
audio/opus=com.system76.CosmicPlayer.desktop
audio/webm=com.system76.CosmicPlayer.desktop
# Archives: COSMIC Files extracts these itself (src/archive.rs — zip, tar, gzip,
# bzip2 and xz, with the bzip2 + lzma-rust2 default features), so it is the
# default for them. Without these rows an archive opened from *outside* COSMIC
# Files (a browser's download row, `open foo.zip`, another app) had no handler
# and xdg-open answered "no method available for opening" — the "no app for this
# file type" warning. Inside COSMIC Files a double-click already routed to
# Extract Here/Extract To; these rows make the same app the system default.
application/zip=com.system76.CosmicFiles.desktop
application/gzip=com.system76.CosmicFiles.desktop
application/x-tar=com.system76.CosmicFiles.desktop
application/x-compressed-tar=com.system76.CosmicFiles.desktop
application/x-bzip=com.system76.CosmicFiles.desktop
application/x-bzip-compressed-tar=com.system76.CosmicFiles.desktop
application/x-bzip2=com.system76.CosmicFiles.desktop
application/x-xz=com.system76.CosmicFiles.desktop
application/x-xz-compressed-tar=com.system76.CosmicFiles.desktop

# --- The text/plain family ---------------------------------------------------
# COSMIC Edit is the default for text/plain, and every type below is a
# text/plain descendant in shared-mime-info. That is enough for gio (COSMIC
# Files' *Open with*), which walks the inheritance tree and finds Edit - but
# xdg-mime/xdg-open match the type string exactly and have no ancestor
# fallback, so `open data.csv` answered "no method available for opening".
# These are the everyday members of the family; the image ships no app that
# handles any of them better than a text editor does.
text/csv=com.system76.CosmicEdit.desktop
text/tab-separated-values=com.system76.CosmicEdit.desktop
text/css=com.system76.CosmicEdit.desktop
text/x-patch=com.system76.CosmicEdit.desktop
text/x-python=com.system76.CosmicEdit.desktop
text/x-csrc=com.system76.CosmicEdit.desktop
text/x-c++src=com.system76.CosmicEdit.desktop
text/x-chdr=com.system76.CosmicEdit.desktop
text/rust=com.system76.CosmicEdit.desktop
application/javascript=com.system76.CosmicEdit.desktop
application/x-yaml=com.system76.CosmicEdit.desktop
application/x-desktop=com.system76.CosmicEdit.desktop
application/rtf=com.system76.CosmicEdit.desktop
text/vtt=com.system76.CosmicEdit.desktop
text/x-ssa=com.system76.CosmicEdit.desktop
application/x-subrip=com.system76.CosmicEdit.desktop
text/vcard=com.system76.CosmicEdit.desktop
text/calendar=com.system76.CosmicEdit.desktop
application/vnd.google-earth.kml+xml=com.system76.CosmicEdit.desktop
application/gpx+xml=com.system76.CosmicEdit.desktop
message/rfc822=com.system76.CosmicEdit.desktop
application/mbox=com.system76.CosmicEdit.desktop
application/x-cue=com.system76.CosmicEdit.desktop

# --- Disk images: the Disks utility ------------------------------------------
# io.catbee.pengyos.Disks already declares exactly these three on its .desktop
# (it writes an .iso/.img, or a published .img.xz, to a USB stick), but nothing
# made it the default, so a downloaded installer image had no handler.
application/x-cd-image=io.catbee.pengyos.Disks.desktop
application/x-raw-disk-image=io.catbee.pengyos.Disks.desktop
application/x-raw-disk-image-xz-compressed=io.catbee.pengyos.Disks.desktop

# --- Images COSMIC Viewer decodes but did not claim --------------------------
# image/vnd.microsoft.icon is the canonical type for .ico; the row above is the
# legacy alias image/x-icon, which xdg-mime cannot match. dds, exr and tga are
# decoders the Rust `image` crate enables through its default-formats feature
# (cosmic-viewer depends on image 0.25 with default features on, so it decodes
# them) and Viewer's .desktop omits - see the cosmic-patches entry.
image/vnd.microsoft.icon=com.system76.CosmicViewer.desktop
image/vnd.radiance=com.system76.CosmicViewer.desktop
image/x-exr=com.system76.CosmicViewer.desktop
image/x-tga=com.system76.CosmicViewer.desktop
image/x-dds=com.system76.CosmicViewer.desktop

# --- Audio COSMIC Player decodes ---------------------------------------------
# Player's .desktop declares video only (its Categories say AudioVideo), so
# outside the hand-maintained rows above an audio file had no handler at all.
# These are the formats the image's GStreamer plugins demux/decode: ogg + opus
# + vorbis (plugins-base/ogg,opus,vorbis), isomp4 for .m4a/.m4b, flac, wavparse,
# mpg123 + audioparsers, and plugins-bad's aiff. No MIDI synth and no module
# player is shipped, so .mid/.mod stay uncovered.
audio/x-vorbis+ogg=com.system76.CosmicPlayer.desktop
audio/x-opus+ogg=com.system76.CosmicPlayer.desktop
audio/x-m4a=com.system76.CosmicPlayer.desktop
audio/x-m4b=com.system76.CosmicPlayer.desktop
audio/mp4a-latm=com.system76.CosmicPlayer.desktop
audio/x-aac=com.system76.CosmicPlayer.desktop
audio/x-aiff=com.system76.CosmicPlayer.desktop
