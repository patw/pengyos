[Desktop Entry]
# COSMIC Settings has no printer page (upstream, epoch 1.9). Network printers
# that speak IPP Everywhere / AirPrint need none: cups-browsed adds them and
# every print dialog lists them. This opens the CUPS admin pages in the default
# browser, to add a USB printer, set a default or clear the queue; changes ask
# for your password (members of wheel administer CUPS).
Type=Application
Name=Printers
GenericName=Printer Settings
Comment=Add and manage printers (CUPS, in your web browser)
Keywords=printer;print;queue;cups;
Icon=printer
Exec=xdg-open http://localhost:631/printers/
Terminal=false
Categories=Settings;HardwareSettings;Printing;
