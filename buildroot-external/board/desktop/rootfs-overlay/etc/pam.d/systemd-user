# PengyOS — systemd --user instances (the user's service manager: PipeWire,
# WirePlumber, portals). systemd's own /usr/lib/pam.d/systemd-user, plus
# pam_limits: without it the limits in /etc/security/limits.d never reached
# user services -- PipeWire ran with rtprio 0 despite @pipewire rtprio 95
# (RTKit isn't shipped; mod.rt falls back to RLIMIT_RTPRIO), and GameMode's
# @gamemode nice limit was ignored too. Other distros include it via their
# common session stack.
account  required   pam_unix.so no_pass_expiry

session  required   pam_loginuid.so
session  optional   pam_keyinit.so force revoke
session  required   pam_limits.so
session  required   pam_namespace.so
session  optional   pam_umask.so silent
session  optional   pam_systemd.so
