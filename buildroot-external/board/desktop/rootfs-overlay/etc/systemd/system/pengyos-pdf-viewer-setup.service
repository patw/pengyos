# PengyOS Desktop - install the PDF viewer (Evince) from Flathub, once (first
# boot with a network). Not on the live stick: its /var is thrown away at
# shutdown.
#
# After pengyos-browser-setup, not beside it: flatpak's system install takes a
# repo lock, and both units pull from the same remote, so serialising them
# avoids two installs racing on the first boot. The GNOME runtime Evince needs
# is also fetched once and shared with the other org.gnome.* entries the
# curated set names later.
#
# Offline it fails and retries; 50-pengyos-flatpak-setup in NetworkManager's
# dispatcher starts it as soon as a connection is up rather than waiting out
# RestartSec.
[Unit]
Description=PengyOS: install the PDF viewer (Evince Flatpak)
After=network-online.target pengyos-browser-setup.service
Wants=network-online.target
ConditionPathExists=!/var/lib/flatpak/.pengyos-pdf-viewer
ConditionPathExists=!/dev/disk/by-label/PENGYOS-PAYLOAD
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/pengyos/pengyos-pdf-viewer-setup.sh
Restart=on-failure
RestartSec=10min

[Install]
WantedBy=multi-user.target
