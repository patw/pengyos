# PengyOS Desktop - install Firefox from Flathub, once (first boot with a
# network). Not on the live stick: its /var is thrown away at shutdown.
# Offline it fails and retries; 50-pengyos-flatpak-setup in NetworkManager's
# dispatcher also starts it once a connection is up, so joining wifi after the
# install no longer means up to RestartSec (or a reboot) without a browser.
[Unit]
Description=PengyOS: install the web browser (Firefox Flatpak)
After=network-online.target pengyos-flatpak-setup.service
Wants=network-online.target
ConditionPathExists=!/var/lib/flatpak/.pengyos-browser
# Installed systems only (pengyos.data= on the kernel line). This used to test
# for the installer stick's PENGYOS-PAYLOAD partition, which skipped Firefox on
# an installed machine booted with a stick plugged in, and still ran on the
# plain live image, whose /var is thrown away too.
ConditionKernelCommandLine=pengyos.data
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/pengyos/pengyos-browser-setup.sh
Restart=on-failure
RestartSec=10min

[Install]
WantedBy=multi-user.target
