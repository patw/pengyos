+                // the window title. The title fallback covers Electron apps
+                // (VS Code) that never set xdg_toplevel app_id, only the
+                // security-context id the compositor cannot see.
+                id.eq_ignore_ascii_case(&app_id)
+                    || (!title.is_empty() && title.to_lowercase().contains(&id.to_lowercase()))
+            })
+    }
