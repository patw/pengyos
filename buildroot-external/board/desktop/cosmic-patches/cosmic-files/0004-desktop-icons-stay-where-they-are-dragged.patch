new file mode 100644
index 0000000..71ecc93
--- /dev/null
+++ b/src/desktop_layout.rs
@@ -0,0 +1,300 @@
+// Desktop icon placement: icons stay in the grid cell they were dragged to.
+//
+// Upstream lays the desktop out as an auto-flow grid (column by column, in sort
+// order) and has nowhere to keep a position, so a dragged icon cannot be moved.
+// Positions are kept per output, keyed by file name, as (row, col) cells. A cell
+// that no longer fits the screen (smaller output, bigger icons) is ignored, not
+// forgotten, so the icon goes back when the cell fits again.
+
+use std::collections::{BTreeMap, BTreeSet};
+
+/// Saved cells of one output: file name -> (row, col).
+pub type Positions = BTreeMap<String, (u32, u32)>;
+
+/// Positions are only pruned past this many entries, so a file that is removed
+/// and comes back (a game reinstalled, a download replaced) keeps its spot.
+const PRUNE_ABOVE: usize = 512;
+
+/// The cell of every key, in the order given.
+///
+/// Keys with a saved cell inside the `rows` x `cols` screen get it (first come,
+/// first served if two share one). The rest fill the free cells in upstream's
+/// order: down each column, left to right, then the same again one screen
+/// further down when the screen is full.
+pub fn cells(keys: &[&str], saved: &Positions, rows: usize, cols: usize) -> Vec<(usize, usize)> {
+    let rows = rows.max(1);
+    let cols = cols.max(1);
+    let mut out: Vec<Option<(usize, usize)>> = vec![None; keys.len()];
+    let mut taken = BTreeSet::new();
+    for (i, key) in keys.iter().enumerate() {
+        if let Some(&(row, col)) = saved.get(*key) {
+            let cell = (row as usize, col as usize);
+            if cell.0 < rows && cell.1 < cols && taken.insert(cell) {
+                out[i] = Some(cell);
+            }
+        }
+    }
+    let mut free = (0..).flat_map(move |page: usize| {
+        (0..cols).flat_map(move |col| (page * rows..(page + 1) * rows).map(move |row| (row, col)))
+    });
+    out.into_iter()
+        .map(|cell| {
+            cell.unwrap_or_else(|| {
+                free.by_ref()
+                    .find(|cell| !taken.contains(cell))
+                    .expect("the cell iterator is endless")
+            })
+        })
+        .collect()
+}
+
+/// The cell nearest to `want` that is not taken, or None when the screen is full.
+fn nearest_free(
+    want: (usize, usize),
+    taken: &BTreeSet<(usize, usize)>,
+    rows: usize,
+    cols: usize,
+) -> Option<(usize, usize)> {
+    let mut best: Option<((usize, usize), usize)> = None;
+    for col in 0..cols {
+        for row in 0..rows {
+            if taken.contains(&(row, col)) {
+                continue;
+            }
+            let d = row.abs_diff(want.0).pow(2) + col.abs_diff(want.1).pow(2);
+            if best.is_none_or(|(_, bd)| d < bd) {
+                best = Some(((row, col), d));
+            }
+        }
+    }
+    best.map(|(cell, _)| cell)
+}
+
+/// The positions after dragging `moving` so that the icon grabbed at `anchor`
+/// lands on `target`.
+///
+/// `shown` is every icon on screen with the cell it is drawn in. All of them are
+/// pinned where they are, so dragging one icon does not reshuffle the others
+/// later. Each dragged icon keeps its offset from the grabbed one, clamped to
+/// the screen; if that cell is taken it goes to the nearest free one.
+pub fn moved(
+    saved: &Positions,
+    shown: &[(String, (usize, usize))],
+    moving: &BTreeSet<String>,
+    anchor: (usize, usize),
+    target: (usize, usize),
+    rows: usize,
+    cols: usize,
+) -> Positions {
+    let rows = rows.max(1);
+    let cols = cols.max(1);
+    let mut out = saved.clone();
+    let mut taken = BTreeSet::new();
+    for (name, cell) in shown {
+        if cell.0 < rows && cell.1 < cols && !moving.contains(name) {
+            out.insert(name.clone(), (cell.0 as u32, cell.1 as u32));
+            taken.insert(*cell);
+        }
+    }
+    let shift = |v: usize, from: usize, to: usize, max: usize| -> usize {
+        (v as isize + to as isize - from as isize).clamp(0, max as isize - 1) as usize
+    };
+    let mut dragged: Vec<&(String, (usize, usize))> =
+        shown.iter().filter(|(name, _)| moving.contains(name)).collect();
+    // The grabbed icon first, then the others outward from it, so the icon under
+    // the pointer always gets the cell under the pointer.
+    dragged.sort_by_key(|(_, cell)| {
+        (
+            cell.0.abs_diff(anchor.0).pow(2) + cell.1.abs_diff(anchor.1).pow(2),
+            cell.1,
+            cell.0,
+        )
+    });
+    for (name, cell) in dragged {
+        let want = (
+            shift(cell.0, anchor.0, target.0, rows),
+            shift(cell.1, anchor.1, target.1, cols),
+        );
+        match nearest_free(want, &taken, rows, cols) {
+            Some(cell) => {
+                taken.insert(cell);
+                out.insert(name.clone(), (cell.0 as u32, cell.1 as u32));
+            }
+            // Screen full: let it flow to the next free cell.
+            None => {
+                out.remove(name);
+            }
+        }
+    }
+    prune(&mut out, shown);
+    out
+}
+
+/// Claim cells for files dropped onto the desktop from elsewhere, starting at
+/// `target`, before they exist. Names already shown keep their cells.
+pub fn dropped(
+    saved: &Positions,
+    shown: &[(String, (usize, usize))],
+    names: &[String],
+    target: (usize, usize),
+    rows: usize,
+    cols: usize,
+) -> Positions {
+    let rows = rows.max(1);
+    let cols = cols.max(1);
+    let mut out = saved.clone();
+    let mut taken: BTreeSet<(usize, usize)> = shown.iter().map(|(_, cell)| *cell).collect();
+    let target = (target.0.min(rows - 1), target.1.min(cols - 1));
+    for name in names {
+        if shown.iter().any(|(n, _)| n == name) {
+            continue;
+        }
+        if let Some(cell) = nearest_free(target, &taken, rows, cols) {
+            taken.insert(cell);
+            out.insert(name.clone(), (cell.0 as u32, cell.1 as u32));
+        }
+    }
+    out
+}
+
+/// The grid cell whose centre is nearest to a point in grid coordinates.
+pub fn cell_at(
+    x: f32,
+    y: f32,
+    pad: f32,
+    item: (f32, f32),
+    spacing: (f32, f32),
+    rows: usize,
+    cols: usize,
+) -> (usize, usize) {
+    let index = |v: f32, size: f32, gap: f32, max: usize| -> usize {
+        let pitch = size + gap;
+        if pitch <= 0.0 {
+            return 0;
+        }
+        (((v - pad - size / 2.0) / pitch).round().max(0.0) as usize).min(max.max(1) - 1)
+    };
+    (
+        index(y, item.1, spacing.1, rows),
+        index(x, item.0, spacing.0, cols),
+    )
+}
+
+fn prune(out: &mut Positions, shown: &[(String, (usize, usize))]) {
+    if out.len() > PRUNE_ABOVE {
+        out.retain(|name, _| shown.iter().any(|(n, _)| n == name));
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn pos(entries: &[(&str, (u32, u32))]) -> Positions {
+        entries.iter().map(|(k, v)| (k.to_string(), *v)).collect()
+    }
+
+    #[test]
+    fn nothing_saved_is_upstreams_column_flow() {
+        let got = cells(&["a", "b", "c", "d", "e"], &Positions::new(), 2, 2);
+        assert_eq!(got, vec![(0, 0), (1, 0), (0, 1), (1, 1), (2, 0)]);
+    }
+
+    #[test]
+    fn saved_cells_win_and_the_rest_flow_around_them() {
+        let saved = pos(&[("c", (0, 0)), ("a", (1, 2))]);
+        let got = cells(&["a", "b", "c", "d"], &saved, 3, 3);
+        assert_eq!(got, vec![(1, 2), (1, 0), (0, 0), (2, 0)]);
+    }
+
+    #[test]
+    fn a_cell_off_the_screen_is_ignored_but_kept() {
+        let saved = pos(&[("a", (5, 5))]);
+        assert_eq!(cells(&["a"], &saved, 2, 2), vec![(0, 0)]);
+        assert_eq!(cells(&["a"], &saved, 6, 6), vec![(5, 5)]);
+    }
+
+    #[test]
+    fn two_icons_claiming_one_cell_do_not_overlap() {
+        let saved = pos(&[("a", (0, 1)), ("b", (0, 1))]);
+        let got = cells(&["a", "b"], &saved, 2, 2);
+        assert_eq!(got[0], (0, 1));
+        assert_ne!(got[1], (0, 1));
+    }
+
+    #[test]
+    fn moving_one_icon_pins_the_others() {
+        let shown = vec![
+            ("a".to_string(), (0, 0)),
+            ("b".to_string(), (1, 0)),
+            ("c".to_string(), (2, 0)),
+        ];
+        let moving = BTreeSet::from(["a".to_string()]);
+        let got = moved(&Positions::new(), &shown, &moving, (0, 0), (2, 4), 3, 5);
+        assert_eq!(got, pos(&[("a", (2, 4)), ("b", (1, 0)), ("c", (2, 0))]));
+    }
+
+    #[test]
+    fn a_group_keeps_its_shape_and_clamps_to_the_screen() {
+        let shown = vec![("a".to_string(), (0, 0)), ("b".to_string(), (1, 1))];
+        let moving = BTreeSet::from(["a".to_string(), "b".to_string()]);
+        // Grab b, drop it in the bottom-right corner: a stays one up and left.
+        let got = moved(&Positions::new(), &shown, &moving, (1, 1), (3, 3), 4, 4);
+        assert_eq!(got, pos(&[("a", (2, 2)), ("b", (3, 3))]));
+        // Drop a past the edge: clamped, never off the screen.
+        let got = moved(&Positions::new(), &shown, &moving, (0, 0), (3, 3), 4, 4);
+        assert_eq!(got["a"], (3, 3));
+        assert!(got["b"].0 < 4 && got["b"].1 < 4 && got["b"] != got["a"]);
+    }
+
+    #[test]
+    fn dropping_on_an_occupied_cell_takes_the_nearest_free_one() {
+        let shown = vec![("a".to_string(), (0, 0)), ("b".to_string(), (2, 2))];
+        let moving = BTreeSet::from(["a".to_string()]);
+        let got = moved(&Positions::new(), &shown, &moving, (0, 0), (2, 2), 5, 5);
+        assert_eq!(got["b"], (2, 2));
+        let a = got["a"];
+        assert_ne!(a, (2, 2));
+        assert_eq!(a.0.abs_diff(2) + a.1.abs_diff(2), 1, "next to the target: {a:?}");
+    }
+
+    #[test]
+    fn the_grabbed_icon_gets_the_cell_under_the_pointer() {
+        // Two icons whose shifted cells collide at the edge: the grabbed one wins.
+        let shown = vec![("a".to_string(), (0, 0)), ("b".to_string(), (0, 1))];
+        let moving = BTreeSet::from(["a".to_string(), "b".to_string()]);
+        let got = moved(&Positions::new(), &shown, &moving, (0, 0), (0, 3), 1, 4);
+        assert_eq!(got["a"], (0, 3));
+        assert_eq!(got["b"], (0, 2));
+    }
+
+    #[test]
+    fn files_dropped_from_elsewhere_claim_cells_at_the_drop_point() {
+        let shown = vec![("a".to_string(), (1, 1))];
+        let names = vec!["x".to_string(), "y".to_string(), "a".to_string()];
+        let got = dropped(&Positions::new(), &shown, &names, (1, 1), 3, 3);
+        assert!(!got.contains_key("a"), "a file already shown keeps its cell");
+        assert_ne!(got["x"], (1, 1));
+        assert_ne!(got["x"], got["y"]);
+        assert_eq!(got["x"].0.abs_diff(1) + got["x"].1.abs_diff(1), 1);
+    }
+
+    #[test]
+    fn a_point_maps_to_the_nearest_cell_centre() {
+        // 100x160 cells, 20 px gaps, 8 px padding.
+        let at = |x, y| cell_at(x, y, 8.0, (100.0, 160.0), (20.0, 20.0), 4, 6);
+        assert_eq!(at(10.0, 10.0), (0, 0));
+        assert_eq!(at(8.0 + 120.0 + 50.0, 8.0 + 80.0), (0, 1));
+        assert_eq!(at(8.0 + 2.0 * 120.0 + 50.0, 8.0 + 180.0 + 80.0), (1, 2));
+        assert_eq!(at(1e6, 1e6), (3, 5), "clamped to the screen");
+        assert_eq!(at(-50.0, -50.0), (0, 0));
+    }
+
+    #[test]
+    fn pruning_waits_for_a_large_map() {
+        let shown = vec![("a".to_string(), (0, 0))];
+        let saved = pos(&[("gone", (1, 1))]);
+        let got = moved(&saved, &shown, &BTreeSet::new(), (0, 0), (0, 0), 3, 3);
+        assert!(got.contains_key("gone"));
+    }
+}
