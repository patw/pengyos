+/// Refuse `path` when any part of it below `directory` already exists as a symlink,
+/// the last part included. The extraction directory is new, so the only symlinks in
+/// it are ones the archive itself created; writing through one (or onto one, which
+/// `File::create` follows) would put the entry wherever the link points.
+fn refuse_through_symlink(directory: &Path, path: &Path) -> zip::result::ZipResult<()> {
+    use zip::result::ZipError;
+    let rel = path
+        .strip_prefix(directory)
+        .map_err(|_| ZipError::InvalidArchive("Invalid file path".into()))?;
+    let mut cur = directory.to_path_buf();
+    for part in rel.components() {
+        cur.push(part);
+        match std::fs::symlink_metadata(&cur) {
+            Ok(meta) if meta.file_type().is_symlink() => {
+                return Err(ZipError::InvalidArchive(
+                    "Archive entry would be written through a symbolic link".into(),
+                ));
+            }
+            Ok(_) => {}
+            // Not there yet, so nothing below it is either.
+            Err(_) => break,
+        }
+    }
+    Ok(())
+}
