# PengyOS Desktop: GSettings defaults (compiled into the image by Buildroot's
# libglib2 schema step; external.mk installs this file into staging).

# Location services on. xdg-desktop-portal-gtk's Lockdown backend maps this
# GNOME key to the Location portal's "disable-location". GNOME flips it in its
# Privacy settings; COSMIC has no such switch, so with the schema default
# (false) the portal answered every app "Location services disabled". Each
# Flatpak app is still asked once (COSMIC's Access dialog) before it gets a
# location. A user can turn it off with:
#   gsettings set org.gnome.system.location enabled false
[org.gnome.system.location]
enabled=true

# COSMIC's own defaults (libcosmic CosmicTk::default: show_minimize and
# show_maximize on, icon theme Cosmic). A Flatpak GTK app (Firefox, Chrome,
# VS Code) reads its titlebar buttons from button-layout through the Settings
# portal; the schema default "appmenu:close" is a close-only titlebar.
# cosmic-settings-daemon does write these at login, but as four concurrent
# `gsettings set` processes, and without dconf GLib uses the keyfile backend,
# where each writer rewrites the whole file: the writes race and some are
# lost (beholaptop, fresh 26.10.32 install, lost button-layout and
# icon-theme). With the defaults right here, a lost write changes nothing.
[org.gnome.desktop.wm.preferences]
button-layout=':minimize,maximize,close'

[org.gnome.desktop.interface]
icon-theme='Cosmic'
