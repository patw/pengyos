# PengyOS Server: an address for any Wi-Fi interface wpa_supplicant has joined
# (wpa_supplicant-nl80211@<iface>.service, which the installer enables for the
# network it joined, or `wpa_cli` by hand). Short Wi-Fi drops while roaming
# between access points keep the address.
[Match]
Type=wlan

[Network]
DHCP=yes
# mDNS on this link: answer for <hostname>.local and resolve other .local names
# (resolved's own stack; the firewall already accepts 5353/udp). Not on the
# Desktop, where avahi is the mDNS stack and resolved's is off
# (resolved.conf.d/50-pengyos-mdns-resolve-only.conf).
MulticastDNS=yes
IgnoreCarrierLoss=3s

# The installer gives the machine its name (/etc/hostname); a DHCP-offered
# name would only be refused ("Could not set hostname: Access denied").
[DHCPv4]
UseHostname=no
