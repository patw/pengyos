# PengyOS Server — bring up any wired NIC via DHCP (systemd-networkd).
# US-SRV: the server gets a lease with no manual configuration.
# Physical NICs only (Kind=!* = no netdev kind), as systemd's own
# 89-ethernet.network.example matches. A veth is also Type=ether: rootful
# podman's host-side veth was taken over by networkd (DHCP, per-link
# forwarding off), so containers had no network (found 2026-10-11).
[Match]
Kind=!*
Type=ether

[Network]
DHCP=yes
# mDNS on this link: answer for <hostname>.local and resolve other .local names
# (resolved's own stack; the firewall already accepts 5353/udp). Not on the
# Desktop, where avahi is the mDNS stack and resolved's is off
# (resolved.conf.d/50-pengyos-mdns-resolve-only.conf).
MulticastDNS=yes

# The installer gives the machine its name (/etc/hostname); a DHCP-offered
# name would only be refused ("Could not set hostname: Access denied").
# UseDomains=yes keeps the router's DHCP domain (option 15) as this link's
# search domain, so bare LAN names resolve (`ssh nas`, `getent hosts nas`).
# networkd's default drops it, and `hosts: resolve [!UNAVAIL=return]` then
# lets resolved's NXDOMAIN win; NetworkManager on the Desktop keeps it, which
# is why only Core and Server had the bug (found 2026-11-14).
[DHCPv4]
UseHostname=no
UseDomains=yes
