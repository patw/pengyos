# PengyOS — per-machine SSH host keys, generated on first boot.
#
# Host keys used to be generated at build time and shipped in the image, so every
# machine installed from it (and every installer stick) shared one set of host
# keys: anyone with the image could impersonate any PengyOS host. Generate them
# here instead, once, before sshd; they then persist in /etc/ssh.
[Unit]
Description=Generate SSH host keys (first boot)
Before=sshd.service
ConditionPathExists=!/etc/ssh/ssh_host_ed25519_key

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -A
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
