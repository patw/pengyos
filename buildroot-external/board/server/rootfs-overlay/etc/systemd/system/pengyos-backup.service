# PengyOS backup run (pengyos-backup run --scheduled): every enabled job in
# /etc/pengyos/backup.d to this machine's restic repository (/etc/pengyos/backup.toml),
# each from a btrfs read-only snapshot, then retention and, when due, a check that
# the data reads back. Driven by pengyos-backup.timer; off until a job is enabled
# (pengyos-backup enable JOB turns the timer on). Contract: tools/pengyos-backup/spec.md.
#
# Runs as root: it reads every account's files and makes btrfs snapshots. No
# RemainAfterExit= (a timer cannot start a unit left "active (exited)").

[Unit]
Description=PengyOS backup
Documentation=file:/usr/share/doc/pengyos/skills/pengyos_skill.md
# A failed run alerts (/etc/pengyos/alert.conf) on top of the per-job alerts.
OnFailure=pengyos-alert@%n.service
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/pengyos-backup run --scheduled
CacheDirectory=pengyos-backup
StateDirectory=pengyos-backup
# Stay out of the way of the machine's real work.
Nice=10
IOSchedulingClass=idle
