# Nightly backups at 02:30 (spread over 30 min), before pengyos-update-auto's 04:00
# window. Persistent=yes: a machine that was off catches up at the next boot.
# Shipped DISABLED (10-pengyos-server.preset); `pengyos-backup enable JOB` turns it
# on, and it goes off again when the last job is disabled.

[Unit]
Description=Nightly PengyOS backup

[Timer]
OnCalendar=*-*-* 02:30:00
RandomizedDelaySec=30min
Persistent=yes
Unit=pengyos-backup.service

[Install]
WantedBy=timers.target
