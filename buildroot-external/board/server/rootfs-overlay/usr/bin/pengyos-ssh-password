#!/usr/bin/env python3
"""pengyos-ssh-password - let SSH accept passwords, or go back to keys only.

    pengyos-ssh-password [status] [--json]
    sudo pengyos-ssh-password on
    sudo pengyos-ssh-password off [--force]

PengyOS's sshd accepts keys only: that is the default and the safer setting.
Someone who has never made an SSH key cannot log in that way, so `on` lets SSH
also accept an account's password, which is what most people expect from a
server they just installed. root never logs in with a password over SSH, either
way (sshd_config: PermitRootLogin prohibit-password).

`on` writes /etc/ssh/sshd_config.d/50-pengyos-ssh-password.conf (on the data
partition, kept across updates), checks the result with `sshd -t` and reloads
sshd. While it is on, every login prints a reminder (/etc/motd.d/). `off`
removes both files. It refuses while no account has a key, since nobody could
then log in over SSH; `--force` turns it off anyway. Sessions already open
stay open either way. `status` lists which accounts have keys, and how to add one.

The installer's "Keys or password" choice runs `pengyos-ssh-password on --offline`
in the new system (write the files only: no sshd is running there yet).

Exit: 0 ok; 2 usage; 3 `off` refused (no account has a key); 5 not root;
6 sshd rejected the configuration (nothing changed).
"""
from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys

DROPIN = "/etc/ssh/sshd_config.d/50-pengyos-ssh-password.conf"
MOTD = "/etc/motd.d/50-pengyos-ssh-password"
ROOT = ""  # --root, for tests

DROPIN_TEXT = """\
# Written by pengyos-ssh-password (or the installer's "Keys or password"
# choice). SSH also accepts an account's password, which is less safe than a
# key: anyone who can reach port 22 can try to guess it. root still logs in
# with a key only (PermitRootLogin prohibit-password in /etc/ssh/sshd_config).
# Back to keys only: sudo pengyos-ssh-password off
PasswordAuthentication yes
# Repeated failures from one address are still slowed by OpenSSH's own
# PerSourcePenalties defaults. Do not raise authfail: ssh-copy-id makes two
# probe connections that count as failures, and at 15s each sshd drops the
# third one, the one that copies the key.
"""

MOTD_TEXT = """\
SSH password logins are ON for this machine; keys are safer.
Run pengyos-ssh-password to see how to set up a key, then turn them off.
"""

# An authorized_keys line: optional options, then a key type and base64 blob.
_KEY_RE = re.compile(r"(^|\s)(ssh-(ed25519|rsa|dss)|ecdsa-sha2-\S+|sk-\S+)\s+AAAA[0-9A-Za-z+/=]+")


def p(path: str) -> str:
    return ROOT + path


def is_on() -> bool:
    return os.path.isfile(p(DROPIN))


def hostname() -> str:
    try:
        with open(p("/etc/hostname")) as f:
            return f.read().strip() or "this-machine"
    except OSError:
        return "this-machine"


def accounts() -> list[dict]:
    """People's accounts (uid >= 1000 with a login shell) and their key count.

    keys is None when the file cannot be read (another user's home, not root)."""
    out = []
    try:
        with open(p("/etc/passwd")) as f:
            rows = [ln.rstrip("\n").split(":") for ln in f if ln.count(":") >= 6]
    except OSError:
        return out
    for name, _pw, uid, _gid, _gecos, home, shell in (r[:7] for r in rows):
        if not uid.isdigit() or not 1000 <= int(uid) < 60000:
            continue
        if shell.endswith(("nologin", "false")):
            continue
        path = p(os.path.join(home, ".ssh/authorized_keys"))
        try:
            with open(path) as f:
                keys = sum(1 for ln in f if not ln.lstrip().startswith("#") and _KEY_RE.search(ln))
        except FileNotFoundError:
            keys = 0
        except OSError:
            keys = None
        out.append({"user": name, "keys": keys})
    return out


def how_to(user: str) -> list[str]:
    host = hostname()
    target = f"{user}@{host}"
    return [
        "To log in with a key instead (on the computer you connect FROM):",
        "  1. make a key, once:   ssh-keygen -t ed25519      (press Enter at each question)",
        f"  2. copy it here:       ssh-copy-id {target}",
        "     Windows PowerShell has no ssh-copy-id; use:",
        f"       type $env:USERPROFILE\\.ssh\\id_ed25519.pub | ssh {target} \"mkdir -p ~/.ssh && cat >> ~/.ssh/authorized_keys\"",
        f"  3. check: ssh {target} should log in without asking for {host}'s password",
        "  then: sudo pengyos-ssh-password off",
    ]


def need_root() -> None:
    if not ROOT and os.geteuid() != 0:
        print("pengyos-ssh-password: run it with sudo", file=sys.stderr)
        sys.exit(5)


def write(path: str, text: str) -> None:
    os.makedirs(os.path.dirname(p(path)), mode=0o755, exist_ok=True)
    tmp = p(path) + ".new"
    with open(tmp, "w") as f:
        f.write(text)
    os.chmod(tmp, 0o644)
    os.replace(tmp, p(path))


def remove(path: str) -> None:
    try:
        os.remove(p(path))
    except FileNotFoundError:
        pass


def sshd_check() -> str | None:
    """None if sshd accepts its configuration, else what it said."""
    try:
        r = subprocess.run(["sshd", "-t"], capture_output=True, text=True)
    except FileNotFoundError:
        return None  # no sshd here: nothing to check, nothing to reload
    return None if r.returncode == 0 else (r.stderr or r.stdout).strip()


def reload_sshd() -> str:
    try:
        active = subprocess.run(["systemctl", "is-active", "--quiet", "sshd"]).returncode == 0
    except FileNotFoundError:
        return "sshd is not managed here; it reads the setting when it starts"
    if not active:
        return "sshd is not running; it reads the setting when it starts"
    r = subprocess.run(["systemctl", "reload", "sshd"], capture_output=True, text=True)
    if r.returncode != 0:
        return "could not reload sshd (" + (r.stderr.strip() or "failed") + "); it reads the setting when it restarts"
    return "sshd reloaded"


def cmd_status(as_json: bool) -> int:
    on, accts = is_on(), accounts()
    if as_json:
        print(json.dumps({"password_logins": on, "root_password_login": False,
                          "dropin": DROPIN, "accounts": accts}))
        return 0
    if on:
        print("SSH password logins: ON (keys and passwords; root: keys only)")
    else:
        print("SSH password logins: off (keys only, the default)")
    if accts:
        print("accounts:")
        for a in accts:
            k = a["keys"]
            n = "? keys (run with sudo to read)" if k is None else f"{k} key{'s' if k != 1 else ''}"
            print(f"  {a['user']:<16} {n}")
    me = os.environ.get("SUDO_USER") or os.environ.get("USER") or (accts[0]["user"] if accts else "you")
    if on:
        print()
        print("\n".join(how_to(me)))
    else:
        print()
        print("Someone without a key? sudo pengyos-ssh-password on  (less safe; root stays keys-only)")
    return 0


def cmd_on(offline: bool) -> int:
    need_root()
    was_on = is_on()
    write(DROPIN, DROPIN_TEXT)
    if not offline:
        problem = sshd_check()
        if problem:
            if not was_on:
                remove(DROPIN)
            print(f"pengyos-ssh-password: sshd rejected the setting, nothing changed:\n{problem}",
                  file=sys.stderr)
            return 6
    write(MOTD, MOTD_TEXT)
    note = "" if offline else "; " + reload_sshd()
    print("SSH password logins: ON (root: keys only)" + note)
    print("Passwords are less safe than keys: anyone who can reach port 22 can guess at them.")
    return 0


def cmd_off(force: bool, offline: bool) -> int:
    need_root()
    if not is_on():
        print("SSH password logins: already off (keys only)")
        return 0
    accts = accounts()
    if not force and not any(a["keys"] for a in accts):
        me = os.environ.get("SUDO_USER") or (accts[0]["user"] if accts else "you")
        print("pengyos-ssh-password: no account has an SSH key yet, so with passwords off\n"
              "nobody could log in over SSH (only at this machine's keyboard). Left on.\n",
              file=sys.stderr)
        print("\n".join(how_to(me)[:-1]), file=sys.stderr)
        print("\nOr turn it off anyway: sudo pengyos-ssh-password off --force", file=sys.stderr)
        return 3
    remove(DROPIN)
    remove(MOTD)
    note = "" if offline else "; " + reload_sshd()
    print("SSH password logins: off (keys only)" + note)
    print("Sessions already open stay open.")
    return 0


def main(argv: list[str]) -> int:
    global ROOT
    ap = argparse.ArgumentParser(prog="pengyos-ssh-password",
                                 description="Let SSH accept passwords, or keys only (the default).")
    ap.add_argument("--root", default="", help=argparse.SUPPRESS)
    sub = ap.add_subparsers(dest="cmd")
    s = sub.add_parser("status", help="on or off, and which accounts have keys")
    s.add_argument("--json", action="store_true")
    o = sub.add_parser("on", help="also accept passwords (less safe)")
    o.add_argument("--offline", action="store_true", help=argparse.SUPPRESS)
    f = sub.add_parser("off", help="keys only again")
    f.add_argument("--force", action="store_true", help="even when no account has a key")
    f.add_argument("--offline", action="store_true", help=argparse.SUPPRESS)
    ap.add_argument("--json", action="store_true", help=argparse.SUPPRESS)
    a = ap.parse_args(argv)
    ROOT = a.root.rstrip("/")
    if a.cmd in (None, "status"):
        return cmd_status(a.json)
    if a.cmd == "on":
        return cmd_on(a.offline)
    return cmd_off(a.force, a.offline)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
