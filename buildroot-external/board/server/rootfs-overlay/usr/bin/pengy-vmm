#!/usr/bin/env python3
"""pengy-vmm - your VMs in a browser: a web page over `pengyos-vm`.

    pengy-vmm url                     the address to open (with your token)
    pengy-vmm serve [--port 5100] [--host 127.0.0.1]
    systemctl --user enable --now pengy-vmm   (serve it in the background)

Everything it does, it does by running `pengyos-vm` as you: the page is a view
of `pengyos-vm list --json` and `show --json`, and its buttons are the same
commands you would type. There is nothing here the CLI cannot do.

It listens on 127.0.0.1 only. Other people with an account on this machine
can reach that port too, so every request needs your token
(~/.config/pengy-vmm/token, 0600, made on first run): `pengy-vmm url` prints
the address with it, the page keeps it in a SameSite=Strict cookie, and
changes also need it in a header. From another machine, tunnel it:
    ssh -L 5100:127.0.0.1:5100 you@this-machine   then open `pengy-vmm url`.

--vm-cmd PATH (test hook) runs PATH instead of /usr/bin/pengyos-vm.
"""

from __future__ import annotations

import argparse
import hmac
import html
import json
import os
import re
import secrets
import socket
import subprocess
import sys
import threading
import time
from http.cookies import SimpleCookie
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, urlparse

PROG = "pengy-vmm"
PORT = 5100
VM_CMD = ["/usr/bin/pengyos-vm"]
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,31}$")
JOBS: dict[str, dict] = {}
JOBS_LOCK = threading.Lock()


def token_path() -> Path:
    return Path.home() / ".config" / PROG / "token"


def token() -> str:
    p = token_path()
    if not p.is_file():
        p.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(secrets.token_urlsafe(24) + "\n")
    return p.read_text().strip()


def vm(*args: str, timeout: float = 60) -> tuple[int, str]:
    """Run pengyos-vm; (exit code, stdout+stderr)."""
    try:
        cp = subprocess.run(VM_CMD + list(args), capture_output=True, text=True,
                            stdin=subprocess.DEVNULL, timeout=timeout)
    except subprocess.TimeoutExpired:
        return 124, f"pengyos-vm {args[0]} took longer than {timeout:.0f}s"
    return cp.returncode, (cp.stdout + cp.stderr).strip()


def vm_json(*args: str):
    code, out = vm(*args, "--json")
    if code != 0:
        raise RuntimeError(out)
    return json.loads(out)


def start_job(title: str, args: list[str]) -> str:
    """A slow command (create downloads and converts) in the background."""
    jid = secrets.token_hex(4)
    with JOBS_LOCK:
        JOBS[jid] = {"id": jid, "title": title, "done": False, "ok": None, "output": "",
                     "started": time.time()}

    def work():
        code, out = vm(*args, timeout=3600)
        with JOBS_LOCK:
            JOBS[jid].update(done=True, ok=code == 0, output=out)

    threading.Thread(target=work, daemon=True).start()
    return jid


def console_send(name: str, text: str) -> str:
    """Type a line into a VM's serial console (as `pengyos-vm console` would)."""
    sock = Path.home() / "vms" / name / "serial.sock"
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(str(sock))
        s.sendall(text.encode() + b"\r")
        time.sleep(0.3)
    except OSError as e:
        raise RuntimeError(f"cannot reach {name}'s console ({e.strerror}); "
                           f"is it running, or is a `pengyos-vm console` open?")
    finally:
        s.close()
    return "sent"


def console_tail(name: str, lines: int = 200) -> str:
    log = Path.home() / "vms" / name / "console.log"
    if not log.is_file():
        return ""
    data = log.read_bytes()[-200_000:].decode(errors="replace")
    # Terminal control sequences (colours, OSC 3008 shell marks) are noise in a page.
    data = re.sub(r"\x1b[\]P][^\x07\x1b]*(\x07|\x1b\\)|\x1b\[[0-9;?!>=]*[A-Za-z]|\x1b[()][0-9A-Za-z]|\r", "", data)
    data = re.sub(r"[\x00-\x08\x0b-\x1f\x7f]", "", data)
    return "\n".join(data.splitlines()[-lines:])


ACTIONS = {
    "start": lambda n, b: vm("start", n, timeout=60),
    "stop": lambda n, b: vm("stop", n, timeout=150),
    "force-stop": lambda n, b: vm("stop", n, "--force"),
    "autostart-on": lambda n, b: vm("autostart", n, "on"),
    "autostart-off": lambda n, b: vm("autostart", n, "off"),
    "eject": lambda n, b: vm("set", n, "--eject"),
    "delete": lambda n, b: vm("delete", n, "--yes"),
}


def create_args(b: dict) -> list[str]:
    name = str(b.get("name", "")).strip()
    args = ["create", name]
    src = str(b.get("source", "")).strip()
    if not src:
        raise ValueError("give an ISO file, or a disk image file or URL")
    kind = "--iso" if b.get("kind") == "iso" else "--image"
    args += [kind, src]
    for key in ("disk", "memory", "cpus"):
        v = str(b.get(key, "")).strip()
        if v:
            args += [f"--{key}", v]
    if b.get("net") in ("nat", "bridge"):
        args += ["--net", b["net"]]
    for f in str(b.get("forwards", "")).replace(",", " ").split():
        args += ["--forward", f]
    if b.get("ssh_key"):
        args += ["--ssh-key"]
    if b.get("bios"):
        args += ["--bios"]
    return args


class Handler(BaseHTTPRequestHandler):
    server_version = PROG
    tok = ""

    def log_message(self, fmt, *args):  # quiet; the journal gets errors only
        pass

    # ------------------------------------------------------------- plumbing
    def authed(self, need_header: bool) -> bool:
        q = parse_qs(urlparse(self.path).query)
        cookie = SimpleCookie(self.headers.get("Cookie", ""))
        given = [q.get("token", [""])[0], cookie["vmm"].value if "vmm" in cookie else ""]
        if need_header:
            given = [self.headers.get("X-Token", "")]
        return any(g and hmac.compare_digest(g, self.tok) for g in given)

    def send(self, code: int, body: bytes, ctype: str, extra: dict | None = None):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Content-Security-Policy",
                         "default-src 'self'; script-src 'unsafe-inline'; style-src 'unsafe-inline'")
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    def json(self, code: int, obj):
        self.send(code, json.dumps(obj).encode(), "application/json")

    def body(self) -> dict:
        n = int(self.headers.get("Content-Length") or 0)
        if n > 64_000:
            raise ValueError("request too large")
        return json.loads(self.rfile.read(n) or b"{}")

    # ---------------------------------------------------------------- verbs
    def do_GET(self):
        path = urlparse(self.path).path
        if not self.authed(need_header=False):
            return self.send(403, FORBIDDEN.encode(), "text/html; charset=utf-8")
        if path == "/":
            cookie = f"vmm={self.tok}; HttpOnly; SameSite=Strict; Path=/"
            page = PAGE.replace("@TOKEN@", html.escape(self.tok)).encode()
            return self.send(200, page, "text/html; charset=utf-8", {"Set-Cookie": cookie})
        try:
            if path == "/api/vms":
                return self.json(200, {"vms": vm_json("list"), "bridge": vm_json("bridge", "status")})
            m = re.match(r"^/api/vms/([a-z0-9-]+)(/console)?$", path)
            if m and NAME_RE.match(m[1]):
                if m[2]:
                    return self.json(200, {"text": console_tail(m[1])})
                return self.json(200, vm_json("show", m[1]))
            if path == "/api/jobs":
                with JOBS_LOCK:
                    return self.json(200, sorted(JOBS.values(), key=lambda j: -j["started"])[:10])
        except (RuntimeError, ValueError) as e:
            return self.json(400, {"error": str(e)})
        self.json(404, {"error": "no such page"})

    def do_POST(self):
        if not self.authed(need_header=True):
            return self.json(403, {"error": "missing or wrong token"})
        path = urlparse(self.path).path
        try:
            b = self.body()
            if path == "/api/vms":
                args = create_args(b)
                if not NAME_RE.match(args[1]):
                    raise ValueError("names are lowercase letters, digits and dashes")
                return self.json(202, {"job": start_job(f"create {args[1]}", args)})
            m = re.match(r"^/api/vms/([a-z0-9-]+)/([a-z-]+)$", path)
            if m and NAME_RE.match(m[1]):
                name, action = m[1], m[2]
                if action == "console":
                    return self.json(200, {"ok": True, "output": console_send(name, str(b.get("text", "")))})
                if action in ACTIONS:
                    code, out = ACTIONS[action](name, b)
                    return self.json(200 if code == 0 else 400, {"ok": code == 0, "output": out})
        except (RuntimeError, ValueError) as e:
            return self.json(400, {"error": str(e)})
        self.json(404, {"error": "no such action"})


