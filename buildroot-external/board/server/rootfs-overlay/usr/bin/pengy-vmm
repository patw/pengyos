<script>
const T="@TOKEN@";let sel=null,vms=[],isos=[];
const $=id=>document.getElementById(id);
const esc=s=>String(s??"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const mib=n=>n==null?"?":n>=1<<30?(n/(1<<30)).toFixed(1)+" GiB":Math.round(n/(1<<20))+" MiB";
async function api(p,o={}){o.headers=Object.assign({"X-Token":T,"Content-Type":"application/json"},o.headers||{});const r=await fetch(p,o);const j=await r.json().catch(()=>({error:r.statusText}));if(!r.ok)throw new Error(j.error||j.output||r.statusText);return j}
const post=(p,b)=>api(p,{method:"POST",body:JSON.stringify(b||{})});
function say(id,t,bad){$(id).textContent=t||"";$(id).className="msg"+(bad?" err":"")}
async function load(){
  try{const d=await api("/api/vms");vms=d.vms;const b=d.bridge;if(!sel&&vms.length)sel=vms[0].name;
    $("bridge").textContent=b.enabled?`bridge on ${b.port}${b.up?"":" (not up)"}`:"bridge off: VMs use NAT";
    $("list").innerHTML=vms.length?vms.map(v=>`<tr data-n="${esc(v.name)}" class="${v.name==sel?"sel":""}"><td><b>${esc(v.name)}</b></td><td class="st ${esc(v.state)}">${esc(v.state)}</td><td>${v.cpus}</td><td>${esc(v.memory)}</td><td>${esc(v.net)}</td><td><code>${esc(v.ssh||"–")}</code></td><td>${v.autostart?"yes":"no"}</td></tr>`).join(""):`<tr><td colspan=7 class=msg>No VMs yet: make one below.</td></tr>`;
    document.querySelectorAll("#list tr[data-n]").forEach(r=>r.onclick=()=>{sel=r.dataset.n;load()});
    if(sel&&vms.find(v=>v.name==sel))detail(vms.find(v=>v.name==sel));else $("detail").hidden=true;
  }catch(e){say("out",e.message,true)}
}
function btn(t,a,cls,confirmText,body,msg="out"){const b=document.createElement("button");b.textContent=t;if(cls)b.className=cls;b.onclick=async()=>{if(confirmText&&!confirm(confirmText))return;b.disabled=true;say(msg,t+"…");try{const r=await post(`/api/vms/${sel}/${a}`,body);say(msg,r.output);if(a=="delete")sel=null}catch(e){say(msg,e.message,true)}b.disabled=false;load()};return b}
async function detail(v){
  $("detail").hidden=false;$("dname").textContent=v.name;const B=$("dbtns");B.innerHTML="";
  const on=v.state=="running";
  if(!on)B.append(btn("Start","start","p"));else{const s=document.createElement("button");s.textContent="Screen";s.className="p";s.onclick=()=>window.open("/screen/"+v.name,"screen-"+v.name);B.append(s);B.append(btn("Shut down","stop"));B.append(btn("Force off","force-stop","d","Pull the plug on "+v.name+"? Unsaved work in it is lost."))}
  B.append(v.autostart?btn("Don't start at boot","autostart-off"):btn("Start at boot","autostart-on"));
  if(v.iso)B.append(btn("Eject ISO","eject"));
  if(!on)B.append(btn("Delete","delete","d","Delete "+v.name+" and its disk, snapshots included? This cannot be undone."));
  const rows=[["Disk",v.disk],["ISO",v.iso],["Network",v.net+", MAC "+v.mac],["SSH",v.ssh?`${v.ssh}  (pengyos-vm ssh ${v.name})`:(v.net=="bridge"?"LAN address not known yet":"")],["Forwards",(v.forwards||[]).join(", ")],["Screen",on?`the Screen button, or a VNC viewer: ssh -N -L 5901:${v.vnc_socket} this-machine, then localhost:5901`:"start it first"],["Firmware",v.firmware.toUpperCase()]];
  $("dinfo").innerHTML=rows.filter(r=>r[1]).map(r=>`<dt>${r[0]}</dt><dd><code>${esc(r[1])}</code></dd>`).join("");
  const S=$("snaps");S.innerHTML="";const snaps=v.snapshots||[];
  if(!snaps.length)S.innerHTML=`<tr><td colspan=5 class=msg>none yet</td></tr>`;
  for(const sn of snaps.slice().reverse()){const tr=document.createElement("tr");tr.innerHTML=`<td><b>${esc(sn.name)}</b></td><td>${esc(sn.created)}</td><td>${esc(sn.taken||"–")}</td><td>${esc(sn.label)}</td><td class=row></td>`;
    tr.lastChild.append(btn("Roll back","snapshot-revert","d",`Roll ${v.name} back to ${sn.name}${sn.label?" ("+sn.label+")":""}? Every change to its disk since ${sn.created} is lost`+(on?", and it is switched off and started again.":"."),{snap:sn.name},"snapmsg"),btn("Delete","snapshot-delete","",`Delete snapshot ${sn.name}?`,{snap:sn.name},"snapmsg"));S.append(tr)}
  try{const c=await api(`/api/vms/${v.name}/console`);const p=$("con"),end=p.scrollTop+p.clientHeight>=p.scrollHeight-20;p.textContent=c.text||"(nothing on the serial console yet)";if(end)p.scrollTop=p.scrollHeight}catch(e){}
}
$("snapf").onsubmit=async e=>{e.preventDefault();say("snapmsg","taking a snapshot…");try{const r=await post(`/api/vms/${sel}/snapshot-create`,{label:$("snaplabel").value});say("snapmsg",r.output);$("snaplabel").value=""}catch(x){say("snapmsg",x.message,true)}load()};
$("conf").onsubmit=async e=>{e.preventDefault();try{await post(`/api/vms/${sel}/console`,{text:$("conin").value});$("conin").value="";setTimeout(load,600)}catch(x){say("out",x.message,true)}};
async function loadIsos(){
  try{const d=await api("/api/isos");isos=d.isos;$("isodir").textContent="("+d.dir+")";
    $("isos").innerHTML=isos.length?isos.map(i=>`<tr><td><code>${esc(i.name)}</code></td><td>${esc(i.size)}</td><td>${esc(i.added)}</td><td>${esc(i.used_by.join(", ")||"–")}</td><td><button data-rm="${esc(i.name)}" ${i.used_by.length?"disabled title='eject it from those VMs first'":""}>Remove</button></td></tr>`).join(""):`<tr><td colspan=5 class=msg>empty: upload one below, or download one from a URL</td></tr>`;
    document.querySelectorAll("[data-rm]").forEach(b=>b.onclick=async()=>{if(!confirm("Remove "+b.dataset.rm+" from the library?"))return;try{const r=await post(`/api/isos/${encodeURIComponent(b.dataset.rm)}/remove`);say("isomsg",r.output)}catch(x){say("isomsg",x.message,true)}loadIsos()});
    const cur=$("isosel").value;$("isosel").innerHTML=isos.length?isos.map(i=>`<option value="${esc(i.name)}">${esc(i.name)} (${esc(i.size)})</option>`).join(""):`<option value="">the library is empty: add an ISO below</option>`;if(cur)$("isosel").value=cur;
  }catch(e){say("isomsg",e.message,true)}
  try{const d=await api("/api/images");$("imgdir").textContent=d.dir;
    $("imgsel").innerHTML=`<option value="">${d.images.length?"(pick one, or give a path or URL below)":"none there: give a path or URL below"}</option>`+d.images.map(i=>`<option value="${esc(i.path)}">${esc(i.name)} (${mib(i.bytes)})</option>`).join("")}catch(e){}
}
$("kind").onchange=()=>{const iso=$("kind").value=="iso";$("isopick").hidden=!iso;$("imgpick").hidden=iso;$("imgurl").hidden=iso};
$("create").onsubmit=async e=>{e.preventDefault();const f=new FormData(e.target),b=Object.fromEntries(f);b.ssh_key=f.has("ssh_key");b.bios=f.has("bios");
  b.source=b.kind=="iso"?$("isosel").value:($("imgsrc").value.trim()||$("imgsel").value);delete b.iso;
  if(!b.source){say("jobs",b.kind=="iso"?"Add an ISO to the library first.":"Pick a disk image, or give a path or URL.",true);return}
  try{await post("/api/vms",b);e.target.reset();$("kind").onchange();jobs()}catch(x){say("jobs",x.message,true)}};
$("upbtn").onclick=()=>{const file=$("upfile").files[0];if(!file){say("isomsg","Pick an ISO file first.",true);return}
  const x=new XMLHttpRequest();x.open("PUT","/api/isos/"+encodeURIComponent(file.name));x.setRequestHeader("X-Token",T);
  const p=$("upprog");p.hidden=false;p.value=0;p.max=file.size;$("upbtn").disabled=true;
  x.upload.onprogress=ev=>{p.value=ev.loaded;say("isomsg",`uploading ${file.name}: ${mib(ev.loaded)} of ${mib(file.size)}`)};
  x.onloadend=()=>{p.hidden=true;$("upbtn").disabled=false;let j={};try{j=JSON.parse(x.responseText)}catch(e){}
    if(x.status==200&&j.ok){say("isomsg",j.output);$("upfile").value=""}else say("isomsg",j.error||j.output||("upload failed ("+(x.status||"connection lost")+")"),true);loadIsos()};
  x.send(file)};
$("urlbtn").onclick=async()=>{const url=$("isourl").value.trim();if(!url)return;try{await post("/api/isos",{url});$("isourl").value="";say("isomsg","downloading in the background: see Jobs");jobs()}catch(x){say("isomsg",x.message,true)}};
async function jobs(){try{const j=await api("/api/jobs");$("jobs").className="msg";
  $("jobs").textContent=j.length?j.map(x=>`${x.title}: ${x.done?(x.ok?"done":"failed"):"working…"+(x.progress?` ${mib(x.progress.done)}${x.progress.total?" of "+mib(x.progress.total):""}`:"")}${x.done&&x.output?"\n  "+x.output.replace(/\n/g,"\n  "):""}`).join("\n"):"none";
  if(j.some(x=>!x.done))setTimeout(jobs,1000);else{load();loadIsos()}}catch(e){}}
load();loadIsos();jobs();setInterval(load,4000);
</script></body></html>
