</script></body></html>
"""


def cmd_url(a) -> int:
    print(f"http://127.0.0.1:{a.port}/?token={token()}")
    return 0


def cmd_serve(a) -> int:
    Handler.tok = token()
    if a.host not in ("127.0.0.1", "::1", "localhost"):
        print(f"{PROG}: serving on {a.host}, not just this machine: the token is the only "
              f"protection and plain HTTP shows it to the network", file=sys.stderr)
    try:
        srv = ThreadingHTTPServer((a.host, a.port), Handler)
    except OSError as e:
        print(f"{PROG}: cannot listen on {a.host}:{a.port}: {e.strerror}", file=sys.stderr)
        return 1
    print(f"{PROG}: serving on http://{a.host}:{a.port}/ (open `pengy-vmm url`)", file=sys.stderr)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


def main(argv: list[str]) -> int:
    global VM_CMD
    p = argparse.ArgumentParser(prog=PROG, description="Your VMs in a browser (over pengyos-vm).")
    p.add_argument("--vm-cmd", help=argparse.SUPPRESS)
    sub = p.add_subparsers(dest="cmd", required=True)
    for name, fn in (("url", cmd_url), ("serve", cmd_serve)):
        sp = sub.add_parser(name)
        sp.add_argument("--port", type=int, default=PORT)
        sp.set_defaults(fn=fn)
        if name == "serve":
            sp.add_argument("--host", default="127.0.0.1")
    a = p.parse_args(argv)
    if a.vm_cmd:
        VM_CMD = a.vm_cmd.split()
    if os.geteuid() == 0:
        print(f"{PROG}: run it as the user whose VMs it shows, not root", file=sys.stderr)
        return 2
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
