#!/usr/bin/env python3
"""pengy-vmm - your VMs in a browser: a web page over `pengyos-vm`.

    pengy-vmm url                     the address to open (with your token)
    pengy-vmm serve [--port 5100] [--host 127.0.0.1]
    systemctl --user enable --now pengy-vmm   (serve it in the background)

Everything it does, it does by running `pengyos-vm` as you: the page is a view
of `pengyos-vm list --json` and `show --json`, and its buttons are the same
commands you would type. There is nothing here the CLI cannot do.

It listens on 127.0.0.1 only. Other people with an account on this machine
can reach that port too, so every request needs your token
(~/.config/pengy-vmm/token, 0600, made on first run): `pengy-vmm url` prints
the address with it, the page keeps it in a SameSite=Strict cookie, and
changes also need it in a header. From another machine, tunnel it:
    ssh -L 5100:127.0.0.1:5100 you@this-machine   then open `pengy-vmm url`.

The screen: /screen/NAME is a page with noVNC (/usr/share/novnc), whose
WebSocket pengy-vmm connects to the VM's private ~/vms/NAME/vnc.sock, so the
screen needs no port of its own and the same token guards it. ISOs uploaded
from the browser go into the ISO library through `pengyos-vm iso add`.

--vm-cmd PATH (test hook) runs PATH instead of /usr/bin/pengyos-vm;
--novnc-dir DIR (test hook) serves noVNC from DIR.
"""

from __future__ import annotations

import argparse
import base64
import hashlib
import hmac
import html
import json
import os
import re
import secrets
import shutil
import socket
import subprocess
import sys
import tempfile
import threading
import time
from http.cookies import SimpleCookie
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, unquote, urlparse

PROG = "pengy-vmm"
PORT = 5100
VM_CMD = ["/usr/bin/pengyos-vm"]
NAME_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,31}$")
ISO_NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$")
SNAP_RE = re.compile(r"^s[0-9]{1,6}$")
NOVNC_DIR = Path("/usr/share/novnc")
WS_GUID = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
IMAGE_SUFFIXES = (".qcow2", ".img", ".raw", ".xz", ".gz")
# Room an upload leaves free on the disk holding ~/vms.
UPLOAD_SPARE = 512 << 20
PAGE_CSP = "default-src 'self'; script-src 'unsafe-inline'; style-src 'unsafe-inline'"
SCREEN_CSP = ("default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'unsafe-inline'; "
              "img-src 'self' data: blob:; connect-src 'self'")
JOBS: dict[str, dict] = {}
JOBS_LOCK = threading.Lock()


def token_path() -> Path:
    return Path.home() / ".config" / PROG / "token"


def token() -> str:
    p = token_path()
    if not p.is_file():
        p.parent.mkdir(parents=True, exist_ok=True)
        fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(secrets.token_urlsafe(24) + "\n")
    return p.read_text().strip()


def vm(*args: str, timeout: float = 60) -> tuple[int, str]:
    """Run pengyos-vm; (exit code, stdout+stderr)."""
    try:
        cp = subprocess.run(VM_CMD + list(args), capture_output=True, text=True,
                            stdin=subprocess.DEVNULL, timeout=timeout)
    except subprocess.TimeoutExpired:
        return 124, f"pengyos-vm {args[0]} took longer than {timeout:.0f}s"
    return cp.returncode, (cp.stdout + cp.stderr).strip()


def vm_json(*args: str):
    code, out = vm(*args, "--json")
    if code != 0:
        raise RuntimeError(out)
    return json.loads(out)


def vm_home() -> Path:
    return Path.home() / "vms"


def start_job(title: str, args: list[str]) -> str:
    """A slow command (create, iso add) in the background. A `--progress` line
    ({"step": "download", "done": N, "total": T}) updates the job's progress."""
    jid = secrets.token_hex(4)
    with JOBS_LOCK:
        JOBS[jid] = {"id": jid, "title": title, "done": False, "ok": None, "output": "",
                     "progress": None, "started": time.time()}

    def work():
        lines = []
        try:
            p = subprocess.Popen(VM_CMD + list(args), stdout=subprocess.PIPE,
                                 stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, text=True)
        except OSError as e:
            with JOBS_LOCK:
                JOBS[jid].update(done=True, ok=False, output=str(e))
            return
        for line in p.stdout:
            try:
                msg = json.loads(line)
            except ValueError:
                msg = None
            if isinstance(msg, dict) and msg.get("step") == "download":
                with JOBS_LOCK:
                    JOBS[jid]["progress"] = {"done": msg.get("done"), "total": msg.get("total")}
            elif isinstance(msg, dict) and msg.get("step") == "done":
                lines.append(f"added {msg.get('name')}")
            else:
                lines.append(line.rstrip("\n"))
        code = p.wait()
        with JOBS_LOCK:
            JOBS[jid].update(done=True, ok=code == 0, output="\n".join(lines).strip())

    threading.Thread(target=work, daemon=True).start()
    return jid


def console_send(name: str, text: str) -> str:
    """Type a line into a VM's serial console (as `pengyos-vm console` would)."""
    sock = Path.home() / "vms" / name / "serial.sock"
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        s.connect(str(sock))
        s.sendall(text.encode() + b"\r")
        time.sleep(0.3)
    except OSError as e:
        raise RuntimeError(f"cannot reach {name}'s console ({e.strerror}); "
                           f"is it running, or is a `pengyos-vm console` open?")
    finally:
        s.close()
    return "sent"


def console_tail(name: str, lines: int = 200) -> str:
    log = Path.home() / "vms" / name / "console.log"
    if not log.is_file():
        return ""
    data = log.read_bytes()[-200_000:].decode(errors="replace")
    # Terminal control sequences (colours, OSC 3008 shell marks) are noise in a page.
    data = re.sub(r"\x1b[\]P][^\x07\x1b]*(\x07|\x1b\\)|\x1b\[[0-9;?!>=]*[A-Za-z]|\x1b[()][0-9A-Za-z]|\r", "", data)
    data = re.sub(r"[\x00-\x08\x0b-\x1f\x7f]", "", data)
    return "\n".join(data.splitlines()[-lines:])


def disk_images() -> list[dict]:
    """Disk images to pick from in New VM: the files in ~/vms/images."""
    d = vm_home() / "images"
    if not d.is_dir():
        return []
    return [{"name": f.name, "path": str(f), "bytes": f.stat().st_size}
            for f in sorted(d.iterdir(), key=lambda p: p.name.lower())
            if f.is_file() and f.name.endswith(IMAGE_SUFFIXES)]


def snap_arg(b: dict) -> str:
    snap = str(b.get("snap", ""))
    if not SNAP_RE.match(snap):
        raise ValueError("which snapshot? (s1, s2, ...)")
    return snap


ACTIONS = {
    "start": lambda n, b: vm("start", n, timeout=60),
    "stop": lambda n, b: vm("stop", n, timeout=150),
    "force-stop": lambda n, b: vm("stop", n, "--force"),
    "autostart-on": lambda n, b: vm("autostart", n, "on"),
    "autostart-off": lambda n, b: vm("autostart", n, "off"),
    "eject": lambda n, b: vm("set", n, "--eject"),
    "delete": lambda n, b: vm("delete", n, "--yes"),
    "snapshot-create": lambda n, b: vm("snapshot", n, "create",
                                       *str(b.get("label", "")).split()[:20], timeout=120),
    "snapshot-revert": lambda n, b: vm("snapshot", n, "revert", snap_arg(b), "--yes", timeout=180),
    "snapshot-delete": lambda n, b: vm("snapshot", n, "delete", snap_arg(b), timeout=120),
}


def create_args(b: dict) -> list[str]:
    name = str(b.get("name", "")).strip()
    args = ["create", name]
    src = str(b.get("source", "")).strip()
    if not src:
        raise ValueError("give an ISO file, or a disk image file or URL")
    kind = "--iso" if b.get("kind") == "iso" else "--image"
    args += [kind, src]
    for key in ("disk", "memory", "cpus"):
        v = str(b.get(key, "")).strip()
        if v:
            args += [f"--{key}", v]
    if b.get("net") in ("nat", "bridge"):
        args += ["--net", b["net"]]
    for f in str(b.get("forwards", "")).replace(",", " ").split():
        args += ["--forward", f]
    if b.get("ssh_key"):
        args += ["--ssh-key"]
    if b.get("bios"):
        args += ["--bios"]
    return args


class Handler(BaseHTTPRequestHandler):
    server_version = PROG
    tok = ""

    def log_message(self, fmt, *args):  # quiet; the journal gets errors only
        pass

    # ------------------------------------------------------------- plumbing
    def authed(self, need_header: bool) -> bool:
        q = parse_qs(urlparse(self.path).query)
        cookie = SimpleCookie(self.headers.get("Cookie", ""))
        given = [q.get("token", [""])[0], cookie["vmm"].value if "vmm" in cookie else ""]
        if need_header:
            given = [self.headers.get("X-Token", "")]
        return any(g and hmac.compare_digest(g, self.tok) for g in given)

    def send(self, code: int, body: bytes, ctype: str, extra: dict | None = None,
             csp: str = PAGE_CSP):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Content-Security-Policy", csp)
        for k, v in (extra or {}).items():
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(body)

    def json(self, code: int, obj):
        self.send(code, json.dumps(obj).encode(), "application/json")

    def body(self) -> dict:
        n = int(self.headers.get("Content-Length") or 0)
        if n > 64_000:
            raise ValueError("request too large")
        return json.loads(self.rfile.read(n) or b"{}")

    # ---------------------------------------------------------------- verbs
    def do_GET(self):
        path = urlparse(self.path).path
        if not self.authed(need_header=False):
            return self.send(403, FORBIDDEN.encode(), "text/html; charset=utf-8")
        if path == "/":
            cookie = f"vmm={self.tok}; HttpOnly; SameSite=Strict; Path=/"
            page = PAGE.replace("@TOKEN@", html.escape(self.tok)).encode()
            return self.send(200, page, "text/html; charset=utf-8", {"Set-Cookie": cookie})
        if path.startswith("/novnc/"):
            return self.static_novnc(path[len("/novnc/"):])
        m = re.match(r"^/screen/([a-z0-9-]+)$", path)
        if m and NAME_RE.match(m[1]):
            page = SCREEN.replace("@NAME@", m[1]).encode()
            return self.send(200, page, "text/html; charset=utf-8", csp=SCREEN_CSP)
        m = re.match(r"^/api/vms/([a-z0-9-]+)/vnc$", path)
        if m and NAME_RE.match(m[1]):
            return self.ws_proxy(m[1])
        try:
            if path == "/api/isos":
                return self.json(200, vm_json("iso", "list"))
            if path == "/api/images":
                return self.json(200, {"dir": str(vm_home() / "images"), "images": disk_images()})
            m = re.match(r"^/api/vms/([a-z0-9-]+)/snapshots$", path)
            if m and NAME_RE.match(m[1]):
                return self.json(200, vm_json("snapshot", m[1], "list"))
            if path == "/api/vms":
                return self.json(200, {"vms": vm_json("list"), "bridge": vm_json("bridge", "status")})
            m = re.match(r"^/api/vms/([a-z0-9-]+)(/console)?$", path)
            if m and NAME_RE.match(m[1]):
                if m[2]:
                    return self.json(200, {"text": console_tail(m[1])})
                return self.json(200, vm_json("show", m[1]))
            if path == "/api/jobs":
                with JOBS_LOCK:
                    return self.json(200, sorted(JOBS.values(), key=lambda j: -j["started"])[:10])
        except (RuntimeError, ValueError) as e:
            return self.json(400, {"error": str(e)})
        self.json(404, {"error": "no such page"})

    def do_POST(self):
        if not self.authed(need_header=True):
            return self.json(403, {"error": "missing or wrong token"})
        path = urlparse(self.path).path
        try:
            b = self.body()
            if path == "/api/isos":            # add by URL, in the background
                url = str(b.get("url", "")).strip()
                if not re.match(r"^https?://\S+$", url):
                    raise ValueError("give an http(s) URL")
                args = ["iso", "add", url, "--progress"]
                name = str(b.get("name", "")).strip()
                if name:
                    if not ISO_NAME_RE.match(name):
                        raise ValueError("ISO names are letters, digits and . _ + -")
                    args += ["--name", name]
                return self.json(202, {"job": start_job(f"download {name or url.rsplit('/', 1)[-1]}", args)})
            m = re.match(r"^/api/isos/([^/]+)/remove$", path)
            if m:
                name = unquote(m[1])
                if not ISO_NAME_RE.match(name):
                    raise ValueError("no such ISO")
                code, out = vm("iso", "remove", name)
                return self.json(200 if code == 0 else 400, {"ok": code == 0, "output": out})
            if path == "/api/vms":
                args = create_args(b)
                if not NAME_RE.match(args[1]):
                    raise ValueError("names are lowercase letters, digits and dashes")
                return self.json(202, {"job": start_job(f"create {args[1]}", args)})
            m = re.match(r"^/api/vms/([a-z0-9-]+)/([a-z-]+)$", path)
            if m and NAME_RE.match(m[1]):
                name, action = m[1], m[2]
                if action == "console":
                    return self.json(200, {"ok": True, "output": console_send(name, str(b.get("text", "")))})
                if action in ACTIONS:
                    code, out = ACTIONS[action](name, b)
                    return self.json(200 if code == 0 else 400, {"ok": code == 0, "output": out})
        except (RuntimeError, ValueError) as e:
            return self.json(400, {"error": str(e)})
        self.json(404, {"error": "no such action"})


    def do_PUT(self):
        """Upload an ISO into the library: PUT /api/isos/NAME, the file as the body."""
        if not self.authed(need_header=True):
            return self.json(403, {"error": "missing or wrong token"})
        m = re.match(r"^/api/isos/([^/]+)$", urlparse(self.path).path)
        if not m:
            return self.json(404, {"error": "no such page"})
        name = unquote(m[1])
        if not ISO_NAME_RE.match(name):
            return self.json(400, {"error": "ISO names are letters, digits and . _ + - (up to 128)"})
        try:
            size = int(self.headers.get("Content-Length") or "")
        except ValueError:
            size = 0
        if size <= 0:
            return self.json(411, {"error": "the upload needs a Content-Length"})
        home = vm_home()
        home.mkdir(mode=0o700, exist_ok=True)
        free = shutil.disk_usage(home).free
        if size + UPLOAD_SPARE > free:
            self.close_connection = True
            return self.json(507, {"error": f"{name} is {size >> 20} MiB; {free >> 20} MiB is free "
                                            f"in {home}, and uploads leave {UPLOAD_SPARE >> 20} MiB"})
        # Staged in ~/vms (the library's filesystem, so `iso add` hard-links it) and
        # handed to pengyos-vm, which checks it is an ISO and owns the library.
        staging = Path(tempfile.mkdtemp(prefix=".pengy-vmm-upload-", dir=home))
        try:
            part = staging / name
            left = size
            with open(part, "wb") as w:
                while left:
                    chunk = self.rfile.read(min(left, 1 << 20))
                    if not chunk:
                        break
                    w.write(chunk)
                    left -= len(chunk)
            if left:
                self.close_connection = True
                return self.json(400, {"error": f"the upload of {name} stopped short; nothing was kept"})
            code, out = vm("iso", "add", str(part), "--name", name, timeout=900)
            return self.json(200 if code == 0 else 400, {"ok": code == 0, "output": out})
        finally:
            shutil.rmtree(staging, ignore_errors=True)

    def static_novnc(self, rel: str):
        base = NOVNC_DIR.resolve()
        try:
            p = (base / unquote(rel)).resolve()
        except (OSError, ValueError):
            p = base
        if base not in p.parents or not p.is_file():
            return self.json(404, {"error": "no such file"})
        ctype = {".js": "text/javascript; charset=utf-8", ".json": "application/json"}.get(
            p.suffix, "application/octet-stream")
        return self.send(200, p.read_bytes(), ctype)

    def ws_proxy(self, name: str):
        """The screen: a WebSocket (RFC 6455) relayed to ~/vms/NAME/vnc.sock."""
        if self.headers.get("Upgrade", "").lower() != "websocket" or \
                not self.headers.get("Sec-WebSocket-Key"):
            return self.json(400, {"error": "this is the VNC WebSocket; open /screen/" + name})
        # The cookie is SameSite=Strict already; a WebSocket from another site
        # must not ride on it either.
        origin, host = self.headers.get("Origin"), self.headers.get("Host", "")
        if origin and origin not in (f"http://{host}", f"https://{host}"):
            return self.json(403, {"error": "the screen opens only from this page"})
        u = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            u.connect(str(vm_home() / name / "vnc.sock"))
        except OSError:
            u.close()
            return self.json(409, {"error": f"{name} is not running (or has no screen yet)"})
        key = self.headers["Sec-WebSocket-Key"].strip()
        accept = base64.b64encode(hashlib.sha1((key + WS_GUID).encode()).digest()).decode()
        self.send_response(101, "Switching Protocols")
        self.send_header("Upgrade", "websocket")
        self.send_header("Connection", "Upgrade")
        self.send_header("Sec-WebSocket-Accept", accept)
        protos = [x.strip() for x in self.headers.get("Sec-WebSocket-Protocol", "").split(",")]
        if "binary" in protos:
            self.send_header("Sec-WebSocket-Protocol", "binary")
        self.end_headers()
        self.wfile.flush()
        self.close_connection = True
        conn, lock = self.connection, threading.Lock()

        def frame(op: int, data: bytes = b"") -> None:
            n = len(data)
            head = bytes([0x80 | op])
            if n < 126:
                head += bytes([n])
            elif n < 1 << 16:
                head += bytes([126]) + n.to_bytes(2, "big")
            else:
                head += bytes([127]) + n.to_bytes(8, "big")
            with lock:
                conn.sendall(head + data)

        def vnc_to_browser():
            try:
                while data := u.recv(1 << 16):
                    frame(0x2, data)
                frame(0x8, (1000).to_bytes(2, "big"))
            except OSError:
                pass
            try:
                conn.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass

        t = threading.Thread(target=vnc_to_browser, daemon=True)
        t.start()
        rf = self.rfile
        try:
            while True:
                head = rf.read(2)
                if len(head) < 2:
                    break
                op, masked, n = head[0] & 0x0F, head[1] & 0x80, head[1] & 0x7F
                if n == 126:
                    n = int.from_bytes(rf.read(2), "big")
                elif n == 127:
                    n = int.from_bytes(rf.read(8), "big")
                if not masked or n > 1 << 24:     # clients must mask; RFB messages are small
                    break
                mask = rf.read(4)
                data = rf.read(n)
                if len(data) < n:
                    break
                data = unmask(data, mask)
                if op == 0x8:
                    frame(0x8, data[:2])
                    break
                if op == 0x9:
                    frame(0xA, data)
                elif op in (0x0, 0x1, 0x2):
                    u.sendall(data)
        except OSError:
            pass
        finally:
            try:
                u.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass
            u.close()
            t.join(2)


def unmask(data: bytes, mask: bytes) -> bytes:
    n = len(data)
    if not n:
        return data
    key = (mask * (n // 4 + 1))[:n]
    return (int.from_bytes(data, "big") ^ int.from_bytes(key, "big")).to_bytes(n, "big")


FORBIDDEN = """<!doctype html><meta charset=utf-8><title>pengy-vmm</title>
<body style="font-family:sans-serif;max-width:40em;margin:3em auto">
<h1>pengy-vmm needs your token</h1>
<p>Run <code>pengy-vmm url</code> on the machine and open the address it prints.</p>"""

PAGE = r"""<!doctype html>
