SCREEN = r"""<!doctype html>
<html lang=en><head><meta charset=utf-8><meta name=viewport content="width=device-width,initial-scale=1">
<title>@NAME@ — screen</title>
<style>
:root{--bg:#14171c;--bar:#1c2027;--ink:#e7eaf0;--mute:#9aa3b2;--line:#2b313b;--acc:#6b9bff;--bad:#ff6b61}
*{box-sizing:border-box}html,body{height:100%;margin:0}body{display:flex;flex-direction:column;background:var(--bg);color:var(--ink);font:14px/1.4 system-ui,sans-serif}
header{display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding:8px 12px;background:var(--bar);border-bottom:1px solid var(--line)}
header b{font-size:15px}#st{color:var(--mute)}#st.bad{color:var(--bad)}.sp{flex:1}
button,label{font:inherit;color:var(--ink)}button{padding:4px 10px;border-radius:7px;border:1px solid var(--line);background:var(--bg);cursor:pointer}
a{color:var(--acc)}#screen{flex:1;min-height:0;overflow:hidden;background:#000}
</style></head><body>
<header><b>@NAME@</b><span id=st>connecting…</span><span class=sp></span>
<button id=cad title="send Ctrl+Alt+Del to the VM">Ctrl+Alt+Del</button>
<label><input type=checkbox id=scale checked> fit to window</label>
<button id=again hidden>Reconnect</button><a href="/">all VMs</a></header>
<div id=screen></div>
<script type=module>
import RFB from "/novnc/core/rfb.js";
const st=document.getElementById("st");let rfb=null;
function connect(){
  const url=(location.protocol=="https:"?"wss://":"ws://")+location.host+"/api/vms/@NAME@/vnc";
  rfb=new RFB(document.getElementById("screen"),url,{wsProtocols:["binary"]});
  rfb.scaleViewport=document.getElementById("scale").checked;rfb.focusOnClick=true;
  rfb.addEventListener("connect",()=>{st.textContent="connected: click the screen to type into it";st.className="";document.getElementById("again").hidden=true;rfb.focus()});
  rfb.addEventListener("disconnect",e=>{st.textContent=e.detail.clean?"disconnected":"could not connect: is the VM running?";st.className="bad";document.getElementById("again").hidden=false});
  rfb.addEventListener("desktopname",e=>{document.title="@NAME@ — "+e.detail.name});
}
document.getElementById("cad").onclick=()=>rfb&&rfb.sendCtrlAltDel();
document.getElementById("scale").onchange=e=>{if(rfb)rfb.scaleViewport=e.target.checked};
document.getElementById("again").onclick=()=>{if(rfb)try{rfb.disconnect()}catch(e){}connect()};
connect();
</script></body></html>
"""


def cmd_url(a) -> int:
    print(f"http://127.0.0.1:{a.port}/?token={token()}")
    return 0


def cmd_serve(a) -> int:
    Handler.tok = token()
    if a.host not in ("127.0.0.1", "::1", "localhost"):
        print(f"{PROG}: serving on {a.host}, not just this machine: the token is the only "
              f"protection and plain HTTP shows it to the network", file=sys.stderr)
    try:
        srv = ThreadingHTTPServer((a.host, a.port), Handler)
    except OSError as e:
        print(f"{PROG}: cannot listen on {a.host}:{a.port}: {e.strerror}", file=sys.stderr)
        return 1
    print(f"{PROG}: serving on http://{a.host}:{a.port}/ (open `pengy-vmm url`)", file=sys.stderr)
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


def main(argv: list[str]) -> int:
    global VM_CMD, NOVNC_DIR
    p = argparse.ArgumentParser(prog=PROG, description="Your VMs in a browser (over pengyos-vm).")
    p.add_argument("--vm-cmd", help=argparse.SUPPRESS)
    p.add_argument("--novnc-dir", help=argparse.SUPPRESS)
    sub = p.add_subparsers(dest="cmd", required=True)
    for name, fn in (("url", cmd_url), ("serve", cmd_serve)):
        sp = sub.add_parser(name)
        sp.add_argument("--port", type=int, default=PORT)
        sp.set_defaults(fn=fn)
        if name == "serve":
            sp.add_argument("--host", default="127.0.0.1")
    a = p.parse_args(argv)
    if a.vm_cmd:
        VM_CMD = a.vm_cmd.split()
    if a.novnc_dir:
        NOVNC_DIR = Path(a.novnc_dir)
    if os.geteuid() == 0:
        print(f"{PROG}: run it as the user whose VMs it shows, not root", file=sys.stderr)
        return 2
    return a.fn(a)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
