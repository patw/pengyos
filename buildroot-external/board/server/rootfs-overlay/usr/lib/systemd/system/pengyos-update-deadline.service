# PengyOS — a trial boot of a new system must confirm within 15 minutes.
#
# Runs only when GRUB booted a new slot once (`pengyos.trial=1`, see
# pengyos-update). If `pengyos-update confirm` has not kept it by then (a unit
# that hangs the boot, a boot that never reaches multi-user.target), it
# restarts the machine, which boots the previous system: the old slot is still
# the default. Cancel it on a trial you are debugging at the console with
#   sudo systemctl stop pengyos-update-deadline
# Wanted statically from sysinit.target, so it starts as early as it can.
[Unit]
Description=Restart into the previous PengyOS if this trial boot does not confirm
DefaultDependencies=no
ConditionKernelCommandLine=pengyos.trial=1
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=exec
ExecStart=/usr/lib/pengyos/update-trial-reboot deadline 900
