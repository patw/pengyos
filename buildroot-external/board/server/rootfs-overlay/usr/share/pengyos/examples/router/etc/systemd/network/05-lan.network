# LAN: a fixed address, and a /64 from the WAN's delegated prefix. dnsmasq
# sends the router advertisements (dnsmasq.conf: dhcp-range=::,constructor:lan0),
# so networkd's own RA and DHCP server stay off.
[Match]
Name=lan0

[Network]
Address=192.168.50.1/24
IPv6AcceptRA=no
IPv6SendRA=no
DHCPServer=no
DHCPPrefixDelegation=yes
ConfigureWithoutCarrier=yes

[DHCPPrefixDelegation]
UplinkInterface=wan0
SubnetId=0
Announce=no
Assign=yes
Token=::1
