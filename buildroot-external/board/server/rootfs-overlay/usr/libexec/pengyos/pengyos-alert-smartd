#!/bin/sh
# smartd's alert hook (/etc/smartd.conf: `-M exec` this). smartd runs it with
# the -m address as the argument and the problem in SMARTD_* variables;
# pengyos-alert reads those and sends it over ntfy/mail (/etc/pengyos/alert.conf).
# stdout is dropped: smartd logs any output from its hook as "produced
# unexpected output" (seen with `-M test` on behothinkpad). Errors stay on
# stderr, where smartd's log should show them; the alert itself is journaled.
exec /usr/bin/pengyos-alert smartd >/dev/null
