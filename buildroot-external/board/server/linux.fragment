# ============================================================================
# PengyOS Server — Linux kernel config fragment (systemd requirements)
# ----------------------------------------------------------------------------
# Stacked AFTER Core's fragment (board/core/linux.fragment) by the
# defconfig layers (configs/layers/): Server gets all of Core's kernel. The
# symbols below repeat Core's systemd requirements (harmless — same values);
# Server-only kernel additions go here.
#
# A kernel fragment is a plain list of CONFIG_= assignments (kconfig syntax).
# ============================================================================

# --- devtmpfs / tmpfs (systemd hard requirements) ---------------------------
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y

# --- Serial console (QEMU default UART) -------------------------------------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y

# --- virtio block/net for QEMU ----------------------------------------------
CONFIG_VIRTIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_PCI=y

# --- Filesystem -------------------------------------------------------------
CONFIG_EXT4_FS=y

# --- Modules / networking basics --------------------------------------------
CONFIG_MODULES=y
CONFIG_NET=y

# --- The partition & state layout (docs/state-layout.md) ----------------------
# Installed systems boot through preinit (the kernel's init=), which mounts the
# btrfs data partition and overlays /etc before any module could be loaded —
# so btrfs and overlayfs are built in.
CONFIG_BTRFS_FS=y
CONFIG_OVERLAY_FS=y
# efivarfs built in, so the /sys/firmware/efi/efivars mount works (the
# installer's efibootmgr, fwupd, bootctl need it; as a module it never mounted).
CONFIG_EFIVAR_FS=y

# --- Virtualization host: KVM for QEMU (2026-10-11) ----------------------------
# Server and Desktop ship QEMU (server.config); without KVM it could only
# emulate. vhost for fast virtio networking/vsock, macvtap for guests on the LAN,
# VFIO for PCI passthrough. MITIGATION_VMSCAPE (default y with KVM) closes the
# "VMSCAPE: Vulnerable" boot line.
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_KVM_AMD=m
CONFIG_VHOST_NET=m
CONFIG_VSOCKETS=m
CONFIG_VHOST_VSOCK=m
CONFIG_MACVLAN=m
CONFIG_MACVTAP=m
CONFIG_VFIO=m
CONFIG_VFIO_PCI=m

# --- Gaps found against a distro kernel (2026-10-17) ----------------------------
# SR-IOV: a server NIC's (or GPU's) virtual functions, for VMs and containers.
CONFIG_PCI_IOV=y
# SMB/CIFS client: `mount -t cifs` for Windows and NAS shares (the Desktop's file
# manager goes through gvfs/libsmbclient instead, but fstab mounts need this).
CONFIG_CIFS=m

# --- An unattended box: health, watchdog, VM guest, GPU (2026-10-25) -----------
# Measured against the 26.10.40 Server kernel next to the Desktop's: these had
# landed in desktop/linux.fragment, but a server needs them more. Moved here
# (Desktop inherits them) rather than duplicated.
# Health (US-SRV-3): CPU package power (RAPL) and Intel CPU temperature
# (coretemp; AMD's k10temp was already on), NVMe and SATA drive temperatures as
# hwmon sensors. node_exporter showed no CPU or disk temperature on an Intel box.
CONFIG_POWERCAP=y
CONFIG_INTEL_RAPL=m
CONFIG_SENSORS_CORETEMP=m
CONFIG_NVME_HWMON=y
CONFIG_SENSORS_DRIVETEMP=m
# Hardware watchdogs: the chipset's iTCO (Intel) and the FCH's sp5100_tco (AMD),
# so systemd's RuntimeWatchdogSec can reset a hung, unattended machine. The
# Server had no watchdog driver at all.
CONFIG_ITCO_WDT=m
CONFIG_SP5100_TCO=m
# As a VM guest. virtio was covered (KVM/Proxmox/QEMU); on Hyper-V (and Azure) a
# Generation 2 VM's disk, network, console and keyboard are VMBus devices, so the
# Server could not even see its own disk. hv_utils is the host's clean shutdown,
# time sync and heartbeat. VMGENID tells the kernel a VM was cloned or restored
# from a snapshot so the RNG reseeds instead of repeating itself.
CONFIG_VIRT_DRIVERS=y
CONFIG_VMGENID=y
CONFIG_HYPERV=y
CONFIG_HYPERV_UTILS=m
CONFIG_HYPERV_STORAGE=m
CONFIG_HYPERV_NET=m
CONFIG_HYPERV_KEYBOARD=m
CONFIG_DRM_HYPERV=m
# GPU: Lunar Lake / Panther Lake iGPUs and Arc B-series (Battlemage) are driven
# by xe only (i915 does not bind them). US-SRV-9 transcodes on /dev/dri, and the
# Arc cards are the usual transcoding card. Firmware: server.config.
CONFIG_DRM_XE=m
