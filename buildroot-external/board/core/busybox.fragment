# --- Not an initramfs: the early-boot and embedded applets -------------------
# PengyOS has no initramfs (the kernel boots straight into systemd) and no
# sysvinit, so the applets that exist to hand a booting system over, to run a
# tiny init, or to drive MTD/floppy/serial/console plumbing have no job here.
# CONFIG_LINUXRC is not set
# CONFIG_RUN_INIT is not set
# CONFIG_PIVOT_ROOT is not set
# CONFIG_SWITCH_ROOT is not set
# CONFIG_RESUME is not set
# CONFIG_NUKE is not set
# CONFIG_PIPE_PROGRESS is not set
# CONFIG_MAKEDEVS is not set
# CONFIG_MDEV is not set
# CONFIG_UEVENT is not set
# CONFIG_RUNLEVEL is not set
# CONFIG_MT is not set
# CONFIG_PARTPROBE is not set
# CONFIG_SETSERIAL is not set
# CONFIG_FDFORMAT is not set
# CONFIG_FDFLUSH is not set
# CONFIG_FREERAMDISK is not set
# CONFIG_UBIRENAME is not set
# CONFIG_DEVMEM is not set
# CONFIG_SEEDRNG is not set
# CONFIG_I2CGET is not set
# CONFIG_I2CSET is not set
# CONFIG_I2CDUMP is not set
# CONFIG_I2CDETECT is not set
# CONFIG_I2CTRANSFER is not set
# CONFIG_ETHER_WAKE is not set
# CONFIG_NAMEIF is not set
# CONFIG_VCONFIG is not set
# CONFIG_RDATE is not set
# CONFIG_SETLOGCONS is not set
# CONFIG_SETCONSOLE is not set
# CONFIG_LOADFONT is not set
# CONFIG_LOADKMAP is not set
# CONFIG_DUMPKMAP is not set
# CONFIG_SETKEYCODES is not set
# CONFIG_SVC is not set
# CONFIG_SVOK is not set
# CONFIG_FEATURE_USE_INITTAB is not set

# --- No daemons BusyBox is not the right implementation of -------------------
# systemd-networkd does DHCP (board/core/rootfs-overlay/etc/systemd/network),
# systemd-journald does logging, and the image ships no telnet/inetd/dns server.
# CONFIG_UDHCPC is not set
# CONFIG_FEATURE_UDHCPC_ARPING is not set
# CONFIG_FEATURE_UDHCP_PORT is not set
# CONFIG_SYSLOGD is not set
# CONFIG_KLOGD is not set
# CONFIG_TELNET is not set
# CONFIG_TFTP is not set
# CONFIG_INETD is not set
# CONFIG_DNSD is not set
# CONFIG_SSL_SERVER is not set
# CONFIG_VLOCK is not set

# --- BusyBox wget: make HTTPS real -------------------------------------------
# The Core image has no curl (that is the Server's); busybox wget was the only
# downloader and it could not verify a certificate, so every `wget https://...`
# either failed or was run with the check off. CONFIG_TLS is already on; this
# makes wget use OpenSSL, which Core ships anyway.
CONFIG_FEATURE_WGET_OPENSSL=y
CONFIG_FEATURE_WGET_LONG_OPTIONS=y
CONFIG_FEATURE_WGET_STATUSBAR=y
