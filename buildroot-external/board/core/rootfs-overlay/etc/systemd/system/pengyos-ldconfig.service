# Keep /etc/ld.so.cache in step with the slot that booted. The cache lives in
# /etc (the writable overlay on data) and records full paths, while each boot
# may run a different read-only /usr (A/B update or rollback). systemd's own
# ldconfig.service (off in Buildroot) runs only when /usr is newer than /etc,
# which misses a rollback to an older slot, so this runs at every boot.
#
# The loader alone would manage without a cache (it searches /usr/lib), but
# software that looks libraries up does not: `ldconfig -p` exits 1 with no cache,
# so Python's ctypes.util.find_library returns None for every library (there is
# no gcc or ld to fall back on), and Triton (torch.compile), numba and CuPy die
# looking for libcuda. So the cache is always built; it takes ~40 ms. A cache
# left by the other slot is harmless before this runs: its paths are the same
# /usr/lib names, and a path that has gone makes the loader search instead.
# -X: never create soname links (/usr is read-only).
[Unit]
Description=Rebuild the dynamic loader cache for the slot that booted
DefaultDependencies=no
Conflicts=shutdown.target
After=local-fs.target systemd-tmpfiles-setup.service
Before=sysinit.target shutdown.target systemd-update-done.service

[Service]
Type=oneshot
ExecStart=/usr/bin/ldconfig -X

[Install]
WantedBy=sysinit.target
