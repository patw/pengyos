#!/bin/sh
# PengyOS stub: 'mkfs.xfs' is intentionally not shipped on this image.
# It ships a helpful pointer so an agent (or a human) knows the alternative.
cat >&2 <<'MSG'
PengyOS: 'mkfs.xfs' is not installed in this image.
  instead, use: mkfs.ext4 / mkfs.btrfs / mkfs.exfat / mkfs.vfat
MSG
exit 127
