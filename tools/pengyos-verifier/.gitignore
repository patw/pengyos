# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
# NOTE: the scaffold's generic `build/` rule also matches
# tests/fixtures/build/ — the committed fixture tree is un-ignored by
# the explicit negation below (tests pin it, so a silent re-ignore
# would break the suite).
build/
!tests/fixtures/build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/

# Generated reports / inspected build outputs are not source
report.json
build-output/
