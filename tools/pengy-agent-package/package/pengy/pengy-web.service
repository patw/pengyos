[Unit]
Description=PengyR headless web agent (pengy-web)
Documentation=https://github.com/patw/PengyR
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/pengy-web --config /etc/pengy/settings.json
Restart=on-failure
RestartSec=5
# Core is headless: run the agent unprivileged, never as root.
DynamicUser=yes
NoNewPrivileges=yes
# Filesystem and kernel hardening.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
StateDirectory=pengy
ProtectKernelTrees=yes
ProtectControlGroups=yes

[Install]
WantedBy=multi-user.target
