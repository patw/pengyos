# systemd — the init / service manager PengyOS uses.
# Single concern: the kernel features systemd's userspace expects to be on.
CONFIG_SYSTEMD=y
CONFIG_CGROUPS=y
CONFIG_CGROUPS_V2=y
CONFIG_EPOLL=y
CONFIG_INOTIFY=y
CONFIG_INOTIFY_USER=y
CONFIG_EPHEMERAL_DIRS=y
CONFIG_TMPFS=y
CONFIG_OVERLAY_FS=y
CONFIG_NET=y
CONFIG_INET=y
