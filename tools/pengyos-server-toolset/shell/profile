# profile — PengyOS Server remote-admin comfort profile (US-SRV-1)
#
# A curated, idempotent login profile for the comfort CLI/shell pack. It:
#   * puts the local bin dirs on PATH (deduped, so re-sourcing never bloats it),
#   * defines friendly aliases (eza for ls, bat for cat),
#   * loads the Starship prompt,
#   * loads fzf keybindings + completion,
#   * loads zoxide,
#   * makes NO network call at shell start (only `command -v` + local sourcing),
#   * is POSIX-sh so it survives `sh -n` and is safe under `set -eu`.
#
# It works under both bash and zsh. The image installs it at
# /etc/pengyos/shell/profile and wires it system-wide (/etc/zshrc and
# /etc/profile.d source it; /etc/skel/.zshrc and .bashrc source it for new
# accounts). To source it from your own rc:
#   bash -> ~/.bashrc:    . /etc/pengyos/shell/profile
#   zsh  -> ~/.zshrc:     . /etc/pengyos/shell/profile
#
# The sibling init snippets (fzf.sh / zoxide.sh) are found via $PENGYOS_SHELL_DIR
# when set, otherwise by auto-detecting this file's own directory (bash:
# $BASH_SOURCE[0], zsh: $0).

# --- interactive only ------------------------------------------------------
# Aliases and prompt setup only matter for an interactive shell. Checked before
# the guard, so a non-interactive login (`sh -l`, `ssh host cmd`) sets nothing.
case "$-" in
    *i*) : ;;
    *) return 0 2>/dev/null || true ;;
esac

# --- idempotency guard -----------------------------------------------------
# A sourced file may be read more than once per shell (/etc/zshrc, then
# ~/.zshrc); guard the body so it runs at most once per shell. The marker is a
# plain shell variable and deliberately NOT exported: aliases, functions, ZLE
# widgets and the prompt hooks are not inherited, so every child shell (a tmux
# pane, `zsh` typed in bash, a terminal opened from a shell) must run the body
# itself. An exported marker made all of those skip it.
if [ -n "${PENGYOS_TOOLSET_PROFILE_RC:-}" ]; then
    return 0 2>/dev/null || true
fi
PENGYOS_TOOLSET_PROFILE_RC=1

# --- locate the sibling init snippets --------------------------------------
# Prefer an explicit override; otherwise auto-detect this file's directory
# (bash: $BASH_SOURCE[0], zsh/other: $0). Both are read at the top level, so
# $0 is the sourced path, not a function name.
if [ -z "$PENGYOS_SHELL_DIR" ]; then
    if [ -n "${BASH_VERSION:-}" ]; then
        _profile_path="${BASH_SOURCE[0]}"
    else
        _profile_path="$0"
    fi
    _profile_dir=$(CDPATH= cd -- "$(dirname -- "$_profile_path")" 2>/dev/null && pwd)
    PENGYOS_SHELL_DIR="${_profile_dir:-.}"
    unset _profile_dir
fi
unset _profile_path

# --- PATH ------------------------------------------------------------------
# Prepend the common local bin dirs, skipping any entry already on PATH so that
# sourcing this more than once cannot duplicate entries.
add_path() {
    for _d in "$@"; do
        case ":$PATH:" in
            *":$_d:"*) : ;;
            *) PATH="$_d:$PATH" ;;
        esac
    done
    export PATH
}
add_path "$HOME/.local/bin" "$HOME/bin"

# --- aliases ---------------------------------------------------------------
# Friendly aliases for the comfort tools. Aliases are lazy (only resolved when
# invoked), so a missing binary here does not break shell start.
#
# Only names whose behaviour survives the swap are aliased: eza takes ls's
# common flags, and bat acts exactly like cat when its output is not a terminal
# (no colour, no decorations), so `cat f | jq` still gets the plain bytes.
# grep/find/diff are NOT aliased to rg/fd/delta: their flags and semantics
# differ, and a muscle-memory `grep -r` or `find . -name` must do what it says.
# rg, fd and bat are on PATH under their own names.
alias ls='eza --group-directories-first'
alias la='eza -a'
alias ll='eza -al'
alias lt='eza --tree -L 2'
alias cat='bat --paging=never --style=plain'

# --- prompt (starship) -----------------------------------------------------
# Load Starship once. Guarded on a marker so `starship init` is only evaluated a
# single time even if the profile is sourced repeatedly. Only runs when the
# `starship` binary is on PATH; otherwise the prompt is left to the shell's
# default (offline-safe, no network call).
#
# `starship init` is shell-specific (there is no POSIX-sh emitter), so pick the
# target from the shell that is sourcing us. The PengyOS prompt theme ships at
# /etc/pengyos/shell/starship.toml; STARSHIP_CONFIG points at it when it exists
# and nothing else claimed the config, so the curated prompt is what a fresh
# login gets. A user's own ~/.config/starship.toml wins when the system theme
# is absent, and STARSHIP_CONFIG set in the environment always wins.
if [ -z "${PENGYOS_TOOLSET_STARSHIP_LOADED:-}" ]; then
    PENGYOS_TOOLSET_STARSHIP_LOADED=1
    if command -v starship >/dev/null 2>&1; then
        if [ -n "${ZSH_VERSION:-}" ]; then
            _starship_shell=zsh
        elif [ -n "${BASH_VERSION:-}" ]; then
            _starship_shell=bash
        else
            _starship_shell=sh
        fi
        if [ -z "${STARSHIP_CONFIG:-}" ] && [ -r "$PENGYOS_SHELL_DIR/starship.toml" ]; then
            STARSHIP_CONFIG="$PENGYOS_SHELL_DIR/starship.toml"
            export STARSHIP_CONFIG
        fi
        eval "$(starship init "$_starship_shell" 2>/dev/null)" 2>/dev/null || true
        unset _starship_shell
    fi
fi

# --- zsh plugins -----------------------------------------------------------
# The two interactive plugins that give a plain zsh the oh-my-zsh feel,
# installed by the image recipes to /usr/share/zsh/plugins (zsh-only, guarded
# on the files existing — a Core system without them is unaffected).
# Autosuggestions first; syntax highlighting wraps the ZLE widgets last.
case "${ZSH_VERSION:-}" in
    ?*)
        if [ -r /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ]; then
            . /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh
        fi
        if [ -r /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]; then
            . /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
        fi
        ;;
esac

# --- fzf -------------------------------------------------------------------
# fzf keybindings + completion (offline, local only). Sourced via $PENGYOS_SHELL_DIR;
# the snippet itself is guarded (idempotent, interactive-only) and probes a few
# common roots for the packaged key-bindings/completion scripts.
if [ -r "$PENGYOS_SHELL_DIR/fzf.sh" ]; then
    . "$PENGYOS_SHELL_DIR/fzf.sh"
fi

# --- zoxide ----------------------------------------------------------------
# zoxide fast-directory jumping (offline, file-system only).
if [ -r "$PENGYOS_SHELL_DIR/zoxide.sh" ]; then
    . "$PENGYOS_SHELL_DIR/zoxide.sh"
fi

# --- history (bash) --------------------------------------------------------
# Sane history handling under bash. Harmlessly skipped on zsh/other shells.
case "$0" in
    *bash*)
        export HISTCONTROL=ignoredups:erasedups
        export HISTSIZE=10000
        export HISTFILESIZE=10000
        if [ -z "${ZSH_VERSION:-}" ]; then
            shopt -s histappend 2>/dev/null || true
            export PROMPT_COMMAND="history -a${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
        fi
        ;;
esac
