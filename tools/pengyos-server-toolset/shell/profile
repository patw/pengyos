# profile — PengyOS Server remote-admin comfort profile (US-SRV-1)
#
# A curated, idempotent login profile for the comfort CLI/shell pack. It:
#   * puts the local bin dirs on PATH (deduped, so re-sourcing never bloats it),
#   * defines friendly aliases (eza/ripgrep/fd/bat),
#   * loads the Starship prompt,
#   * loads fzf keybindings + completion,
#   * loads zoxide,
#   * makes NO network call at shell start (only `command -v` + local sourcing),
#   * is POSIX-sh so it survives `sh -n` and is safe under `set -eu`.
#
# It works under both bash and zsh. Source it from your rc:
#   bash -> ~/.bash_profile or ~/.bashrc:  . ~/.config/pengyos/shell/profile
#   zsh  -> ~/.zshrc:                       . ~/.config/pengyos/shell/profile
#
# The sibling init snippets (fzf.sh / zoxide.sh) are found via $PENGYOS_SHELL_DIR
# when set, otherwise by auto-detecting this file's own directory (bash:
# $BASH_SOURCE[0], zsh: $0).

# --- idempotency guard -----------------------------------------------------
# A sourced file may be read more than once per shell; guard the body so it
# runs at most once per shell session.
if [ -n "${PENGYOS_TOOLSET_PROFILE_RC:-}" ]; then
    return 0 2>/dev/null || true
fi
PENGYOS_TOOLSET_PROFILE_RC=1
export PENGYOS_TOOLSET_PROFILE_RC

# --- interactive only ------------------------------------------------------
# Aliases and prompt setup only matter for an interactive shell.
case "$-" in
    *i*) : ;;
    *) return 0 2>/dev/null || true ;;
esac

# --- locate the sibling init snippets --------------------------------------
# Prefer an explicit override; otherwise auto-detect this file's directory
# (bash: $BASH_SOURCE[0], zsh/other: $0). Both are read at the top level, so
# $0 is the sourced path, not a function name.
if [ -z "$PENGYOS_SHELL_DIR" ]; then
    if [ -n "${BASH_VERSION:-}" ]; then
        _profile_path="${BASH_SOURCE[0]}"
    else
        _profile_path="$0"
    fi
    _profile_dir=$(CDPATH= cd -- "$(dirname -- "$_profile_path")" 2>/dev/null && pwd)
    PENGYOS_SHELL_DIR="${_profile_dir:-.}"
    unset _profile_dir
fi
unset _profile_path

# --- PATH ------------------------------------------------------------------
# Prepend the common local bin dirs, skipping any entry already on PATH so that
# sourcing this more than once cannot duplicate entries.
add_path() {
    for _d in "$@"; do
        case ":$PATH:" in
            *":$_d:"*) : ;;
            *) PATH="$_d:$PATH" ;;
        esac
    done
    export PATH
}
add_path "$HOME/.local/bin" "$HOME/bin"

# --- aliases ---------------------------------------------------------------
# Friendly aliases for the comfort tools. Aliases are lazy (only resolved when
# invoked), so a missing binary here does not break shell start.
alias ls='eza --group-dirs --color=auto'
alias la='eza -a'
alias ll='eza -ala'
alias lt='eza --tree -L 2'
alias grep='ripgrep --color=always --smart-case'
alias grepv='ripgrep --invert-match --color=always'
alias fg='ripgrep --color=always --fixed-strings'
alias find='fd --hidden --color=always'
alias cat='bat --color=always --paging=never'
alias diff='delta --color=always --diff'

# --- prompt (starship) -----------------------------------------------------
# Load Starship once. Guarded on a marker so `starship init` is only evaluated a
# single time even if the profile is sourced repeatedly. Only runs when the
# `starship` binary is on PATH; otherwise the prompt is left to the shell's
# default (offline-safe, no network call).
if [ -z "${PENGYOS_TOOLSET_STARSHIP_LOADED:-}" ]; then
    PENGYOS_TOOLSET_STARSHIP_LOADED=1
    export PENGYOS_TOOLSET_STARSHIP_LOADED
    if command -v starship >/dev/null 2>&1; then
        eval "$(starship init sh 2>/dev/null)" 2>/dev/null || true
    fi
fi

# --- fzf -------------------------------------------------------------------
# fzf keybindings + completion (offline, local only). Sourced via $PENGYOS_SHELL_DIR;
# the snippet itself is guarded (idempotent, interactive-only) and probes a few
# common roots for the packaged key-bindings/completion scripts.
if [ -r "$PENGYOS_SHELL_DIR/fzf.sh" ]; then
    . "$PENGYOS_SHELL_DIR/fzf.sh"
fi

# --- zoxide ----------------------------------------------------------------
# zoxide fast-directory jumping (offline, file-system only).
if [ -r "$PENGYOS_SHELL_DIR/zoxide.sh" ]; then
    . "$PENGYOS_SHELL_DIR/zoxide.sh"
fi

# --- history (bash) --------------------------------------------------------
# Sane history handling under bash. Harmlessly skipped on zsh/other shells.
case "$0" in
    *bash*)
        export HISTCONTROL=ignoredups:erasedups
        export HISTSIZE=10000
        export HISTFILESIZE=10000
        if [ -z "${ZSH_VERSION:-}" ]; then
            shopt -s histappend 2>/dev/null || true
            export PROMPT_COMMAND="history -a${PROMPT_COMMAND:+;$PROMPT_COMMAND}"
        fi
        ;;
esac
