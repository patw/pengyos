{
  "schema_version": 1,
  "baseline_id": "pengyos-hardening-1",
  "description": "PengyOS hardening baseline — the declarative contract the linter audits against. The code is the reader; edit this data to change the posture.",
  "rules": [
    {
      "id": "ssh-permit-root-login",
      "severity": "critical",
      "domain": "ssh",
      "description": "Root login over SSH must be disabled (key-only access).",
      "matcher": {
        "kind": "key_value",
        "params": {
          "file": "etc/ssh/sshd_config",
          "key": "PermitRootLogin",
          "expected": "no",
          "operator": "eq"
        }
      }
    },
    {
      "id": "ssh-password-auth",
      "severity": "critical",
      "domain": "ssh",
      "description": "Password authentication must be disabled (key-only access).",
      "matcher": {
        "kind": "key_value",
        "params": {
          "file": "etc/ssh/sshd_config",
          "key": "PasswordAuthentication",
          "expected": "no",
          "operator": "eq"
        }
      }
    },
    {
      "id": "ssh-pubkey-auth",
      "severity": "high",
      "domain": "ssh",
      "description": "Public-key authentication must be enabled.",
      "matcher": {
        "kind": "key_value",
        "params": {
          "file": "etc/ssh/sshd_config",
          "key": "PubkeyAuthentication",
          "expected": "yes",
          "operator": "eq"
        }
      }
    },
    {
      "id": "ssh-empty-passwords",
      "severity": "critical",
      "domain": "ssh",
      "description": "Empty passwords must not be permitted.",
      "matcher": {
        "kind": "key_value",
        "params": {
          "file": "etc/ssh/sshd_config",
          "key": "PermitEmptyPasswords",
          "expected": "no",
          "operator": "eq"
        }
      }
    },
    {
      "id": "ssh-x11-forwarding",
      "severity": "medium",
      "domain": "ssh",
      "description": "X11 forwarding must be disabled.",
      "matcher": {
        "kind": "key_value",
        "params": {
          "file": "etc/ssh/sshd_config",
          "key": "X11Forwarding",
          "expected": "no",
          "operator": "eq"
        }
      }
    },
    {
      "id": "ssh-tcp-forwarding",
      "severity": "low",
      "domain": "ssh",
      "description": "TCP forwarding must be disabled.",
      "matcher": {
        "kind": "key_value",
        "params": {
          "file": "etc/ssh/sshd_config",
          "key": "AllowTcpForwarding",
          "expected": "no",
          "operator": "eq"
        }
      }
    },
    {
      "id": "sysctl-kptr-restrict",
      "severity": "high",
      "domain": "sysctl",
      "description": "Kernel pointer exposure must be fully restricted (kptr_restrict=2).",
      "matcher": {
        "kind": "sysctl_value",
        "params": {
          "files": ["etc/sysctl.d/*.conf"],
          "key": "kernel.kptr_restrict",
          "expected": "2",
          "operator": "eq"
        }
      }
    },
    {
      "id": "sysctl-dmesg-restrict",
      "severity": "medium",
      "domain": "sysctl",
      "description": "Unprivileged dmesg access must be restricted.",
      "matcher": {
        "kind": "sysctl_value",
        "params": {
          "files": ["etc/sysctl.d/*.conf"],
          "key": "kernel.dmesg_restrict",
          "expected": "1",
          "operator": "eq"
        }
      }
    },
    {
      "id": "sysctl-protected-links",
      "severity": "low",
      "domain": "sysctl",
      "description": "Filesystem hardlink/symlink protection must be enabled.",
      "matcher": {
        "kind": "sysctl_value",
        "params": {
          "files": ["etc/sysctl.d/*.conf"],
          "key": "fs.protected_hardlinks",
          "expected": "1",
          "operator": "eq"
        }
      }
    },
    {
      "id": "sysctl-tcp-syncookies",
      "severity": "low",
      "domain": "sysctl",
      "description": "TCP SYN cookies must be enabled (SYN-flood resistance).",
      "matcher": {
        "kind": "sysctl_value",
        "params": {
          "files": ["etc/sysctl.d/*.conf"],
          "key": "net.ipv4.tcp_syncookies",
          "expected": "1",
          "operator": "eq"
        }
      }
    },
    {
      "id": "sysctl-disable-ipv6",
      "severity": "medium",
      "domain": "sysctl",
      "description": "IPv6 must be disabled where not required (attack-surface reduction).",
      "matcher": {
        "kind": "sysctl_value",
        "params": {
          "files": ["etc/sysctl.d/*.conf"],
          "key": "net.ipv6.conf.all.disable_ipv6",
          "expected": "1",
          "operator": "eq"
        }
      }
    },
    {
      "id": "fs-root-nodev-nosuid",
      "severity": "medium",
      "domain": "sysctl",
      "description": "The root partition must mount with nodev and nosuid (apt data partition).",
      "matcher": {
        "kind": "mount_option",
        "params": {
          "file": "etc/fstab",
          "mountpoint": "/",
          "option": "nodev,nosuid",
          "operator": "contains"
        }
      }
    },
    {
      "id": "fs-var-nodev-nosuid",
      "severity": "low",
      "domain": "sysctl",
      "description": "The /var partition (apt cache) must mount with nodev and nosuid.",
      "matcher": {
        "kind": "mount_option",
        "params": {
          "file": "etc/fstab",
          "mountpoint": "/var",
          "option": "nodev,nosuid",
          "operator": "contains"
        }
      }
    },
    {
      "id": "firewall-input-policy-deny",
      "severity": "critical",
      "domain": "firewall",
      "description": "The nftables input chain must default-deny.",
      "matcher": {
        "kind": "nft_policy",
        "params": {
          "file": "etc/nftables.conf",
          "chain": "input",
          "expected": "deny"
        }
      }
    },
    {
      "id": "firewall-unit-enabled",
      "severity": "high",
      "domain": "units",
      "description": "The nftables service must be enabled (WantedBy) so the default-deny policy actually loads.",
      "matcher": {
        "kind": "unit_enabled",
        "params": {
          "wants_dir": "etc/systemd/system/multi-user.target.wants",
          "unit": "nftables.service"
        }
      }
    },
    {
      "id": "defconfig-no-telnet",
      "severity": "high",
      "domain": "defconfig",
      "description": "The telnet server package must not be enabled in any defconfig.",
      "matcher": {
        "kind": "symbol_absent",
        "params": {
          "files": ["configs/*_defconfig"],
          "symbol": "BR2_PACKAGE_TELNET"
        }
      }
    },
    {
      "id": "defconfig-no-debug",
      "severity": "medium",
      "domain": "defconfig",
      "description": "Debug tooling (valgrind) must not be enabled in any defconfig.",
      "matcher": {
        "kind": "symbol_absent",
        "params": {
          "files": ["configs/*_defconfig"],
          "symbol": "BR2_PACKAGE_VALGRIND"
        }
      }
    },
    {
      "id": "defconfig-openssh-server",
      "severity": "high",
      "domain": "defconfig",
      "description": "The OpenSSH server package must be enabled in every defconfig.",
      "matcher": {
        "kind": "symbol_present",
        "params": {
          "files": ["configs/*_defconfig"],
          "symbol": "BR2_PACKAGE_OPENSSH_SERVER"
        }
      }
    }
  ]
}
