[Unit]
Description=PengyOS OpenSSH socket
Documentation=man:sshd(8) man:systemd.socket(5)
# Socket activation: the kernel/listener accepts connections here and hands the
# accepted socket to sshd.service via the standard %i substitution.

[Socket]
ListenStream=22
Service=sshd.service
Accept=no
BindIPv6Only=both
KeepAlive=yes

[Install]
WantedBy=multi-user.target
