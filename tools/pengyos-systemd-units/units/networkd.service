[Unit]
Description=systemd-networkd
Documentation=man:systemd-networkd(8) man:systemd.service(5)
# Early userspace: started before any network is configured and pulled in by
# the network-online ordering target.
DefaultDependencies=no
After=local-fs.target swap.target
Before=network-online.target
Wants=network-online.target

[Service]
Type=notify
ExecStart=/usr/lib/systemd/systemd-networkd
ExecStartPost=/usr/lib/systemd/systemd-networkd-install
Restart=on-failure
RestartSec=5s
# Hardening that applies to every PengyOS service.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# networkd must be able to talk to udev and the kernel.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW

[Install]
WantedBy=multi-user.target
