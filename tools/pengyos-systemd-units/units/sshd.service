[Unit]
Description=PengyOS OpenSSH server
Documentation=man:sshd(8) man:systemd.service(5)
After=network-online.target network.target
Wants=network-online.target
# Socket-activated by sshd.socket; no [Install] section on purpose so the unit
# is not started independently of the listening socket.

[Service]
ExecStartPre=/usr/sbin/sshd -t
ExecStart=/usr/sbin/sshd -D -o ListenAddress=0.0.0.0:22
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=4s
# Hardening that applies to every PengyOS service.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
SystemCallFilter=@system-service
