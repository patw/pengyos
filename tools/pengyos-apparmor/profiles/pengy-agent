# pengy-agent — minimal, strict-by-default profile for the Pengy agent (SPEC §1).
#
# The Pengy agent is a headless local-model driver: it reads its config,
# reads/writes only inside its own workspace, and talks to the local model
# server over loopback TCP. Everything not granted below is DENIED —
# AppArmor is default-deny, and this profile adds explicit denies on
# sensitive sources as a guardrail against accidental widening.
#
# Confinement invariants (enforced by tests/test_profiles.py):
#   * no `complain` / audit-unconfined posture (strict = enforced deny),
#   * no whole-filesystem allow grants, and no wildcard-tree (`/**`)
#     write grants at all: tree grants carry read/exec/map only, and
#     writes are pinned to explicit paths (the profile passes
#     `validate --strict`),
#   * no `network` rules except the single, loopback-scoped grant below.

pengy-agent (pengy-agent.bin) {
  # --- guardrails: explicit denies on sensitive sources ----------------
  # Already denied by default; these pin the intent so a future edit that
  # accidentally allows a parent path is still caught by an explicit deny.
  deny /etc/shadow r,
  deny /etc/gshadow r,
  deny /etc/sudoers r,
  deny /etc/sudoers.d/** r,
  deny /root/** r,
  deny /home/**/.ssh r,
  deny /home/**/.ssh/** r,

  # --- interpreter (read/exec only) ------------------------------------
  /usr/bin/python3.[0-9]* rix,
  /usr/lib/python3.[0-9]*/** r,
  /usr/lib/python3.[0-9]*/**/*.so.* mr,

  # --- dynamic loader & shared libraries (map/read only, no exec) ------
  /lib/ld-linux-x86-64.so.2 mr,
  /lib/x86_64-linux-gnu/libc.so.6 mr,
  /lib/x86_64-linux-gnu/libm.so.6 mr,
  /etc/ld.so.cache r,

  # --- kernel interface -------------------------------------------------
  /proc/self r,
  /proc/self/fd/ r,
  /dev/null rw,
  /dev/urandom r,
  /dev/tty rw,

  # --- agent install (read-only) ----------------------------------------
  /opt/pengy/agent r,
  /opt/pengy/agent/bin/** rx,
  /opt/pengy/agent/share/** r,
  /opt/pengy/agent/config.yaml r,

  # --- the only writable places (explicit paths only, no /** tree writes)
  # The workspace root and its flat .git metadata (the agent's
  # working trees), the flat /tmp scratch area, and the agent log.
  # Subdirectory content of the workspace is NOT writable from this
  # profile yet — a follow-up (TODO.md) pins the concrete
  # file set once the agent's real working layout exists. Scratch files
  # are temporary artifacts: they need no keepcaps, so no 'k' flag.
  /opt/pengy/workspaces/pengy-agent rw,
  /opt/pengy/workspaces/pengy-agent/.git rw,
  /opt/pengy/workspaces/pengy-agent/.git/* rw,
  /tmp/pengy-agent r,
  /tmp/pengy-agent/* rw,
  /var/log/pengy/agent.log wa,

  # --- network: the ONLY socket access — loopback TCP to the model server
  # AppArmor's fine-grained inet mediation (apparmor.d(5), AppArmor >= 3.0)
  # can scope by peer IP and port. The model server is local and binds the
  # loopback interface, so the peer IP is pinned to 127.0.0.1. The port is
  # deliberately unbound: the model server's port is a deployment choice
  # (see the follow-up in TODO.md), and every non-loopback IP
  # (including ::1, which the model server does not bind) stays denied.
  # A rule with a peer= condition cannot carry bind/listen permissions
  # (apparmor.d(5)), so the agent stays a pure client: no listening, no
  # UDP, no other family.
  network inet tcp peer=(ip=127.0.0.1),
}
