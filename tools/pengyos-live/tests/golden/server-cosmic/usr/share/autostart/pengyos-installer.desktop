# This file is managed by pengyos-live. Do not edit by hand.
#
# Autostart the PengyOS installer when the COSMIC live session starts.
# The live path never writes the target disk before the user confirms
# inside pengyos-install.
[Desktop Entry]
Type=Application
Name=PengyOS Installer
Comment=Install PengyOS to disk
Exec=/usr/bin/pengyos-install
Icon=drive-install
Terminal=false
Categories=System;
X-GNOME-Autostart-enabled=true
