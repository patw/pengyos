# This file is managed by pengyos-live. Do not edit by hand.
#
# Run the PengyOS installer on the live console session. The live path
# never writes the target disk before the user confirms inside
# pengyos-install.
[Unit]
Description=PengyOS live installer
Documentation=file:///etc/pengyos/live
After=multi-user.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/pengyos-install
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
